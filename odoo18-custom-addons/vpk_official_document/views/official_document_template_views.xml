<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_official_document_template_form" model="ir.ui.view">
        <field name="name">vpk.official.document.template.form</field>
        <field name="model">vpk.official.document.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="document_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="filename" invisible="1"/>
                            <field name="datas" filename="filename"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_official_document_template_list" model="ir.ui.view">
        <field name="name">vpk.official.document.template.list</field>
        <field name="model">vpk.official.document.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="document_type"/>
                <field name="filename"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_official_document_template" model="ir.actions.act_window">
        <field name="name">แบบฟอร์มหนังสือราชการ</field>
        <field name="res_model">vpk.official.document.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
