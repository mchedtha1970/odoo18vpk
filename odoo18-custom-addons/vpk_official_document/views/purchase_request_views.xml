<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_official_document" model="ir.ui.view">
        <field name="name">purchase.request.form.official.document</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_official_documents" type="object"
                        class="oe_stat_button" icon="fa-file-word-o"
                        groups="purchase.group_purchase_user">
                    <field name="official_document_count" widget="statinfo"
                           string="หนังสือราชการ"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_vpk_test_reset"
                    type="object"
                    string="Reset (ทดสอบ)"
                    class="btn-secondary"
                    groups="purchase_request.group_purchase_request_manager,base.group_system"
                    confirm="รีเซ็ตใบขอซื้อนี้กลับเป็นฉบับร่าง และลบเอกสารที่เกี่ยวข้อง (หนังสือราชการ, e-GP, ใบสั่งซื้อ, ใบตรวจรับ) เพื่อเริ่มต้นใหม่?"
                />
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="vpk_documents_signed_complete" invisible="1"/>
                <div class="alert alert-success mb-0" role="alert"
                     invisible="not vpk_documents_signed_complete">
                    <i class="fa fa-check-circle me-1"/>
                    <strong>ลงนามครบแล้ว</strong>
                </div>
            </xpath>
            <xpath expr="//sheet/notebook" position="before">
                <field name="has_approval_attachments" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='committee']" position="attributes">
                <attribute name="string">รายชื่อคณะกรรมการ</attribute>
            </xpath>
            <xpath expr="//page[@name='committee']" position="after">
                <page string="เอกสารราชการที่เกี่ยวข้อง" name="related_official_documents">
                    <div class="text-muted mb-2">
                        รายการเอกสารที่เพิ่มและแนบไฟล์ไว้ใน <b>เอกสารกระบวนการ e-GP</b> (สำหรับเปิดดูเท่านั้น)
                    </div>
                    <field name="egp_document_ids"
                           readonly="1" create="false" delete="false">
                        <list create="false" delete="false" edit="false">
                            <field name="sequence" column_invisible="1"/>
                            <field name="document_type_id" string="ประเภท"/>
                            <field name="egp_reference" string="เลขอ้างอิง e-GP"/>
                            <field name="document_date" string="วันที่เอกสาร"/>
                            <field name="document_filename" column_invisible="1"/>
                            <field name="document_file" filename="document_filename" widget="binary" string="ไฟล์"/>
                            <button name="action_preview_document" type="object" string="ดูเอกสาร" icon="fa-eye"/>
                            <field name="signer_summary" string="ลงนาม/อนุมัติ" width="180px" optional="show"/>
                            <field name="signature_state" widget="badge" optional="show"
                                   decoration-muted="signature_state == 'not_sent'"
                                   decoration-warning="signature_state == 'waiting'"
                                   decoration-success="signature_state == 'signed'"/>
                            <field name="notes" string="หมายเหตุ" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
