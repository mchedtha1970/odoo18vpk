<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_official_document" model="ir.ui.view">
        <field name="name">purchase.request.form.official.document</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="l10n_th_gov_purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_official_documents" type="object"
                        class="oe_stat_button" icon="fa-file-word-o"
                        groups="purchase.group_purchase_user">
                    <field name="official_document_count" widget="statinfo"
                           string="หนังสือราชการ"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="vpk_documents_signed_complete" invisible="1"/>
                <div class="alert alert-success mb-0" role="alert"
                     invisible="not vpk_documents_signed_complete">
                    <i class="fa fa-check-circle me-1"/>
                    <strong>ลงนามครบแล้ว</strong>
                </div>
            </xpath>
            <xpath expr="//sheet/notebook" position="before">
                <field name="has_approval_attachments" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='committee']" position="attributes">
                <attribute name="string">รายชื่อคณะกรรมการ</attribute>
            </xpath>
            <xpath expr="//page[@name='committee']" position="after">
                <page string="เอกสารอนุมัติขอซื้อ" name="purchase_approval_memo">
                    <field name="issued_purchase_approval_memo_id" invisible="1"/>
                    <div class="text-muted mb-2">
                        บันทึกข้อความอนุมัติขอซื้อใช้เลขสารบรรณจากปุ่ม <b>ขอเลขสารบรรณ</b> ที่ใบขอซื้อ
                        ส่งลงนามตามลำดับในตารางผู้ลงนาม
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button name="action_create_purchase_approval_memo" type="object"
                                string="ออกบันทึกข้อความอนุมัติขอซื้อ"
                                class="btn-primary me-2"
                                groups="purchase.group_purchase_user"
                                invisible="state == 'rejected' or issued_purchase_approval_memo_id"/>
                        <button name="action_create_purchase_approval_memo" type="object"
                                string="เปิดบันทึกข้อความอนุมัติขอซื้อ"
                                class="btn-primary me-2"
                                groups="purchase.group_purchase_user"
                                invisible="state == 'rejected' or not issued_purchase_approval_memo_id"/>
                    </div>
                    <field name="purchase_approval_memo_ids"
                           context="{'default_document_type': 'purchase_approval_memo', 'default_request_id': id}"
                           readonly="1" create="false" delete="false">
                        <list>
                            <field name="has_pdf" widget="vpk_pdf_icon" string="ไฟล์"/>
                            <field name="pdf_filename" column_invisible="1"/>
                            <field name="pdf_attachment_id" column_invisible="1"/>
                            <field name="can_review" column_invisible="1"/>
                            <field name="name" string="เลขที่เอกสาร"/>
                            <field name="saraban_book_no" string="เลขที่จากสารบรรณ"/>
                            <field name="date"/>
                            <field name="subject"/>
                            <field name="signature_state" widget="badge"
                                   decoration-muted="signature_state == 'not_sent'"
                                   decoration-warning="signature_state == 'waiting'"
                                   decoration-success="signature_state == 'signed'"/>
                            <button name="action_open_send_wizard" type="object"
                                    string="ส่งเพื่อลงนาม"
                                    icon="fa-paper-plane"
                                    groups="purchase.group_purchase_user"
                                    invisible="signature_state != 'not_sent' or state == 'cancelled'"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-success="state in ('generated', 'approved')"
                                   decoration-warning="state == 'to_approve'"
                                   decoration-muted="state == 'cancelled'"/>
                        </list>
                    </field>
                </page>
                <page string="เอกสารราชการที่เกี่ยวข้อง" name="related_official_documents">
                    <div class="text-muted mb-2">
                        เลือกเอกสารที่จะสร้าง แล้วกดสร้างเอกสาร
                        ถ้าเอกสารชนิดนั้นออกไว้แล้ว ระบบจะเปิดเอกสารเดิม
                    </div>
                    <group>
                        <group>
                            <field name="official_document_to_create" widget="selection"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <button name="action_create_selected_official_document" type="object"
                                    string="สร้างเอกสาร"
                                    class="btn-primary"
                                    groups="purchase.group_purchase_user"
                                    invisible="state == 'rejected' or not official_document_to_create"/>
                        </group>
                    </group>
                    <field name="official_document_ids"
                           context="{'default_request_id': id}"
                           readonly="1" create="false" delete="false">
                        <list>
                            <field name="document_type"/>
                            <field name="has_pdf" widget="vpk_pdf_icon" string="ไฟล์"/>
                            <field name="pdf_filename" column_invisible="1"/>
                            <field name="pdf_attachment_id" column_invisible="1"/>
                            <field name="can_review" column_invisible="1"/>
                            <field name="name" string="เลขที่เอกสาร"/>
                            <field name="saraban_book_no" string="เลขที่จากสารบรรณ"/>
                            <field name="date"/>
                            <field name="subject"/>
                            <field name="signature_state" widget="badge"
                                   decoration-muted="signature_state == 'not_sent'"
                                   decoration-warning="signature_state == 'waiting'"
                                   decoration-success="signature_state == 'signed'"/>
                            <button name="action_open_send_wizard" type="object"
                                    string="ส่งเพื่อลงนาม"
                                    icon="fa-paper-plane"
                                    groups="purchase.group_purchase_user"
                                    invisible="signature_state != 'not_sent' or state == 'cancelled'"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-success="state in ('generated', 'approved')"
                                   decoration-warning="state == 'to_approve'"
                                   decoration-muted="state == 'cancelled'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
