<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_studio_template_form_onlyoffice" model="ir.ui.view">
        <field name="name">vpk.document.studio.template.form.onlyoffice</field>
        <field name="model">vpk.document.studio.template</field>
        <field name="inherit_id" ref="vpk_document_studio.view_document_studio_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_create_document']" position="after">
                <button name="action_edit_with_onlyoffice" type="object"
                        string="เปิด OnlyOffice เต็มจอ"
                        class="btn-secondary"
                        icon="fa-expand"
                        invisible="not datas"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="แก้ไข Word" name="onlyoffice" invisible="not datas">
                    <field name="onlyoffice_host" nolabel="1" widget="vpk_onlyoffice_editor"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
