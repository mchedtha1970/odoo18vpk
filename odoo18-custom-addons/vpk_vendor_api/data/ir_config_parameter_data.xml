<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_config_vpk_vendor_api_enabled" model="ir.config_parameter">
        <field name="key">vpk_vendor_api.enabled</field>
        <field name="value">True</field>
    </record>
    <!-- Set a real key in Settings after install. Placeholder blocks accidental open API. -->
    <record id="ir_config_vpk_vendor_api_key" model="ir.config_parameter">
        <field name="key">vpk_vendor_api.api_key</field>
        <field name="value">CHANGE-ME-VENDOR-API-KEY</field>
    </record>
    <record id="ir_config_vpk_vendor_api_max_upload_mb" model="ir.config_parameter">
        <field name="key">vpk_vendor_api.max_upload_mb</field>
        <field name="value">10</field>
    </record>
</odoo>
