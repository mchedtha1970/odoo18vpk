<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_api_log_list" model="ir.ui.view">
        <field name="name">vpk.vendor.api.log.list</field>
        <field name="model">vpk.vendor.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="state"/>
                <field name="action"/>
                <field name="external_id"/>
                <field name="partner_id"/>
                <field name="http_status"/>
                <field name="remote_addr"/>
                <field name="endpoint"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_api_log_form" model="ir.ui.view">
        <field name="name">vpk.vendor.api.log.form</field>
        <field name="model">vpk.vendor.api.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="endpoint"/>
                            <field name="http_method"/>
                            <field name="http_status"/>
                            <field name="remote_addr"/>
                        </group>
                        <group>
                            <field name="action"/>
                            <field name="external_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request_body" nolabel="1" widget="text"/>
                        </page>
                        <page string="Response">
                            <field name="response_body" nolabel="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_api_log" model="ir.actions.act_window">
        <field name="name">Vendor API Logs</field>
        <field name="res_model">vpk.vendor.api.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_vendor_api_root"
        name="Vendor API"
        parent="purchase.menu_purchase_config"
        sequence="90"
        groups="vpk_vendor_api.group_vendor_api_manager"
    />
    <menuitem
        id="menu_vendor_api_log"
        name="API Logs"
        parent="menu_vendor_api_root"
        action="action_vendor_api_log"
        sequence="10"
    />
</odoo>
