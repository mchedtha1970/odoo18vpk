<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_vendor_api" model="ir.ui.view">
        <field name="name">res.partner.form.vendor.api</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="vpk_vendor_external_id" invisible="supplier_rank &lt; 1"/>
            </xpath>
        </field>
    </record>
</odoo>
