<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root app: ระบบจัดการสินทรัพย์ -->
    <record id="account_asset_management.menu_finance_assets" model="ir.ui.menu">
        <field name="name">ระบบจัดการสินทรัพย์</field>
        <field name="parent_id" eval="False"/>
        <field name="sequence">56</field>
        <field name="web_icon">account,static/description/icon.png</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('account.group_account_readonly'),
            ref('account.group_account_invoice'),
        ])]"/>
    </record>

    <!-- ย้ายการตั้งค่าสินทรัพย์มาไว้ภายใต้ root ใหม่ -->
    <record id="account_asset_management.menu_finance_config_assets" model="ir.ui.menu">
        <field name="name">การตั้งค่า</field>
        <field name="parent_id" ref="account_asset_management.menu_finance_assets"/>
        <field name="sequence">90</field>
    </record>

    <!-- ย้ายรายงานสินทรัพย์มาไว้ภายใต้ root ใหม่ -->
    <record id="account_asset_management.account_asset_report_menu" model="ir.ui.menu">
        <field name="name">รายงาน</field>
        <field name="parent_id" ref="account_asset_management.menu_finance_assets"/>
        <field name="sequence">80</field>
    </record>
</odoo>
