<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hr_payroll" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hr.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="HR Payroll Interface" name="vpk_hr_payroll_api_setting">
                    <setting string="เปิดรับชุดเงินเดือนจาก HR" help="ระบบ HR ส่ง POST เข้าคิว แล้วนักบัญชีกดผ่านเพื่อสร้างสมุดรายวัน">
                        <field name="vpk_hr_payroll_api_enabled"/>
                    </setting>
                    <setting string="API Key" help="ส่งใน Header X-Api-Key หรือ Authorization: Bearer" invisible="not vpk_hr_payroll_api_enabled">
                        <field name="vpk_hr_payroll_api_key" password="True"/>
                        <div class="text-muted">POST /vpk/api/v1/hr/payroll</div>
                    </setting>
                    <setting string="สมุดรายวันเงินเดือน" help="ใช้เมื่อชุดข้อมูลไม่ได้ระบุสมุดรายวันเอง">
                        <field name="vpk_hr_payroll_journal_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
