<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_log_list" model="ir.ui.view">
        <field name="name">vpk.hr.payroll.api.log.list</field>
        <field name="model">vpk.hr.payroll.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="endpoint"/>
                <field name="external_id"/>
                <field name="state"/>
                <field name="http_status"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="view_hr_payroll_log_form" model="ir.ui.view">
        <field name="name">vpk.hr.payroll.api.log.form</field>
        <field name="model">vpk.hr.payroll.api.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="endpoint"/>
                        <field name="http_method"/>
                        <field name="state"/>
                        <field name="http_status"/>
                        <field name="external_id"/>
                        <field name="batch_id"/>
                        <field name="error_message"/>
                    </group>
                    <group>
                        <field name="request_body"/>
                        <field name="response_body"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_log" model="ir.actions.act_window">
        <field name="name">บันทึก API เงินเดือน</field>
        <field name="res_model">vpk.hr.payroll.api.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
