<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vpk_hr_payroll" model="ir.module.category">
        <field name="name">HR Payroll Interface</field>
        <field name="sequence">56</field>
    </record>

    <record id="group_hr_payroll_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_vpk_hr_payroll"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hr_payroll_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="category_id" ref="module_category_vpk_hr_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_payroll_user')), (4, ref('account.group_account_user'))]"/>
        <field name="comment">ตรวจชุดเงินเดือนจาก HR แล้วกดผ่านเพื่อสร้างสมุดรายวัน</field>
    </record>

    <record id="group_hr_payroll_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_vpk_hr_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_payroll_accountant'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">ตั้งค่ารหัสเงินเดือนและ API key</field>
    </record>

    <record id="rule_hr_payroll_batch_company" model="ir.rule">
        <field name="name">HR payroll batch multi-company</field>
        <field name="model_id" ref="model_vpk_hr_payroll_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_payroll_line_company" model="ir.rule">
        <field name="name">HR payroll line multi-company</field>
        <field name="model_id" ref="model_vpk_hr_payroll_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_payroll_map_company" model="ir.rule">
        <field name="name">HR payroll map multi-company</field>
        <field name="model_id" ref="model_vpk_hr_payroll_component_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
