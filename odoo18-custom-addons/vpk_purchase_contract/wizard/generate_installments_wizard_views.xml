<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generate_installments_wizard_form" model="ir.ui.view">
        <field name="name">purchase.contract.generate.installments.form</field>
        <field name="model">purchase.contract.generate.installments</field>
        <field name="arch" type="xml">
            <form string="สร้างรายการงวดงาน">
                <group>
                    <field name="contract_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount_total"/>
                    <field name="installment_count"/>
                    <field name="split_mode" widget="radio"/>
                    <field name="clear_existing"/>
                </group>
                <footer>
                    <button
                        name="action_generate"
                        type="object"
                        string="สร้างงวด"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_installments_wizard" model="ir.actions.act_window">
        <field name="name">สร้างรายการงวดงาน</field>
        <field name="res_model">purchase.contract.generate.installments</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
