<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_contract_company_rule" model="ir.rule">
        <field name="name">Purchase Contract multi-company</field>
        <field name="model_id" ref="model_purchase_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="purchase_contract_pr_user_own_rule" model="ir.rule">
        <field name="name">สัญญา: หน่วยงานดูได้เฉพาะของใบขอซื้อตนเอง</field>
        <field name="model_id" ref="model_purchase_contract"/>
        <field name="groups" eval="[(4, ref('purchase_request.group_purchase_request_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            ['|', '|',
             ('purchase_request_ids.requested_by', '=', user.id),
             ('requisition_id.purchase_request_id.requested_by', '=', user.id),
             ('requisition_id.line_ids.purchase_request_lines.request_id.requested_by', '=', user.id)]
        </field>
    </record>
    <record id="purchase_contract_pr_manager_all_rule" model="ir.rule">
        <field name="name">สัญญา: หัวหน้าพัสดุดูได้ทั้งหมด</field>
        <field name="model_id" ref="model_purchase_contract"/>
        <field name="groups" eval="[(4, ref('purchase_request.group_purchase_request_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="purchase_contract_purchase_user_all_rule" model="ir.rule">
        <field name="name">สัญญา: เจ้าหน้าที่จัดซื้อดูได้ทั้งหมด</field>
        <field name="model_id" ref="model_purchase_contract"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <!-- ปุ่มสร้าง PO อยู่ที่กลุ่มจัดซื้อ ต้องเขียนใบขอซื้อ/บรรทัดเพื่อผูก PO แม้ไม่ใช่ผู้เปิดใบ -->
    <record id="purchase_request_purchase_user_po_rule" model="ir.rule">
        <field name="name">ใบขอซื้อ: เจ้าหน้าที่จัดซื้อเขียนได้เมื่ออนุมัติแล้วเพื่อสร้าง PO</field>
        <field name="model_id" ref="purchase_request.model_purchase_request"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('state', 'in', ('approved', 'in_progress', 'done'))]</field>
    </record>
    <record id="purchase_request_line_purchase_user_po_rule" model="ir.rule">
        <field name="name">รายการใบขอซื้อ: เจ้าหน้าที่จัดซื้อเขียนได้เมื่ออนุมัติแล้วเพื่อสร้าง PO</field>
        <field name="model_id" ref="purchase_request.model_purchase_request_line"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('request_id.state', 'in', ('approved', 'in_progress', 'done'))]</field>
    </record>
</odoo>
