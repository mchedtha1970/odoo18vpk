<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_contract" model="ir.ui.view">
        <field name="name">purchase.order.form.contract</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field
                    name="contract_id"
                    options="{'no_create': True}"
                    readonly="state in ('purchase', 'done', 'cancel')"
                />
                <field name="contract_amount_remaining" readonly="1" invisible="not contract_id"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_order_tree_contract" model="ir.ui.view">
        <field name="name">purchase.order.list.contract</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="contract_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
