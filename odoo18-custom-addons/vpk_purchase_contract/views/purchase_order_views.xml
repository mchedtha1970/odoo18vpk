<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_contract" model="ir.ui.view">
        <field name="name">purchase.order.form.contract</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_vpk_purchase_contract" separator=" "/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_source_purchase_requests"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="source_request_count == 0"
                >
                    <field name="source_request_count" widget="statinfo" string="ใบขอซื้อ"/>
                </button>
                <button
                    name="action_view_source_requisition"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-university"
                    invisible="source_requisition_count == 0"
                >
                    <field name="source_requisition_count" widget="statinfo" string="e-GP"/>
                </button>
                <button
                    name="action_view_source_contract"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-handshake-o"
                    invisible="source_contract_count == 0"
                >
                    <field name="source_contract_count" widget="statinfo" string="สัญญา"/>
                </button>
            </xpath>
            <field name="partner_id" position="after">
                <field
                    name="contract_id"
                    readonly="state in ('purchase', 'done', 'cancel')"
                    options="{'no_create': True}"
                />
                <field name="source_request_ids" widget="many2many_tags" invisible="1"/>
                <field name="source_requisition_id" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_order_tree_contract" model="ir.ui.view">
        <field name="name">purchase.order.list.contract</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="contract_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
