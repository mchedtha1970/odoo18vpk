<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_contract" model="ir.ui.view">
        <field name="name">purchase.order.form.contract</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_vpk_purchase_contract" separator=" "/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_contract" model="ir.ui.view">
        <field name="name">purchase.order.list.contract</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="contract_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
