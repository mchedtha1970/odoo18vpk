<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deferred_entries_tree" model="ir.ui.view">
        <field name="name">account.move.deferred.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Deferred Entries">
                <field name="date"/>
                <field name="name"/>
                <field name="ref"/>
                <field name="journal_id"/>
                <field name="partner_id" optional="show"/>
                <field name="amount_total_signed"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_move_form_deferred" model="ir.ui.view">
        <field name="name">account.move.form.deferred</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="inside">
                <field name="deferred_original_move_ids" widget="many2many_tags" readonly="1"/>
                <field name="deferred_move_ids" widget="many2many_tags" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="deferred_start_date" optional="hide"/>
                <field name="deferred_end_date" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
