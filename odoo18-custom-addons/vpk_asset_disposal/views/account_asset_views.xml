<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_asset_view_form_disposal" model="ir.ui.view">
        <field name="name">account.asset.form.disposal</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_management.account_asset_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_disposals"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-trash"
                    invisible="disposal_count == 0"
                >
                    <field name="disposal_count" widget="statinfo" string="ใบจำหน่าย"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
