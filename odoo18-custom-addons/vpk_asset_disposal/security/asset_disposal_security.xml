<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vpk_asset_disposal" model="ir.module.category">
        <field name="name">ใบขออนุมัติจำหน่ายทรัพย์สิน</field>
        <field name="sequence">59</field>
    </record>

    <record id="group_asset_disposal_user" model="res.groups">
        <field name="name">ผู้ใช้งาน</field>
        <field name="category_id" ref="module_category_vpk_asset_disposal"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="comment">สร้างใบขออนุมัติจำหน่ายและส่งขออนุมัติ</field>
    </record>

    <record id="group_asset_disposal_approver" model="res.groups">
        <field name="name">ผู้อนุมัติ</field>
        <field name="category_id" ref="module_category_vpk_asset_disposal"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_disposal_user'))]"/>
        <field name="comment">กลุ่มผู้อนุมัติในลำดับการอนุมัติ</field>
    </record>

    <record id="group_asset_disposal_manager" model="res.groups">
        <field name="name">ผู้จัดการ</field>
        <field name="category_id" ref="module_category_vpk_asset_disposal"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_disposal_approver')), (4, ref('account.group_account_manager'))]"/>
        <field name="comment">จัดการใบขออนุมัติจำหน่ายทั้งหมด</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
