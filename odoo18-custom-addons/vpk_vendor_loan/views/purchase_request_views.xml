<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_vendor_loan" model="ir.ui.view">
        <field name="name">purchase.request.form.vendor.loan</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vpk_vendor_loan" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        invisible="vpk_vendor_loan_count == 0">
                    <field name="vpk_vendor_loan_count" widget="statinfo" string="ใบยืม"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="vpk_vendor_loan_count" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
