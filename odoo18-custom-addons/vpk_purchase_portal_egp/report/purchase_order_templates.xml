<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_vendor_signature" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//p[@t-field='o.notes']" position="after">
            <div t-if="o.signature" class="mt-4 ml64 mr4" name="vendor_signature">
                <p>ลงนามยืนยันโดยผู้จำหน่าย:</p>
                <img t-att-src="image_data_uri(o.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                <p>
                    <span t-field="o.signed_by"/>
                    <t t-if="o.signed_on"> — <span t-field="o.signed_on"/></t>
                </p>
            </div>
        </xpath>
    </template>
</odoo>
