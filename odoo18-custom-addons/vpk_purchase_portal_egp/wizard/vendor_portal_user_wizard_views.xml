<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_portal_user_wizard_form" model="ir.ui.view">
        <field name="name">vendor.portal.user.wizard.form</field>
        <field name="model">vendor.portal.user.wizard</field>
        <field name="arch" type="xml">
            <form string="สร้าง User Portal ผู้จำหน่าย">
                <group invisible="state != 'draft'">
                    <group string="ผู้จำหน่าย">
                        <field name="partner_id"/>
                        <field name="name"/>
                        <field name="user_id" invisible="not user_id"/>
                        <field name="is_portal" invisible="1"/>
                        <div colspan="2" class="text-warning" invisible="not is_portal">
                            มี Portal User อยู่แล้ว — การบันทึกจะอัปเดตอีเมล / User ID / รหัสผ่าน
                        </div>
                    </group>
                    <group string="บัญชีเข้าสู่ระบบ">
                        <field name="email" placeholder="vendor@example.com"/>
                        <field name="login" placeholder="userid"/>
                        <field name="password" password="True" placeholder="กำหนดรหัสผ่าน" required="state == 'draft'"/>
                        <field name="password_confirm" password="True" placeholder="ยืนยันรหัสผ่าน" required="state == 'draft'"/>
                    </group>
                </group>
                <group invisible="state != 'done'">
                    <div colspan="2" class="alert alert-success" role="alert">
                        สร้าง/อัปเดต User Portal เรียบร้อยแล้ว
                        แจ้งข้อมูลนี้ให้ผู้จำหน่ายเพื่อเข้าสู่ระบบ
                    </div>
                    <group>
                        <field name="result_login" string="User ID"/>
                        <field name="portal_url" widget="CopyClipboardChar" string="ลิงก์ Login"/>
                        <field name="portal_url" widget="CopyClipboardButton" string="คัดลอกลิงก์" nolabel="1"/>
                    </group>
                </group>
                <field name="note" nolabel="1" invisible="state != 'draft'"/>
                <field name="state" invisible="1"/>
                <footer>
                    <button
                        name="action_create_portal_user"
                        type="object"
                        string="สร้าง / อัปเดต User Portal"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button string="ปิด" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vendor_portal_user_wizard" model="ir.actions.act_window">
        <field name="name">สร้าง User Portal</field>
        <field name="res_model">vendor.portal.user.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
