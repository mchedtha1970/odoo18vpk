<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saraban_document_form_studio" model="ir.ui.view">
        <field name="name">saraban.document.form.studio</field>
        <field name="model">saraban.document</field>
        <field name="inherit_id" ref="vpk_pr_saraban.view_saraban_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_ref']" position="after">
                <field name="studio_document_id" readonly="1"
                       invisible="not studio_document_id"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_open_studio_document" type="object"
                        string="เปิดเอกสาร Document Studio"
                        class="btn-secondary"
                        icon="fa-file-text-o"
                        invisible="not studio_document_id"/>
            </xpath>
        </field>
    </record>
</odoo>
