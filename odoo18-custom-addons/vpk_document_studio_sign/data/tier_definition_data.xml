<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Container definition: reviewers come from the approver table on each document. -->
    <record id="tier_definition_studio_document" model="tier.definition">
        <field name="name">ลงนามเอกสาร Document Studio ตามตารางผู้อนุมัติ</field>
        <field name="model_id" ref="vpk_document_studio.model_vpk_document_studio_document"/>
        <field name="review_type">individual</field>
        <field name="reviewer_id" ref="base.user_admin"/>
        <field name="definition_type">domain</field>
        <field name="definition_domain">[('state', '=', 'to_approve')]</field>
        <field name="sequence">10</field>
        <field name="approve_sequence" eval="True"/>
        <field name="notify_on_pending" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
