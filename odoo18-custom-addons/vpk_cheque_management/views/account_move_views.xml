<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_cheque" model="ir.ui.view">
        <field name="name">account.move.form.cheque</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(vpk_cheque_management.action_bank_cheque_print_wizard)d" type="action" class="oe_stat_button" icon="fa-money" string="พิมพ์เช็ค" invisible="move_type == 'entry'" groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_cheque" model="ir.ui.view">
        <field name="name">account.payment.form.cheque</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(vpk_cheque_management.action_bank_cheque_print_wizard)d" type="action" class="oe_stat_button" icon="fa-money" string="พิมพ์เช็ค" groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
