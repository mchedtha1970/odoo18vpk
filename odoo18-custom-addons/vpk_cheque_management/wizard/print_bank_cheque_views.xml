<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_cheque_print_wizard_form" model="ir.ui.view">
        <field name="name">vpk.bank.cheque.print.wizard.form</field>
        <field name="model">vpk.bank.cheque.print.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="cheque_book_id" options="{'no_create': True}"/>
                        <field name="cheque_leaf_id" options="{'no_create': True}"/>
                        <field name="partner_id"/>
                        <field name="is_ac_pay"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="currency_id"/>
                        <field name="move_id" readonly="1" invisible="not move_id"/>
                        <field name="payment_id" readonly="1" invisible="not payment_id"/>
                    </group>
                </group>
                <field name="has_pay_line2" invisible="1"/>
                <field name="has_amount_line2" invisible="1"/>
                <group>
                    <field name="pay_name_line1"/>
                    <field name="pay_name_line2" invisible="not has_pay_line2"/>
                    <field name="amount"/>
                    <field name="amount_in_words"/>
                    <field name="amount_in_words_line2" invisible="not has_amount_line2"/>
                </group>
                <footer>
                    <button name="action_print_preview" type="object" string="ดูตัวอย่าง" class="btn-secondary"/>
                    <button name="action_print" type="object" string="พิมพ์เช็ค" class="btn-primary"/>
                    <button string="ยกเลิก" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bank_cheque_print_wizard" model="ir.actions.act_window">
        <field name="name">พิมพ์เช็ค</field>
        <field name="res_model">vpk.bank.cheque.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_bank_cheque_print_wizard_form"/>
    </record>
</odoo>
