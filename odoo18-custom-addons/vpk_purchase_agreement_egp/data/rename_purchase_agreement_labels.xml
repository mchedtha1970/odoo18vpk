<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Gear menu on Purchase Request: Create Purchase Agreements → กระบวนการ eGP -->
    <record
        id="purchase_request_to_requisition.action_purchase_request_make_purchase_requisition"
        model="ir.actions.act_window"
    >
        <field name="name">ส่งกระบวนการ eGP</field>
    </record>
    <record
        id="purchase_request_to_requisition.action_purchase_request_line_make_purchase_requisition"
        model="ir.actions.act_window"
    >
        <field name="name">ส่งกระบวนการ eGP</field>
    </record>

    <!-- กลุ่มกระบวนการ eGP ใต้ระบบจัดซื้อจัดจ้าง -->
    <menuitem
        id="menu_egp_process_root"
        name="กระบวนการ eGP"
        parent="purchase.menu_purchase_root"
        sequence="20"
        groups="purchase.group_purchase_user,purchase_request.group_purchase_request_user"
    />
    <record id="purchase_requisition.action_purchase_requisition" model="ir.actions.act_window">
        <field name="name">รายการโครงการ</field>
    </record>
    <record id="purchase_requisition.menu_purchase_requisition_pro_mgt" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <menuitem
        id="menu_egp_project_root"
        name="โครงการ"
        parent="menu_egp_process_root"
        sequence="10"
        groups="purchase.group_purchase_user,purchase_request.group_purchase_request_user"
    />
    <menuitem
        id="menu_egp_list"
        name="รายการโครงการ"
        parent="menu_egp_project_root"
        action="purchase_requisition.action_purchase_requisition"
        sequence="10"
        groups="purchase.group_purchase_user,purchase_request.group_purchase_request_user"
    />
</odoo>
