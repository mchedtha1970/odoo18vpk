<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_requisition_form_egp" model="ir.ui.view">
        <field name="name">purchase.requisition.form.egp</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <field name="vendor_id" position="before">
                <field name="user_id" position="move"/>
            </field>
            <field name="user_id" position="before">
                <field name="requisition_type" position="move"/>
            </field>
            <field name="user_id" position="attributes">
                <attribute name="string">ผู้ทำรายการ</attribute>
            </field>
            <field name="user_id" position="after">
                <field name="is_egp_procurement" invisible="1"/>
                <field
                    name="egp_reference"
                    invisible="requisition_type != 'egp_procurement'"
                />
                <field
                    name="egp_project_name"
                    invisible="requisition_type != 'egp_procurement'"
                />
                <field
                    name="procurement_type_id"
                    string="ประเภทการสั่งซื้อ"
                    invisible="requisition_type != 'egp_procurement'"
                    readonly="state != 'draft'"
                />
                <field
                    name="purchase_type_id"
                    string="ระเบียบ"
                    invisible="requisition_type != 'egp_procurement'"
                    readonly="state != 'draft'"
                />
                <field
                    name="procurement_method_id"
                    string="ซื้อด้วยวิธีการ"
                    invisible="requisition_type != 'egp_procurement'"
                    readonly="state != 'draft'"
                />
            </field>

            <field name="reference" position="attributes">
                <attribute name="invisible">requisition_type == 'egp_procurement'</attribute>
            </field>
            <field name="reference" position="after">
                <field
                    name="purchase_request_id"
                    invisible="requisition_type != 'egp_procurement'"
                    options="{'no_create': True}"
                />
                <field
                    name="purchase_request_amount_total"
                    string="งบประมาณโครงการ"
                    invisible="requisition_type != 'egp_procurement'"
                    readonly="1"
                />
            </field>

            <button name="%(purchase_requisition.action_purchase_requisition_to_so)d" position="attributes">
                <attribute name="invisible">state != 'confirmed' or requisition_type == 'egp_procurement'</attribute>
            </button>

            <button name="%(purchase_requisition.action_purchase_requisition_to_so)d" position="after">
                <button
                    name="action_open_create_rfq_wizard"
                    type="object"
                    string="Create RFQ"
                    class="oe_highlight"
                    invisible="requisition_type != 'egp_procurement' or state not in ('confirmed', 'done')"
                />
                <button
                    name="action_print_contract_essence"
                    type="object"
                    string="พิมพ์ข้อมูลสาระสำคัญในสัญญา"
                    icon="fa-print"
                    invisible="requisition_type != 'egp_procurement'"
                />
            </button>

            <button name="action_done" position="attributes">
                <attribute name="invisible">state != 'confirmed' or requisition_type in ('purchase_template', 'egp_procurement')</attribute>
            </button>

            <field name="state" position="attributes">
                <attribute name="invisible">requisition_type in ('purchase_template', 'egp_procurement')</attribute>
            </field>
            <field name="state" position="after">
                <field
                    name="egp_flow_stage"
                    widget="statusbar"
                    options="{'clickable': true}"
                    invisible="requisition_type != 'egp_procurement'"
                    statusbar_visible="draft,confirmed,egp_docs,rfq,compare,awarded,done"
                />
            </field>

            <xpath expr="//sheet" position="before">
                <field name="egp_flow_html" invisible="1"/>
            </xpath>
            <xpath expr="//sheet/group[1]" position="attributes">
                <attribute name="invisible">requisition_type == 'egp_procurement'</attribute>
            </xpath>
            <xpath expr="//sheet/div[contains(@class, 'oe_title')]" position="after">
                <group name="egp_header_groups" invisible="requisition_type != 'egp_procurement'">
                    <group name="egp_header_left" col="1">
                        <group name="egp_agency" string="ข้อมูลหน่วยงาน">
                            <field
                                name="company_id"
                                string="บริษัท"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="user_id"
                                string="ผู้ทำรายการ"
                                readonly="state != 'draft'"
                                domain="[('share', '=', False)]"
                            />
                        </group>
                        <group name="egp_project_identity" string="ชื่อโครงการ">
                            <field
                                name="egp_reference"
                                string="เลขที่โครงการ"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="egp_project_name"
                                string="ชื่อโครงการ"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group name="egp_project_budget" string="งบประมาณโครงการ">
                            <field
                                name="egp_disbursement_type"
                                string="การเบิกจ่ายเงิน"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="currency_id"
                                string="สกุลเงิน"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                    <group name="egp_header_right" col="1">
                        <group name="egp_project" string="รายละเอียดโครงการ">
                            <field
                                name="procurement_method_id"
                                string="ซื้อด้วยวิธีการ"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="procurement_nature"
                                string="ประเภทการจัดหา"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="egp_item_kind"
                                string="พัสดุที่จัดหา"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="purchase_request_amount_total"
                                string="วงเงินงบประมาณ"
                                widget="monetary"
                                readonly="1"
                            />
                        </group>
                        <group name="egp_consideration" string="การพิจารณา">
                            <field
                                name="egp_consideration_type"
                                string="การพิจารณา"
                                widget="radio"
                                options="{'horizontal': true}"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                </group>
            </xpath>

            <field name="product_description_variants" position="attributes">
                <attribute name="string">คำอธิบายรายการซื้อใน e-GP</attribute>
                <attribute name="invisible">parent.requisition_type != 'egp_procurement' and product_description_variants == ''</attribute>
            </field>
            <xpath expr="//field[@name='line_ids']//field[@name='price_unit']" position="after">
                <field name="currency_id" column_invisible="1"/>
                <field name="budget_amount" widget="monetary" sum="รวมงบประมาณ"
                       optional="show"
                       invisible="parent.requisition_type != 'egp_procurement'"/>
            </xpath>

            <page name="products" position="before">
                <page
                    string="ขั้นตอนการทำงาน"
                    name="egp_flow"
                    invisible="1"
                >
                    <field name="egp_flow_html" nolabel="1"/>
                </page>
            </page>
            <page name="products" position="attributes">
                <attribute name="string">รายการสินค้า/บริการ</attribute>
            </page>

            <label for="date_start" position="attributes">
                <attribute name="invisible">requisition_type in ('purchase_template', 'egp_procurement')</attribute>
            </label>
            <div class="o_row" position="attributes">
                <attribute name="invisible">requisition_type in ('purchase_template', 'egp_procurement')</attribute>
            </div>

            <page name="products" position="after">
                <page
                    string="เอกสารที่เปิดในระบบ e-GP"
                    name="egp_documents"
                    invisible="requisition_type != 'egp_procurement'"
                >
                    <field name="egp_document_ids" context="{'default_requisition_id': id, 'default_egp_reference': egp_reference}">
                        <list editable="bottom">
                            <control>
                                <create name="add_egp_document_control" string="เพิ่มเอกสาร"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field
                                name="document_type_id"
                                string="ประเภทเอกสาร"
                                width="320px"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field name="egp_reference" string="เลขอ้างอิง e-GP"/>
                            <field name="document_date" string="วันที่เอกสาร"/>
                            <field name="document_filename" column_invisible="1"/>
                            <field name="document_type_code" column_invisible="1"/>
                            <field name="document_file" filename="document_filename" widget="binary" string="ไฟล์แนบ (PDF)"/>
                            <button
                                name="action_generate_winner_document"
                                type="object"
                                string="Gen"
                                class="btn-link"
                                invisible="1"
                                title="สร้างเอกสารประกาศผู้ชนะจากเทมเพลต Word"
                            />
                            <button name="action_preview_document" type="object" string="ดูเอกสาร" icon="fa-eye"/>
                            <field name="notes" string="หมายเหตุ" optional="hide"/>
                        </list>
                    </field>
                </page>
                <page
                    string="ผู้เสนอราคาและการพิจารณา"
                    name="egp_rfqs"
                    invisible="requisition_type != 'egp_procurement'"
                >
                    <group>
                        <button
                            name="action_close_after_award"
                            type="object"
                            string="ปิดข้อตกลง (เลือกผู้ชนะแล้ว)"
                            class="btn-primary"
                            invisible="state != 'confirmed'"
                        />
                    </group>
                    <div
                        name="egp_compare_actions"
                        class="oe_egp_compare_actions d-flex flex-wrap gap-1 mb-2"
                    >
                        <button
                            name="action_summarize_offered_totals"
                            type="object"
                            string="สรุปราคารวมที่เสนอ"
                            class="btn-primary"
                            icon="fa-calculator"
                            invisible="egp_consideration_type not in ('line', 'unit')"
                        />
                        <button
                            name="action_print_contract_essence"
                            type="object"
                            string="พิมพ์สาระสำคัญในสัญญา"
                            class="btn-secondary"
                            icon="fa-print"
                        />
                    </div>
                    <div class="text-muted mb-2" invisible="egp_consideration_type not in ('line', 'unit')">
                        โหมดเปรียบเทียบต่อรายการ — ใส่ผู้เสนอราคา รายการสินค้า และราคารวม ระบบจะทอนเป็นราคาต่อหน่วยให้อัตโนมัติ
                    </div>
                    <field
                        name="egp_bid_line_ids"
                        invisible="egp_consideration_type not in ('line', 'unit')"
                        context="{'default_requisition_id': id}"
                    >
                        <list editable="bottom">
                            <field
                                name="partner_id"
                                options="{'no_create_edit': True}"
                                context="{'res_partner_search_mode': 'supplier', 'default_supplier_rank': 1}"
                            />
                            <field name="bid_id" column_invisible="1" required="0"/>
                            <field name="requisition_id" column_invisible="1" required="0"/>
                            <field name="product_id"/>
                            <field name="name" string="คำอธิบายรายการซื้อใน e-GP"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id" groups="uom.group_uom"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="budget_unit_price" optional="show"/>
                            <field name="budget_amount" optional="show"/>
                            <field name="price_unit" string="ราคาต่อหน่วยที่เสนอ"/>
                            <field name="price_subtotal" string="ราคารวมที่เสนอ" readonly="0"/>
                            <field name="is_winner"/>
                        </list>
                    </field>
                    <separator
                        string="สรุปผู้เสนอราคา"
                        invisible="egp_consideration_type not in ('line', 'unit')"
                    />
                    <field name="egp_bid_ids" context="{'default_requisition_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field
                                name="partner_id"
                                options="{'no_create_edit': True}"
                                context="{'res_partner_search_mode': 'supplier', 'default_supplier_rank': 1}"
                            />
                            <field name="egp_bid_reference"/>
                            <field name="bid_date"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="budget_amount_total" sum="รวม" string="ราคารวมงบประมาณ"/>
                            <field name="amount_total" sum="รวม" string="ราคารวมที่เสนอ"/>
                            <field name="is_winner"/>
                            <field name="notes" optional="show"/>
                        </list>
                        <form string="ผู้เสนอราคา">
                            <group>
                                <group>
                                    <field
                                        name="partner_id"
                                        options="{'no_create_edit': True}"
                                        context="{'res_partner_search_mode': 'supplier', 'default_supplier_rank': 1}"
                                    />
                                    <field name="egp_bid_reference"/>
                                    <field name="bid_date"/>
                                </group>
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="budget_amount_total" string="ราคารวมงบประมาณ"/>
                                    <field name="amount_total" string="ราคารวมที่เสนอ"/>
                                    <field name="is_winner"/>
                                    <field name="notes"/>
                                </group>
                            </group>
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="partner_id" column_invisible="1" required="0"/>
                                    <field name="requisition_id" column_invisible="1" required="0"/>
                                    <field name="product_id"/>
                                    <field name="name" string="คำอธิบายรายการซื้อใน e-GP"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="budget_unit_price" optional="show"/>
                                    <field name="budget_amount" optional="show"/>
                                    <field name="price_unit" string="ราคาต่อหน่วยที่เสนอ"/>
                                    <field name="price_subtotal" string="ราคารวมที่เสนอ" readonly="0"/>
                                    <field name="is_winner"/>
                                </list>
                            </field>
                        </form>
                    </field>
                </page>
                <page
                    string="ข้อมูลทั่วไป"
                    name="egp_general"
                    invisible="requisition_type != 'egp_procurement'"
                >
                    <group>
                        <group name="egp_general_left">
                            <field
                                name="requisition_type"
                                readonly="state != 'draft'"
                                options="{'no_create': True}"
                            />
                            <field
                                name="vendor_id"
                                context="{'res_partner_search_mode': 'supplier'}"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="procurement_type_id"
                                string="ประเภทการสั่งซื้อ"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="purchase_type_id"
                                string="ระเบียบ"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group name="egp_general_right">
                            <field
                                name="purchase_request_id"
                                options="{'no_create': True}"
                            />
                            <field
                                name="picking_type_id"
                                options="{'no_open': True, 'no_create': True}"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
