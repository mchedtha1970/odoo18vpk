<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_egp_document_type_list" model="ir.ui.view">
        <field name="name">purchase.requisition.egp.document.type.list</field>
        <field name="model">purchase.requisition.egp.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_egp_document_type_form" model="ir.ui.view">
        <field name="name">purchase.requisition.egp.document.type.form</field>
        <field name="model">purchase.requisition.egp.document.type</field>
        <field name="arch" type="xml">
            <form string="หัวข้อเอกสาร e-GP">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="เก็บถาวร"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="เช่น ประกาศผู้ชนะ"/>
                        </h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_egp_document_type_search" model="ir.ui.view">
        <field name="name">purchase.requisition.egp.document.type.search</field>
        <field name="model">purchase.requisition.egp.document.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="เก็บถาวร" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_egp_document_type" model="ir.actions.act_window">
        <field name="name">หัวข้อเอกสาร e-GP</field>
        <field name="res_model">purchase.requisition.egp.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_egp_document_type"
        name="หัวข้อเอกสาร e-GP"
        parent="purchase.menu_purchase_config"
        action="action_egp_document_type"
        sequence="55"
        groups="purchase.group_purchase_manager"
    />
</odoo>
