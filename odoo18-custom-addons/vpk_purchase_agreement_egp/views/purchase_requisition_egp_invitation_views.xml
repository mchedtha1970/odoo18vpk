<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_egp_invitation_form" model="ir.ui.view">
        <field name="name">purchase.requisition.egp.invitation.form</field>
        <field name="model">purchase.requisition.egp.invitation</field>
        <field name="arch" type="xml">
            <form string="ใบขอเชิญเสนอราคา">
                <header>
                    <button name="action_send" string="บันทึกส่งคำเชิญ"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_responded"
                            string="ได้รับข้อเสนอ / บันทึกราคา"
                            type="object" class="btn-primary"
                            invisible="state != 'sent'"/>
                    <button name="action_open_bid" string="เปิดข้อเสนอราคา"
                            type="object"
                            invisible="not bid_id"/>
                    <button name="action_print" string="พิมพ์ใบเชิญ"
                            type="object" invisible="state == 'cancelled'"/>
                    <button name="action_decline" string="ไม่เข้าร่วม"
                            type="object"
                            invisible="state not in ('draft', 'sent')"/>
                    <button name="action_cancel" string="ยกเลิก"
                            type="object"
                            invisible="state in ('responded', 'cancelled')"/>
                    <button name="action_draft" string="กลับเป็นร่าง"
                            type="object"
                            invisible="state not in ('declined', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,responded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="subject"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="requisition_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="egp_reference"/>
                            <field name="purchase_request_id"/>
                            <field name="partner_id"
                                   options="{'no_create_edit': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="invitation_date"
                                   readonly="state != 'draft'"/>
                            <field name="submission_deadline"
                                   readonly="state != 'draft'"/>
                            <field name="bid_id" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="รายการที่เชิญเสนอราคา">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"
                                           groups="uom.group_uom"/>
                                </list>
                            </field>
                        </page>
                        <page string="เงื่อนไข/หมายเหตุ">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_egp_invitation_list" model="ir.ui.view">
        <field name="name">purchase.requisition.egp.invitation.list</field>
        <field name="model">purchase.requisition.egp.invitation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="requisition_id"/>
                <field name="partner_id"/>
                <field name="invitation_date"/>
                <field name="submission_deadline"/>
                <field name="bid_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'sent'"
                       decoration-success="state == 'responded'"
                       decoration-muted="state in ('declined', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="action_egp_invitation" model="ir.actions.act_window">
        <field name="name">ใบขอเชิญเสนอราคา (eGP)</field>
        <field name="res_model">purchase.requisition.egp.invitation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_purchase_requisition_form_egp_invitation" model="ir.ui.view">
        <field name="name">purchase.requisition.form.egp.invitation</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id"
               ref="vpk_purchase_agreement_egp.view_purchase_requisition_form_egp"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="egp_has_winner" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_egp_invitations" type="object"
                        class="oe_stat_button" icon="fa-envelope"
                        invisible="requisition_type != 'egp_procurement'">
                    <field name="egp_invitation_count" widget="statinfo"
                           string="ใบเชิญเสนอราคา"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='egp_rfqs']" position="before">
                <page string="เชิญเสนอราคา" name="egp_invitations"
                      invisible="requisition_type != 'egp_procurement'">
                    <div class="alert alert-info" role="alert">
                        ขั้นตอนนี้เป็นส่วนหนึ่งของกระบวนการคัดเลือกใน eGP:
                        เชิญผู้ประกอบการ → รับข้อเสนอ → เปรียบเทียบราคา → เลือกผู้ชนะ
                        หลังเลือกผู้ชนะแล้วจึงสร้าง RFQ/PO
                    </div>
                    <field name="egp_invitation_ids"
                           context="{'default_requisition_id': id}">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="invitation_date"/>
                            <field name="submission_deadline"/>
                            <field name="bid_id" optional="show"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-warning="state == 'sent'"
                                   decoration-success="state == 'responded'"
                                   decoration-muted="state in ('declined', 'cancelled')"/>
                            <button name="action_print" type="object"
                                    string="พิมพ์" icon="fa-print"/>
                            <button name="action_mark_responded" type="object"
                                    string="รับข้อเสนอ" icon="fa-check"
                                    invisible="state != 'sent'"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <button name="action_open_create_rfq_wizard"
                    position="attributes">
                <attribute name="string">สร้าง RFQ/PO ผู้ชนะ</attribute>
                <attribute name="invisible">requisition_type != 'egp_procurement' or state not in ('confirmed', 'done') or not egp_has_winner</attribute>
            </button>
        </field>
    </record>
</odoo>
