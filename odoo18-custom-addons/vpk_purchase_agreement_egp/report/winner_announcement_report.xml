<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_winner_announcement" model="report.paperformat">
        <field name="name">ประกาศผู้ชนะการเสนอราคา (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">30</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_winner_announcement" model="ir.actions.report">
        <field name="name">ประกาศผู้ชนะการเสนอราคา</field>
        <field name="model">purchase.requisition.winner.announcement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vpk_purchase_agreement_egp.report_winner_announcement</field>
        <field name="report_file">vpk_purchase_agreement_egp.report_winner_announcement</field>
        <field name="print_report_name">'ประกาศผู้ชนะ-%s' % object.name</field>
        <field name="binding_model_id"
               ref="model_purchase_requisition_winner_announcement"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_winner_announcement"/>
    </record>

    <!-- Layout mirrors docs/แบบฟอร์ม_ประกาศชื่อผู้ชนะในการเสนอราคา.docx -->
    <template id="report_winner_announcement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="asset_base"
                   t-value="env['ir.config_parameter'].sudo().get_param('report.url')
                            or env['ir.config_parameter'].sudo().get_param('web.base.url')
                            or ''"/>
                <t t-set="v" t-value="o._docx_values()"/>
                <div class="article vpk-winner-announcement">
                    <div class="winner-garuda">
                        <img
                            t-att-src="asset_base + '/vpk_purchase_agreement_egp/static/src/img/garuda.jpeg'"
                            alt="ครุฑ"
                        />
                    </div>
                    <p class="winner-title">ประกาศ<t t-esc="v.get('province')"/></p>
                    <p class="winner-center">เรื่อง  <t t-esc="v.get('subject')"/></p>
                    <p class="winner-sep">---------------------------------------------------------------------</p>

                    <p class="winner-body"><t t-esc="v.get('body_intro')"/></p>
                    <p class="winner-body"><t t-esc="v.get('body_winner')"/></p>

                    <p class="winner-date">
                        ประกาศ  ณ  วันที่  <t t-esc="v.get('announce_date')"/>
                    </p>

                    <div class="winner-signer">
                        <p class="line line-name">(<t t-esc="v.get('signer_full')"/>)</p>
                        <p class="line"><t t-esc="v.get('signer_title')"/></p>
                        <p class="line line-acting"><t t-esc="v.get('signer_acting')"/></p>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
