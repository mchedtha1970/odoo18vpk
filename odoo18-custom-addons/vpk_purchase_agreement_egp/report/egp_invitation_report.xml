<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_egp_invitation" model="ir.actions.report">
        <field name="name">ใบขอเชิญเสนอราคา (eGP)</field>
        <field name="model">purchase.requisition.egp.invitation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vpk_purchase_agreement_egp.report_egp_invitation</field>
        <field name="report_file">vpk_purchase_agreement_egp.report_egp_invitation</field>
        <field name="print_report_name">'ใบเชิญเสนอราคา-%s' % object.name</field>
        <field name="binding_model_id"
               ref="model_purchase_requisition_egp_invitation"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_egp_invitation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <style>
                        .vpk-egp-invitation,
                        .vpk-egp-invitation * {
                            font-family: "THSarabunNew", sans-serif !important;
                            font-size: 16pt;
                            line-height: 1.35;
                        }
                        .vpk-egp-invitation h3 {
                            font-family: "THSarabunNew-Bold", "THSarabunNew",
                                         sans-serif !important;
                            font-size: 22pt;
                        }
                        .vpk-egp-invitation strong,
                        .vpk-egp-invitation th {
                            font-family: "THSarabunNew-Bold", "THSarabunNew",
                                         sans-serif !important;
                            font-weight: bold;
                        }
                    </style>
                    <div class="page vpk-egp-invitation">
                        <div class="text-center">
                            <h3>ใบขอเชิญเสนอราคา</h3>
                            <div>กระบวนการจัดซื้อจัดจ้างภาครัฐ (eGP)</div>
                        </div>
                        <table class="table table-sm table-borderless mt-3">
                            <tr>
                                <td style="width:25%;">เลขที่ใบเชิญ</td>
                                <td><strong t-esc="o.name"/></td>
                            </tr>
                            <tr>
                                <td>วันที่</td>
                                <td><span t-field="o.invitation_date"/></td>
                            </tr>
                            <tr>
                                <td>เลขที่โครงการ e-GP</td>
                                <td t-esc="o.egp_reference or '-'"/>
                            </tr>
                            <tr>
                                <td>กระบวนการ eGP</td>
                                <td t-esc="o.requisition_id.name"/>
                            </tr>
                            <tr>
                                <td>ใบขอซื้ออ้างอิง</td>
                                <td t-esc="o.purchase_request_id.name or '-'"/>
                            </tr>
                        </table>

                        <p>เรื่อง <strong t-esc="o.subject"/></p>
                        <p>เรียน <strong t-esc="o.partner_id.name"/></p>
                        <p>
                            โรงพยาบาลมีความประสงค์จะจัดซื้อ/จัดจ้างตามรายการด้านล่าง
                            จึงขอเชิญท่านยื่นข้อเสนอราคาและเอกสารประกอบ
                            ภายในวันที่ <strong><span t-field="o.submission_deadline"/></strong>
                        </p>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th style="width:8%;">ลำดับ</th>
                                    <th>รายการ</th>
                                    <th style="width:15%;">จำนวน</th>
                                    <th style="width:15%;">หน่วย</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center"
                                            t-esc="line_index + 1"/>
                                        <td t-esc="line.name"/>
                                        <td class="text-end"
                                            t-esc="line.product_qty"/>
                                        <td t-esc="line.product_uom_id.name or '-'"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div t-if="o.notes" t-field="o.notes" class="mt-3"/>
                        <div class="mt-5 text-end">
                            <div>ขอแสดงความนับถือ</div>
                            <div class="mt-5">................................................</div>
                            <div>เจ้าหน้าที่พัสดุ</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
