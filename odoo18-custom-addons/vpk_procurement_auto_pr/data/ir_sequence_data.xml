<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_procurement_annual_plan" model="ir.sequence">
        <field name="name">Procurement Annual Plan</field>
        <field name="code">procurement.annual.plan</field>
        <field name="prefix">PAP/%(year)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_procurement_plan_amendment" model="ir.sequence">
        <field name="name">Procurement Plan Amendment</field>
        <field name="code">procurement.plan.amendment</field>
        <field name="prefix">PPA/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_procurement_guarantee" model="ir.sequence">
        <field name="name">Procurement Guarantee</field>
        <field name="code">procurement.guarantee</field>
        <field name="prefix">GRT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <function model="purchase.request" name="_vpk_force_pr_auto_name"/>
</odoo>
