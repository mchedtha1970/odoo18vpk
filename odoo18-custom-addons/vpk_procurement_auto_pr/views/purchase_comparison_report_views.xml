<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_comparison_report_list"
            model="ir.ui.view">
        <field name="name">purchase.report.comparison.list</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <list string="รายงานเปรียบเทียบยอดซื้อสินค้า"
                  create="false"
                  edit="false"
                  delete="false"
                  default_order="date_order desc, order_id">
                <field name="date_order" string="วันที่สั่งซื้อ"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <field name="qty_ordered"
                       sum="รวมจำนวนสั่ง"/>
                <field name="qty_received"
                       sum="รวมจำนวนรับ"/>
                <field name="qty_billed"
                       sum="รวมจำนวนตั้งหนี้"
                       optional="show"/>
                <field name="price_average"/>
                <field name="untaxed_total"
                       sum="รวมก่อนภาษี"/>
                <field name="price_total"
                       sum="รวมยอดซื้อ"/>
                <field name="currency_id"
                       column_invisible="True"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_comparison_report_pivot"
            model="ir.ui.view">
        <field name="name">purchase.report.comparison.pivot</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <pivot string="เปรียบเทียบยอดซื้อสินค้า">
                <field name="product_id" type="row"/>
                <field name="category_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="qty_ordered" type="measure"/>
                <field name="qty_received" type="measure"/>
                <field name="untaxed_total" type="measure"/>
                <field name="price_total" type="measure"/>
                <field name="price_average" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_purchase_comparison_report_graph"
            model="ir.ui.view">
        <field name="name">purchase.report.comparison.graph</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <graph string="เปรียบเทียบยอดซื้อสินค้า"
                   type="bar">
                <field name="product_id"/>
                <field name="price_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_purchase_comparison_report_search"
            model="ir.ui.view">
        <field name="name">purchase.report.comparison.search</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <search string="ค้นหายอดซื้อสินค้า">
                <field name="date_order"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <separator/>
                <filter string="รายเดือน"
                        name="group_purchase_month"
                        domain="[]"
                        context="{'group_by': 'date_order:month'}"/>
                <filter string="รายไตรมาส"
                        name="group_purchase_quarter"
                        domain="[]"
                        context="{'group_by': 'date_order:quarter'}"/>
                <filter string="รายปี"
                        name="group_purchase_year"
                        domain="[]"
                        context="{'group_by': 'date_order:year'}"/>
                <separator/>
                <filter string="สินค้า"
                        name="group_purchase_product"
                        domain="[]"
                        context="{'group_by': 'product_id'}"/>
                <filter string="หมวดสินค้า"
                        name="group_purchase_category"
                        domain="[]"
                        context="{'group_by': 'category_id'}"/>
                <filter string="ผู้จำหน่าย"
                        name="group_purchase_vendor"
                        domain="[]"
                        context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_comparison_report"
            model="ir.actions.act_window">
        <field name="name">เปรียบเทียบยอดซื้อสินค้า</field>
        <field name="res_model">purchase.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id"
               ref="view_purchase_comparison_report_pivot"/>
        <field name="search_view_id"
               ref="view_purchase_comparison_report_search"/>
        <field name="domain">
            [('state', 'in', ('purchase', 'done'))]
        </field>
        <field name="context">
            {'search_default_group_purchase_month': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ยังไม่มีข้อมูลยอดซื้อที่ยืนยันแล้ว
            </p>
        </field>
    </record>

    <record id="action_purchase_comparison_report_pivot"
            model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">pivot</field>
        <field name="view_id"
               ref="view_purchase_comparison_report_pivot"/>
        <field name="act_window_id"
               ref="action_purchase_comparison_report"/>
    </record>

    <record id="action_purchase_comparison_report_graph"
            model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">graph</field>
        <field name="view_id"
               ref="view_purchase_comparison_report_graph"/>
        <field name="act_window_id"
               ref="action_purchase_comparison_report"/>
    </record>

    <record id="action_purchase_comparison_report_list"
            model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">list</field>
        <field name="view_id"
               ref="view_purchase_comparison_report_list"/>
        <field name="act_window_id"
               ref="action_purchase_comparison_report"/>
    </record>

    <menuitem id="menu_purchase_comparison_report"
              name="เปรียบเทียบยอดซื้อสินค้า"
              parent="purchase.purchase_report_main"
              action="action_purchase_comparison_report"
              sequence="35"
              groups="purchase.group_purchase_user"/>
</odoo>
