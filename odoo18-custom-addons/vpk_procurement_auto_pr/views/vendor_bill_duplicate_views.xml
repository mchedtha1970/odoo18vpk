<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vendor_bill_duplicate_vpk"
            model="ir.ui.view">
        <field name="name">account.move.form.vendor.bill.duplicate.vpk</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[field[@name='duplicated_ref_ids']]"
                   position="before">
                <field name="vendor_bill_unique_key" invisible="1"/>
                <div class="alert alert-danger w-100"
                     role="alert"
                     invisible="not vendor_bill_duplicate_ids">
                    <strong>
                        ไม่สามารถบันทึกได้: เลขที่ใบวางบิลนี้ซ้ำกับ
                    </strong>
                    <field name="vendor_bill_duplicate_ids"
                           widget="x2many_buttons"
                           string="เอกสารที่พบ"
                           context="{'name_as_amount_total': True}"/>
                    <div>
                        กรุณาตรวจสอบผู้จำหน่ายและเลขที่ใบวางบิลก่อนบันทึก
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
