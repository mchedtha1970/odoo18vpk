<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_plan_amendment_form" model="ir.ui.view">
        <field name="name">procurement.plan.amendment.form</field>
        <field name="model">procurement.plan.amendment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="ส่งขออนุมัติ" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="อนุมัติเพิ่มแผน" type="object"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="purchase.group_purchase_manager"/>
                    <button name="action_reject" string="ไม่อนุมัติ" type="object"
                            invisible="state != 'submitted'"
                            groups="purchase.group_purchase_manager"/>
                    <button name="action_cancel" string="ยกเลิก" type="object"
                            invisible="state in ('approved', 'cancelled')"/>
                    <button name="action_draft" string="กลับเป็นร่าง" type="object"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id" readonly="state != 'draft'"/>
                            <field name="source_type" readonly="state != 'draft'"/>
                            <field name="requested_by" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="เหตุผล">
                        <field name="reason" nolabel="1" readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page string="รายการที่ขอเพิ่ม">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="purchase_type"/>
                                    <field name="product_id"/>
                                    <field name="contract_id"/>
                                    <field name="name"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="qty_requested"/>
                                    <field name="amount_requested" sum="รวม"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_procurement_plan_amendment_list" model="ir.ui.view">
        <field name="name">procurement.plan.amendment.list</field>
        <field name="model">procurement.plan.amendment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="source_type"/>
                <field name="requested_by"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="action_procurement_plan_amendment" model="ir.actions.act_window">
        <field name="name">คำขอเพิ่มแผน</field>
        <field name="res_model">procurement.plan.amendment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
