<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_penalty" model="ir.ui.view">
        <field name="name">purchase.order.form.penalty</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">96</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="ค่าปรับ/ผิดข้อกำหนด"
                      name="vpk_purchase_penalties">
                    <group>
                        <group string="สรุปค่าปรับ">
                            <field name="penalty_count"/>
                            <field name="total_penalty_amount"/>
                            <field name="net_amount_after_penalty"/>
                        </group>
                        <group string="หลักการคำนวณ">
                            <div class="alert alert-info" role="alert">
                                ค่าปรับรายวัน = ฐานคำนวณ × อัตราร้อยละ
                                × จำนวนวันล่าช้า
                            </div>
                        </group>
                    </group>
                    <field name="penalty_ids"
                           context="{'default_base_amount': amount_untaxed, 'default_due_date': procurement_due_date}">
                        <list decoration-success="state == 'deducted'"
                              decoration-muted="state == 'waived'">
                            <field name="name"/>
                            <field name="penalty_type"/>
                            <field name="calculation_method"/>
                            <field name="due_date"/>
                            <field name="actual_date"/>
                            <field name="late_days"/>
                            <field name="base_amount"/>
                            <field name="penalty_rate"
                                   invisible="calculation_method == 'fixed'"/>
                            <field name="fixed_amount"
                                   invisible="calculation_method != 'fixed'"/>
                            <field name="penalty_amount" sum="รวมค่าปรับ"/>
                            <field name="state" widget="badge"/>
                            <button name="action_confirm"
                                    type="object"
                                    string="ยืนยัน"
                                    icon="fa-check"
                                    invisible="state != 'draft'"/>
                            <button name="action_mark_deducted"
                                    type="object"
                                    string="หักแล้ว"
                                    icon="fa-money"
                                    invisible="state != 'confirmed'"/>
                            <button name="action_waive"
                                    type="object"
                                    string="ยกเว้น"
                                    icon="fa-ban"
                                    invisible="state not in ('draft', 'confirmed')"/>
                        </list>
                        <form string="รายการค่าปรับ">
                            <header>
                                <button name="action_confirm"
                                        type="object"
                                        string="ยืนยันค่าปรับ"
                                        class="btn-primary"
                                        invisible="state != 'draft'"/>
                                <button name="action_mark_deducted"
                                        type="object"
                                        string="บันทึกว่าหักค่าปรับแล้ว"
                                        class="btn-primary"
                                        invisible="state != 'confirmed'"/>
                                <button name="action_waive"
                                        type="object"
                                        string="ยกเว้นค่าปรับ"
                                        invisible="state not in ('draft', 'confirmed')"/>
                                <button name="action_draft"
                                        type="object"
                                        string="กลับเป็นแบบร่าง"
                                        invisible="state not in ('deducted', 'waived')"/>
                                <field name="state"
                                       widget="statusbar"
                                       statusbar_visible="draft,confirmed,deducted"/>
                            </header>
                            <sheet>
                                <group>
                                    <group string="เหตุผิดข้อกำหนด">
                                        <field name="name" readonly="state != 'draft'"/>
                                        <field name="penalty_type" readonly="state != 'draft'"/>
                                        <field name="partner_id"/>
                                        <field name="noncompliance_detail"
                                               readonly="state != 'draft'"/>
                                    </group>
                                    <group string="การคำนวณค่าปรับ">
                                        <field name="calculation_method"
                                               readonly="state != 'draft'"/>
                                        <field name="due_date" readonly="state != 'draft'"/>
                                        <field name="actual_date" readonly="state != 'draft'"/>
                                        <field name="late_days"/>
                                        <field name="base_amount" readonly="state != 'draft'"/>
                                        <field name="penalty_rate"
                                               readonly="state != 'draft'"
                                               invisible="calculation_method == 'fixed'"/>
                                        <field name="fixed_amount"
                                               readonly="state != 'draft'"
                                               invisible="calculation_method != 'fixed'"/>
                                        <field name="penalty_amount"/>
                                        <field name="currency_id" invisible="1"/>
                                    </group>
                                </group>
                            </sheet>
                            <chatter/>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_procurement_purchase_penalty_list" model="ir.ui.view">
        <field name="name">procurement.purchase.penalty.list</field>
        <field name="model">procurement.purchase.penalty</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'deducted'"
                  decoration-muted="state == 'waived'">
                <field name="purchase_order_id"/>
                <field name="partner_id"/>
                <field name="penalty_type"/>
                <field name="late_days"/>
                <field name="base_amount"/>
                <field name="penalty_amount" sum="รวมค่าปรับ"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_procurement_purchase_penalty_form" model="ir.ui.view">
        <field name="name">procurement.purchase.penalty.form</field>
        <field name="model">procurement.purchase.penalty</field>
        <field name="arch" type="xml">
            <form string="รายการค่าปรับ">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="ยืนยันค่าปรับ"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_deducted"
                            type="object"
                            string="หักค่าปรับแล้ว"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_waive"
                            type="object"
                            string="ยกเว้นค่าปรับ"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,deducted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group string="เหตุผิดข้อกำหนด">
                            <field name="purchase_order_id" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="penalty_type" readonly="state != 'draft'"/>
                            <field name="noncompliance_detail" readonly="state != 'draft'"/>
                        </group>
                        <group string="การคำนวณค่าปรับ">
                            <field name="calculation_method" readonly="state != 'draft'"/>
                            <field name="due_date" readonly="state != 'draft'"/>
                            <field name="actual_date" readonly="state != 'draft'"/>
                            <field name="late_days"/>
                            <field name="base_amount" readonly="state != 'draft'"/>
                            <field name="penalty_rate"
                                   readonly="state != 'draft'"
                                   invisible="calculation_method == 'fixed'"/>
                            <field name="fixed_amount"
                                   readonly="state != 'draft'"
                                   invisible="calculation_method != 'fixed'"/>
                            <field name="penalty_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_procurement_purchase_penalty_search" model="ir.ui.view">
        <field name="name">procurement.purchase.penalty.search</field>
        <field name="model">procurement.purchase.penalty</field>
        <field name="arch" type="xml">
            <search>
                <field name="purchase_order_id"/>
                <field name="partner_id"/>
                <field name="penalty_type"/>
                <filter name="confirmed"
                        string="ยืนยันค่าปรับแล้ว"
                        domain="[('state', 'in', ('confirmed', 'deducted'))]"/>
                <filter name="not_deducted"
                        string="รอหักค่าปรับ"
                        domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter name="group_partner"
                            string="ผู้จำหน่าย"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type"
                            string="ประเภทความผิด"
                            context="{'group_by': 'penalty_type'}"/>
                    <filter name="group_state"
                            string="สถานะ"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_procurement_purchase_penalty" model="ir.actions.act_window">
        <field name="name">ทะเบียนค่าปรับจัดซื้อจัดจ้าง</field>
        <field name="res_model">procurement.purchase.penalty</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_procurement_purchase_penalty_search"/>
    </record>

    <menuitem id="menu_procurement_purchase_penalty"
              name="ทะเบียนค่าปรับ"
              parent="purchase.menu_procurement_management"
              action="action_procurement_purchase_penalty"
              sequence="31"
              groups="purchase.group_purchase_user"/>
</odoo>
