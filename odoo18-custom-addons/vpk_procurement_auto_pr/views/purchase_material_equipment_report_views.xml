<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_material_equipment_report_list"
            model="ir.ui.view">
        <field name="name">purchase.report.material.equipment.list</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <list string="ยอดซื้อสินค้าแยกวัสดุและครุภัณฑ์"
                  create="false"
                  edit="false"
                  delete="false"
                  default_order="hospital_item_type, date_order desc, product_id">
                <field name="date_order" string="วันที่สั่งซื้อ"/>
                <field name="hospital_item_type"
                       widget="badge"
                       decoration-info="hospital_item_type == 'material'"
                       decoration-warning="hospital_item_type == 'equipment'"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="qty_ordered"
                       sum="รวมจำนวนสั่ง"/>
                <field name="qty_received"
                       sum="รวมจำนวนรับ"/>
                <field name="price_average"/>
                <field name="untaxed_total"
                       sum="รวมก่อนภาษี"/>
                <field name="price_total"
                       sum="รวมยอดซื้อ"/>
                <field name="currency_id"
                       column_invisible="True"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_material_equipment_report_pivot"
            model="ir.ui.view">
        <field name="name">purchase.report.material.equipment.pivot</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <pivot string="สรุปยอดซื้อวัสดุและครุภัณฑ์">
                <field name="hospital_item_type" type="row"/>
                <field name="category_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="date_order" type="col"
                       interval="month"/>
                <field name="qty_ordered" type="measure"/>
                <field name="qty_received" type="measure"/>
                <field name="untaxed_total" type="measure"/>
                <field name="price_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_purchase_material_equipment_report_graph"
            model="ir.ui.view">
        <field name="name">purchase.report.material.equipment.graph</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <graph string="เปรียบเทียบยอดซื้อวัสดุและครุภัณฑ์"
                   type="bar"
                   stacked="1">
                <field name="hospital_item_type"/>
                <field name="price_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_purchase_material_equipment_report_search"
            model="ir.ui.view">
        <field name="name">purchase.report.material.equipment.search</field>
        <field name="model">purchase.report</field>
        <field name="arch" type="xml">
            <search string="ค้นหายอดซื้อวัสดุและครุภัณฑ์">
                <field name="date_order"/>
                <field name="hospital_item_type"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter string="วัสดุ"
                        name="purchase_material"
                        domain="[('hospital_item_type', '=', 'material')]"/>
                <filter string="ครุภัณฑ์"
                        name="purchase_equipment"
                        domain="[('hospital_item_type', '=', 'equipment')]"/>
                <separator/>
                <filter string="ประเภทสินค้า/พัสดุ"
                        name="group_hospital_item_type"
                        domain="[]"
                        context="{'group_by': 'hospital_item_type'}"/>
                <filter string="หมวดสินค้า"
                        name="group_material_equipment_category"
                        domain="[]"
                        context="{'group_by': 'category_id'}"/>
                <filter string="สินค้า"
                        name="group_material_equipment_product"
                        domain="[]"
                        context="{'group_by': 'product_id'}"/>
                <filter string="รายเดือน"
                        name="group_material_equipment_month"
                        domain="[]"
                        context="{'group_by': 'date_order:month'}"/>
                <filter string="รายไตรมาส"
                        name="group_material_equipment_quarter"
                        domain="[]"
                        context="{'group_by': 'date_order:quarter'}"/>
                <filter string="รายปี"
                        name="group_material_equipment_year"
                        domain="[]"
                        context="{'group_by': 'date_order:year'}"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_material_equipment_report"
            model="ir.actions.act_window">
        <field name="name">ยอดซื้อแยกวัสดุ/ครุภัณฑ์</field>
        <field name="res_model">purchase.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id"
               ref="view_purchase_material_equipment_report_pivot"/>
        <field name="search_view_id"
               ref="view_purchase_material_equipment_report_search"/>
        <field name="domain">
            [('state', 'in', ('purchase', 'done')),
             ('hospital_item_type', 'in', ('material', 'equipment'))]
        </field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ไม่พบยอดซื้อสินค้าที่จัดประเภทเป็นวัสดุหรือครุภัณฑ์
            </p>
        </field>
    </record>

    <record id="action_purchase_material_equipment_report_pivot"
            model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">pivot</field>
        <field name="view_id"
               ref="view_purchase_material_equipment_report_pivot"/>
        <field name="act_window_id"
               ref="action_purchase_material_equipment_report"/>
    </record>

    <record id="action_purchase_material_equipment_report_graph"
            model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">graph</field>
        <field name="view_id"
               ref="view_purchase_material_equipment_report_graph"/>
        <field name="act_window_id"
               ref="action_purchase_material_equipment_report"/>
    </record>

    <record id="action_purchase_material_equipment_report_list"
            model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">list</field>
        <field name="view_id"
               ref="view_purchase_material_equipment_report_list"/>
        <field name="act_window_id"
               ref="action_purchase_material_equipment_report"/>
    </record>

    <menuitem id="menu_purchase_material_equipment_report"
              name="ยอดซื้อแยกวัสดุ/ครุภัณฑ์"
              parent="purchase.purchase_report_main"
              action="action_purchase_material_equipment_report"
              sequence="36"
              groups="purchase.group_purchase_user"/>
</odoo>
