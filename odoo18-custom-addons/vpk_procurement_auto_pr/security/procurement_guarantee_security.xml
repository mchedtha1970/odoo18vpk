<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="procurement_guarantee_pr_user_own_rule" model="ir.rule">
        <field name="name">หลักประกัน: หน่วยงานดูได้เฉพาะของใบขอซื้อตนเอง</field>
        <field name="model_id" ref="model_procurement_guarantee"/>
        <field name="groups" eval="[(4, ref('purchase_request.group_purchase_request_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            ['|', '|',
             ('contract_id.purchase_request_ids.requested_by', '=', user.id),
             ('contract_id.requisition_id.purchase_request_id.requested_by', '=', user.id),
             ('contract_id.requisition_id.line_ids.purchase_request_lines.request_id.requested_by', '=', user.id)]
        </field>
    </record>
    <record id="procurement_guarantee_pr_manager_all_rule" model="ir.rule">
        <field name="name">หลักประกัน: หัวหน้าพัสดุดูได้ทั้งหมด</field>
        <field name="model_id" ref="model_procurement_guarantee"/>
        <field name="groups" eval="[(4, ref('purchase_request.group_purchase_request_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="procurement_guarantee_purchase_user_all_rule" model="ir.rule">
        <field name="name">หลักประกัน: เจ้าหน้าที่จัดซื้อดูได้ทั้งหมด</field>
        <field name="model_id" ref="model_procurement_guarantee"/>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
