<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_credit_note_editor" model="res.groups">
        <field name="name">แก้ไขเอกสารลดหนี้</field>
        <field name="category_id"
               ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids"
               eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">
            สามารถแก้ไขรายละเอียดใบลดหนี้ลูกค้าและใบลดหนี้ผู้จำหน่ายที่เป็นร่าง
        </field>
    </record>

    <record id="group_credit_note_creator" model="res.groups">
        <field name="name">สร้างเอกสารลดหนี้</field>
        <field name="category_id"
               ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids"
               eval="[(4, ref('group_credit_note_editor'))]"/>
        <field name="comment">
            สามารถสร้างใบลดหนี้ และได้รับสิทธิ์แก้ไขใบลดหนี้ที่เป็นร่าง
        </field>
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids"
               eval="[(4, ref('group_credit_note_creator'))]"/>
    </record>
</odoo>
