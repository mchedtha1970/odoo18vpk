<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vpk_payment_voucher" model="ir.ui.view">
        <field name="name">account.move.form.vpk.payment.voucher</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_payment_voucher"
                        type="object"
                        string="สร้างใบสำคัญจ่าย"
                        class="btn-secondary"
                        invisible="move_type != 'in_invoice' or state != 'posted'"/>
            </xpath>
        </field>
    </record>
</odoo>
