                <span class="text-muted" t-if="record.discount.raw_value">
                    ส่วนลด: <field name="discount"/>%
                </span>
            </xpath>
            <xpath expr="//code[text()='/vendor']/parent::div" position="replace">
                <div colspan="2" class="text-muted">
                    เข้าสู่ระบบผู้ขาย: <code>/vendor</code> — หลังเข้าสู่ระบบจะเห็นใบสั่งซื้อของตัวเองแล้วกดยืนยันได้
                </div>
            </xpath>
            <xpath expr="//button[.//field[@name='mrp_production_count']]//span[hasclass('o_stat_text')]" position="replace">
                <span class="o_stat_text">การผลิต</span>
            </xpath>
            <xpath expr="//button[.//field[@name='sale_order_count']]//span[hasclass('o_stat_text')]" position="replace">
                <span class="o_stat_text">การขาย</span>
            </xpath>
        </field>
    </record>
</odoo>
