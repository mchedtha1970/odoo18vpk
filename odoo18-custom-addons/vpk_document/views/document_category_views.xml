<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vpk_document_category_list" model="ir.ui.view">
        <field name="name">vpk.document.category.list</field>
        <field name="model">vpk.document.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="complete_name" string="โฟลเดอร์"/>
                <field name="parent_id" optional="hide"/>
                <field name="code" optional="show"/>
                <field name="document_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_vpk_document_category_form" model="ir.ui.view">
        <field name="name">vpk.document.category.form</field>
        <field name="model">vpk.document.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ชื่อโฟลเดอร์"/></h1>
                    </div>
                    <group>
                        <field name="parent_id"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="คำอธิบาย">
                        <field name="description" nolabel="1" placeholder="อธิบายโฟลเดอร์นี้..."/>
                    </group>
                    <notebook>
                        <page string="โฟลเดอร์ย่อย">
                            <field name="child_ids" context="{'default_parent_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="document_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vpk_document_category_search" model="ir.ui.view">
        <field name="name">vpk.document.category.search</field>
        <field name="model">vpk.document.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="parent_id"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_vpk_document_category" model="ir.actions.act_window">
        <field name="name">หมวดหมู่ไฟล์</field>
        <field name="res_model">vpk.document.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">สร้างโฟลเดอร์</p>
            <p>เปิดโฟลเดอร์แล้วเพิ่มโฟลเดอร์ย่อยได้ในแท็บโฟลเดอร์ย่อย</p>
        </field>
    </record>
</odoo>
