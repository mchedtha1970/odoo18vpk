<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_assign_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.assign.wizard.form</field>
        <field name="model">purchase.request.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="มอบหมายงานพัสดุ">
                <group>
                    <field name="request_count" invisible="1"/>
                    <field
                        name="request_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                        readonly="1"
                    />
                    <field
                        name="user_id"
                        options="{'no_create': True, 'no_open': True}"
                        placeholder="เลือกเจ้าหน้าที่พัสดุที่เกี่ยวข้อง..."
                    />
                    <field
                        name="note"
                        placeholder="เช่น มอบหมายให้ดำเนินการจัดซื้อยา / วัสดุ ของหน่วยงานนี้"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm_assign"
                        type="object"
                        string="มอบหมายงาน"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_request_assign_wizard" model="ir.actions.act_window">
        <field name="name">มอบหมายงาน</field>
        <field name="res_model">purchase.request.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="purchase_request.model_purchase_request"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('purchase_request.group_purchase_request_manager'))]"/>
        <field name="context">{'default_request_ids': [(6, 0, active_ids)]}</field>
    </record>
</odoo>
