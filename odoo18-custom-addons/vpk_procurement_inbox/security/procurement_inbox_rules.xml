<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_request_assigned_officer_rule" model="ir.rule">
        <field name="name">ใบขอซื้อที่มอบหมายให้เจ้าหน้าที่จัดซื้อ</field>
        <field name="model_id" ref="purchase_request.model_purchase_request"/>
        <field name="groups" eval="[(4, ref('vpk_tier_validation.group_vpk_procurement_officer'))]"/>
        <field name="domain_force">[('procurement_owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="purchase_request_line_assigned_officer_rule" model="ir.rule">
        <field name="name">รายการใบขอซื้อที่มอบหมายให้เจ้าหน้าที่จัดซื้อ</field>
        <field name="model_id" ref="purchase_request.model_purchase_request_line"/>
        <field name="groups" eval="[(4, ref('vpk_tier_validation.group_vpk_procurement_officer'))]"/>
        <field name="domain_force">[('request_id.procurement_owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
