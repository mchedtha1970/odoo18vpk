<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="user_uat_purchase" model="res.users">
        <field name="name">ผู้ทดสอบจัดซื้อ</field>
        <field name="login">uat.purchase</field>
        <field name="email">uat.purchase@vpk.local</field>
        <field name="groups_id" eval="[
            (4, ref('vpk_tier_validation.group_vpk_procurement_officer')),
            (4, ref('purchase_request.group_purchase_request_user')),
        ]"/>
    </record>

    <record id="user_uat_material" model="res.users">
        <field name="name">กลุ่มวัสดุ</field>
        <field name="login">uat.material</field>
        <field name="email">uat.material@vpk.local</field>
        <field name="groups_id" eval="[
            (4, ref('vpk_tier_validation.group_vpk_procurement_officer')),
            (4, ref('purchase_request.group_purchase_request_user')),
            (4, ref('stock.group_stock_user')),
        ]"/>
    </record>

    <record id="user_uat_equipment" model="res.users">
        <field name="name">กลุ่มครุภัณฑ์</field>
        <field name="login">uat.equipment</field>
        <field name="email">uat.equipment@vpk.local</field>
        <field name="groups_id" eval="[
            (4, ref('vpk_tier_validation.group_vpk_procurement_officer')),
            (4, ref('purchase_request.group_purchase_request_user')),
        ]"/>
    </record>

    <!-- หน่วยงานเภสัช: ใช้ทดสอบ Scenario ซื้อยา e-bidding (ตั้งงบ / เปิด PR / PR ตามสัญญา) -->
    <record id="department_uat_pharmacy" model="hr.department">
        <field name="name">กลุ่มงานเภสัชกรรม</field>
    </record>

    <record id="user_uat_pharmacy" model="res.users">
        <field name="name">ผู้ทดสอบกลุ่มงานเภสัชกรรม</field>
        <field name="login">uat.pharmacy</field>
        <field name="email">uat.pharmacy@vpk.local</field>
        <field name="lang">th_TH</field>
        <field name="tz">Asia/Bangkok</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
        <field name="groups_id" eval="[
            (4, ref('base.group_user')),
            (4, ref('base.group_partner_manager')),
            (4, ref('purchase_request.group_purchase_request_user')),
            (4, ref('vpk_budget.group_vpk_budget_user')),
            (4, ref('vpk_budget.group_budget_request_department_user')),
        ]"/>
    </record>

    <record id="employee_uat_pharmacy" model="hr.employee">
        <field name="name">ผู้ทดสอบกลุ่มงานเภสัชกรรม</field>
        <field name="user_id" ref="user_uat_pharmacy"/>
        <field name="department_id" ref="department_uat_pharmacy"/>
    </record>

    <!-- ผู้ลงนามของกลุ่มงานเภสัชกรรม (ตำแหน่งตามบล็อกลายเซ็นในเอกสาร) -->
    <record id="user_uat_pharm_supply_head" model="res.users">
        <field name="name">ผู้ทดสอบหัวหน้างานบริหารเวชภัณฑ์ยา</field>
        <field name="login">uat.pharm_supply_head</field>
        <field name="email">uat.pharm_supply_head@vpk.local</field>
        <field name="lang">th_TH</field>
        <field name="tz">Asia/Bangkok</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
        <field name="groups_id" eval="[
            (4, ref('base.group_user')),
            (4, ref('purchase_request.group_purchase_request_user')),
        ]"/>
    </record>

    <record id="employee_uat_pharm_supply_head" model="hr.employee">
        <field name="name">ผู้ทดสอบหัวหน้างานบริหารเวชภัณฑ์ยา</field>
        <field name="job_title">เภสัชกรชำนาญการพิเศษ หัวหน้างานบริหารเวชภัณฑ์ยา</field>
        <field name="user_id" ref="user_uat_pharm_supply_head"/>
        <field name="department_id" ref="department_uat_pharmacy"/>
    </record>

    <record id="user_uat_pharm_head" model="res.users">
        <field name="name">ผู้ทดสอบหัวหน้ากลุ่มงานเภสัชกรรม</field>
        <field name="login">uat.pharm_head</field>
        <field name="email">uat.pharm_head@vpk.local</field>
        <field name="lang">th_TH</field>
        <field name="tz">Asia/Bangkok</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
        <field name="groups_id" eval="[
            (4, ref('base.group_user')),
            (4, ref('purchase_request.group_purchase_request_user')),
        ]"/>
    </record>

    <record id="employee_uat_pharm_head" model="hr.employee">
        <field name="name">ผู้ทดสอบหัวหน้ากลุ่มงานเภสัชกรรม</field>
        <field name="job_title">เภสัชกรเชี่ยวชาญ หัวหน้ากลุ่มงานเภสัชกรรม</field>
        <field name="user_id" ref="user_uat_pharm_head"/>
        <field name="department_id" ref="department_uat_pharmacy"/>
    </record>

</odoo>
