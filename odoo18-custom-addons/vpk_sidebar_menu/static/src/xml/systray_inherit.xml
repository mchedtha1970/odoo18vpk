<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.SwitchCompanyMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_switch_company_menu')]" position="attributes">
            <attribute name="class" remove="d-none d-md-block" separator=" "/>
        </xpath>
        <xpath expr="//button" position="attributes">
            <attribute name="class" add="o_vpk_company_toggle" separator=" "/>
        </xpath>
        <xpath expr="//span[hasclass('oe_topbar_name')]" position="replace">
            <span class="ri ri-building-2-line o_vpk_company_icon"/>
        </xpath>
        <xpath expr="//i[hasclass('fa-building')]" position="replace"/>
    </t>

</templates>
