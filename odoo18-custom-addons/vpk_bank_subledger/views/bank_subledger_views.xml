<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_subledger_account_list" model="ir.ui.view">
        <field name="name">vpk.bank.subledger.account.list</field>
        <field name="model">vpk.bank.subledger.account</field>
        <field name="arch" type="xml">
            <list string="บัญชีคุมเงินฝากธนาคาร">
                <field name="sequence" widget="handle"/>
                <field name="account_id"/>
                <field name="acc_number"/>
                <field name="name"/>
                <field name="balance" sum="คงเหลือ"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bank_subledger_account_form" model="ir.ui.view">
        <field name="name">vpk.bank.subledger.account.form</field>
        <field name="model">vpk.bank.subledger.account</field>
        <field name="arch" type="xml">
            <form string="บัญชีคุมเงินฝากธนาคาร">
                <sheet>
                    <div class="oe_title">
                        <label for="acc_number"/>
                        <h1><field name="acc_number" placeholder="เลขที่บัญชี"/></h1>
                        <label for="name"/>
                        <h2><field name="name" placeholder="ชื่อบัญชี"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="balance"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="note" placeholder="หมายเหตุ"/>
                    <notebook>
                        <page string="รายการรับจ่าย" name="moves">
                            <field name="move_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="line_type"/>
                                    <field name="name"/>
                                    <field name="ref" optional="hide"/>
                                    <field name="debit" sum="รับ"/>
                                    <field name="credit" sum="จ่าย"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bank_subledger_account_search" model="ir.ui.view">
        <field name="name">vpk.bank.subledger.account.search</field>
        <field name="model">vpk.bank.subledger.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="acc_number"/>
                <field name="name"/>
                <field name="account_id"/>
                <filter name="group_account" string="ผังบัญชี" context="{'group_by': 'account_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_bank_subledger_account" model="ir.actions.act_window">
        <field name="name">บัญชีเงินฝาก</field>
        <field name="res_model">vpk.bank.subledger.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_account': 1}</field>
    </record>

    <record id="view_bank_subledger_move_list" model="ir.ui.view">
        <field name="name">vpk.bank.subledger.move.list</field>
        <field name="model">vpk.bank.subledger.move</field>
        <field name="arch" type="xml">
            <list string="รายการรับจ่าย" editable="bottom">
                <field name="date"/>
                <field name="subledger_id"/>
                <field name="account_id" optional="show"/>
                <field name="line_type"/>
                <field name="name"/>
                <field name="ref" optional="hide"/>
                <field name="debit" sum="รับ"/>
                <field name="credit" sum="จ่าย"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_bank_subledger_move_search" model="ir.ui.view">
        <field name="name">vpk.bank.subledger.move.search</field>
        <field name="model">vpk.bank.subledger.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="subledger_id"/>
                <field name="acc_number"/>
                <field name="name"/>
                <field name="account_id"/>
                <filter name="receipts" string="รับ" domain="[('line_type', '=', 'receipt')]"/>
                <filter name="payments" string="จ่าย" domain="[('line_type', '=', 'payment')]"/>
                <filter name="opening" string="ยอดยกมา" domain="[('line_type', '=', 'opening')]"/>
                <filter name="group_account" string="ผังบัญชี" context="{'group_by': 'account_id'}"/>
                <filter name="group_bank" string="บัญชีธนาคาร" context="{'group_by': 'subledger_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_bank_subledger_move" model="ir.actions.act_window">
        <field name="name">รายการรับจ่าย</field>
        <field name="res_model">vpk.bank.subledger.move</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_bank_subledger_report_form" model="ir.ui.view">
        <field name="name">vpk.bank.subledger.report.form</field>
        <field name="model">vpk.bank.subledger.report</field>
        <field name="arch" type="xml">
            <form string="รายงานเงินฝากธนาคาร">
                <header>
                    <button name="action_compute" type="object" string="คำนวณ" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="ส่งออก Excel"/>
                </header>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="account_id"/>
                        <field name="hide_zero"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1">
                    <list decoration-bf="is_total" create="0" delete="0">
                        <field name="gl_code"/>
                        <field name="gl_name"/>
                        <field name="acc_number"/>
                        <field name="sub_name"/>
                        <field name="opening"/>
                        <field name="receipt"/>
                        <field name="payment"/>
                        <field name="closing"/>
                        <field name="is_total" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="view_move_form_bank_subledger" model="ir.ui.view">
        <field name="name">account.move.form.bank.subledger</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_id']" position="before">
                <field name="vpk_bank_subledger_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/form//field[@name='account_id']" position="before">
                <field name="vpk_bank_subledger_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_bank_subledger" model="ir.ui.view">
        <field name="name">account.payment.form.bank.subledger</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="vpk_bank_subledger_id" readonly="state != 'draft'"/>
                <field name="vpk_bank_account_domain_ids" invisible="1"/>
                <field name="vpk_bank_gl_account_id"
                       readonly="state != 'draft'"
                       invisible="not vpk_bank_subledger_id"
                       domain="[('id', 'in', vpk_bank_account_domain_ids)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_bank_subledger_report" model="ir.actions.act_window">
        <field name="name">รายงานเงินฝากธนาคาร</field>
        <field name="res_model">vpk.bank.subledger.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
