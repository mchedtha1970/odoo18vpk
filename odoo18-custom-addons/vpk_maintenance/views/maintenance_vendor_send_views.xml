<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_vendor_send_list" model="ir.ui.view">
        <field name="name">maintenance.vendor.send.list</field>
        <field name="model">maintenance.vendor.send</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="send_date"/>
                <field name="team_id"/>
                <field name="equipment_name"/>
                <field name="asset_number" optional="show"/>
                <field name="vendor_name"/>
                <field name="request_id"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_vendor_send_form" model="ir.ui.view">
        <field name="name">maintenance.vendor.send.form</field>
        <field name="model">maintenance.vendor.send</field>
        <field name="arch" type="xml">
            <form string="คำร้องส่งเครื่องซ่อมบริษัท">
                <header>
                    <button
                        name="%(vpk_maintenance.action_report_maintenance_vendor_send)d"
                        type="action"
                        string="พิมพ์คำร้อง"
                        class="btn-primary"
                        invisible="not id"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="ข้อมูลเครื่อง">
                            <field name="team_id"/>
                            <field name="send_date"/>
                            <field name="request_id"/>
                            <field name="equipment_id"/>
                            <field name="equipment_name"/>
                            <field name="room"/>
                            <field name="equipment_model"/>
                            <field name="machine_number"/>
                            <field name="asset_number"/>
                            <field name="building"/>
                        </group>
                        <group string="ศูนย์บริการ / บริษัท">
                            <field name="vendor_id"/>
                            <field name="vendor_name"/>
                            <field name="vendor_address"/>
                            <field name="sign_date"/>
                            <field name="technician_id"/>
                            <field name="supervisor_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="symptom" placeholder="อาการเสีย"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_maintenance_vendor_send_search" model="ir.ui.view">
        <field name="name">maintenance.vendor.send.search</field>
        <field name="model">maintenance.vendor.send</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="equipment_name"/>
                <field name="asset_number"/>
                <field name="vendor_name"/>
                <field name="request_id"/>
                <field name="team_id"/>
            </search>
        </field>
    </record>

    <record id="action_maintenance_vendor_send" model="ir.actions.act_window">
        <field name="name">คำร้องส่งเครื่องซ่อมบริษัท</field>
        <field name="res_model">maintenance.vendor.send</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_maintenance_vendor_send"
        name="คำร้องส่งเครื่องซ่อมบริษัท"
        parent="maintenance.menu_maintenance_title"
        action="action_maintenance_vendor_send"
        sequence="8"
        groups="base.group_user,maintenance.group_equipment_manager"
    />
</odoo>
