<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maintenance_department_list" model="ir.ui.view">
        <field name="name">maintenance.department.list</field>
        <field name="model">maintenance.department</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_department_form" model="ir.ui.view">
        <field name="name">maintenance.department.form</field>
        <field name="model">maintenance.department</field>
        <field name="arch" type="xml">
            <form string="หน่วยงาน">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_maintenance_department" model="ir.actions.act_window">
        <field name="name">หน่วยงาน</field>
        <field name="res_model">maintenance.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_maintenance_department"
        name="หน่วยงาน"
        parent="maintenance.menu_maintenance_configuration"
        action="action_maintenance_department"
        sequence="45"
        groups="maintenance.group_equipment_manager"
    />

</odoo>
