<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_equipment_request_view_form_sub_state" model="ir.ui.view">
        <field name="name">maintenance.request.form.sub.state</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[field[@name='description']]" position="attributes">
                <attribute name="name">symptom_detail</attribute>
            </xpath>
            <xpath expr="//header/button[@name='archive_equipment_request']" position="before">
                <button
                    name="%(vpk_maintenance.action_report_maintenance_request_form)d"
                    type="action"
                    string="พิมพ์แบบส่งซ่อม"
                    class="btn-secondary"
                    invisible="not id"
                />
                <button
                    name="action_create_parts_issue"
                    type="object"
                    string="เบิกอะไหล่"
                    class="btn-primary"
                    invisible="archive"
                />
                <button
                    name="action_create_outsource_pr"
                    type="object"
                    string="เปิด PR"
                    class="btn-secondary"
                    invisible="archive or assessment_result_code not in ['outsource', 'repair_without_parts']"
                />
                <button
                    name="action_open_vendor_send"
                    type="object"
                    string="คำร้องส่งซ่อมบริษัท"
                    class="btn-secondary"
                    invisible="archive"
                />
                <button
                    name="action_open_asset_dispose"
                    type="object"
                    string="แทงจำหน่าย"
                    class="btn-danger"
                    invisible="archive or assessment_result_code != 'not_worth_dispose' or not asset_id"
                />
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button
                        name="action_view_parts_pickings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="parts_picking_count == 0"
                    >
                        <field name="parts_picking_count" widget="statinfo" string="ใบเบิกอะไหล่"/>
                    </button>
                    <button
                        name="action_view_purchase_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="purchase_request_count == 0"
                    >
                        <field name="purchase_request_count" widget="statinfo" string="PR"/>
                    </button>
                    <button
                        name="action_open_vendor_send"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="vendor_send_count == 0"
                    >
                        <field name="vendor_send_count" widget="statinfo" string="ส่งซ่อมบริษัท"/>
                    </button>
                    <button
                        name="action_view_linked_asset"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cube"
                        invisible="not asset_id"
                    >
                        <div class="o_stat_info">
                            <span class="o_stat_text">ทรัพย์สิน</span>
                            <span class="o_stat_text" invisible="sub_state != 'waiting_disposal'">รอจำหน่าย</span>
                        </div>
                    </button>
                </div>
                <field name="assessment_result_code" invisible="1"/>
                <field name="asset_id" invisible="1"/>
                <field name="asset_state" invisible="1"/>
                <label for="sub_state" string="สถานะการดำเนินการ" invisible="archive"/>
                <field
                    name="sub_state"
                    widget="statusbar"
                    options="{'clickable': '1'}"
                    invisible="archive"
                />
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="department_id"/>
            </xpath>
            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="asset_id" readonly="1" invisible="not asset_id"/>
                <field name="asset_state" readonly="1" invisible="not asset_id"/>
            </xpath>
            <xpath expr="//field[@name='maintenance_type']" position="after">
                <field
                    name="assessment_result_id"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field name="company_currency_id" invisible="1"/>
                <field name="parts_total_value" readonly="1"/>
            </xpath>
            <xpath expr="//notebook/page[field[@name='description']]" position="before">
                <page string="แจ้งซ่อม" name="repair_notice">
                    <group name="repair_notice_fields"/>
                </page>
            </xpath>
            <xpath expr="//page[@name='repair_notice']/group[@name='repair_notice_fields']" position="inside">
                <xpath expr="//sheet/group/group[1]" position="move"/>
            </xpath>
            <xpath expr="//page[@name='repair_notice']" position="after">
                <page string="หัวหน้าช่าง" name="chief_technician">
                    <group>
                        <group string="มอบหมายงาน" name="assign_work"/>
                        <group string="รับทราบ" name="acknowledge_work"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//group[@name='assign_work']" position="inside">
                <xpath expr="//sheet/group/group[field[@name='maintenance_team_id']]" position="move"/>
            </xpath>
            <xpath expr="//group[@name='assign_work']/group" position="inside">
                <field name="chief_signature" widget="signature" options="{'size': [180, 60]}"/>
                <widget
                    name="signature"
                    string="ลงชื่อ"
                    signature_field="chief_signature"
                    highlight="1"
                    invisible="not id"
                />
                <field name="chief_signed_on"/>
            </xpath>
            <xpath expr="//group[@name='acknowledge_work']" position="inside">
                <xpath expr="//field[@name='user_id']" position="move"/>
                <field name="assignee_signature" widget="signature" options="{'size': [180, 60]}"/>
                <widget
                    name="signature"
                    string="ลงชื่อ"
                    signature_field="assignee_signature"
                    full_name="user_id"
                    highlight="1"
                    invisible="not id"
                />
                <field name="assignee_signed_on"/>
            </xpath>
            <xpath expr="//page[@name='chief_technician']" position="after">
                <page string="การตรวจสอบเบื้องต้น" name="preliminary_inspection">
                    <group name="prelim_recommendation" invisible="1">
                        <field name="prelim_outsource"/>
                        <field name="prelim_outsource_reason"/>
                        <field name="prelim_purchase_parts"/>
                        <field name="prelim_material_volume"/>
                        <field name="prelim_material_number"/>
                        <field name="prelim_finish_days"/>
                        <field name="prelim_dispose"/>
                    </group>
                    <group>
                        <group string="ช่างผู้ปฏิบัติงาน">
                            <field name="technician_signature" widget="signature" options="{'size': [180, 60]}"/>
                            <widget name="signature" string="ลงชื่อ" signature_field="technician_signature" highlight="1" invisible="not id"/>
                            <field name="technician_signed_on"/>
                        </group>
                        <group string="ความคิดเห็นของหัวหน้าช่าง">
                            <field name="chief_comment" placeholder="ความคิดเห็นของหัวหน้าช่าง"/>
                            <field name="chief_comment_signature" widget="signature" options="{'size': [180, 60]}"/>
                            <widget name="signature" string="ลงชื่อ" signature_field="chief_comment_signature" highlight="1" invisible="not id"/>
                            <field name="chief_comment_signed_on"/>
                        </group>
                    </group>
                    <group>
                        <group string="ความคิดเห็นของรองผู้อำนวยการฝ่ายบริหาร">
                            <field name="deputy_approved"/>
                            <field name="deputy_acknowledged"/>
                            <field name="deputy_comment" placeholder="ความคิดเห็น"/>
                            <field name="deputy_signature" widget="signature" options="{'size': [180, 60]}"/>
                            <widget name="signature" string="ลงชื่อ" signature_field="deputy_signature" highlight="1" invisible="not id"/>
                            <field name="deputy_signed_on"/>
                        </group>
                        <group string="ความคิดเห็นของผู้อำนวยการ">
                            <field name="director_comment" placeholder="ความคิดเห็นของผู้อำนวยการ"/>
                            <field name="director_signature" widget="signature" options="{'size': [180, 60]}"/>
                            <widget name="signature" string="ลงชื่อ" signature_field="director_signature" highlight="1" invisible="not id"/>
                            <field name="director_signed_on"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='preliminary_inspection']/group[1]" position="before">
                <group name="prelim_assessment"/>
            </xpath>
            <xpath expr="//group[@name='prelim_assessment']" position="inside">
                <xpath expr="//field[@name='maintenance_type']" position="move"/>
                <xpath expr="//field[@name='assessment_result_id']" position="move"/>
                <field name="prelim_initial_check" string="ประเมินเบื้องต้น"/>
                <field name="prelim_check_reason" placeholder="เนื่องจาก"/>
                <xpath expr="//field[@name='company_currency_id']" position="move"/>
                <xpath expr="//field[@name='parts_total_value']" position="move"/>
            </xpath>
            <xpath expr="//page[@name='preliminary_inspection']" position="after">
                <page string="ผลการดำเนินงาน/ข้อเสนอแนะ" name="work_result">
                    <group>
                        <group string="ผลการดำเนินงาน">
                            <div colspan="2" class="o_row">
                                <span>ช่างผู้ปฏิบัติงานได้เบิกวัสดุช่าง ตามใบเบิก เล่มที่</span>
                                <field name="result_issue_volume" nolabel="1"/>
                                <span>เลขที่</span>
                                <field name="result_issue_number" nolabel="1"/>
                            </div>
                            <field name="issuer_signature" widget="signature" options="{'size': [180, 60]}"/>
                            <widget name="signature" string="ลงชื่อ" signature_field="issuer_signature" highlight="1" invisible="not id"/>
                            <field name="issuer_signed_on"/>
                            <separator string="และได้ดำเนินการซ่อม / จัดทำ พัสดุดังกล่าวเสร็จเรียบร้อยแล้ว"/>
                            <field name="repair_detail" placeholder="รายละเอียดการซ่อม / ข้อเสนอแนะ"/>
                            <field name="repair_done_signature" widget="signature" options="{'size': [180, 60]}"/>
                            <widget name="signature" string="ลงชื่อ" signature_field="repair_done_signature" highlight="1" invisible="not id"/>
                            <field name="repair_done_signed_on"/>
                        </group>
                        <group string="การรับพัสดุ">
                            <div colspan="2">
                                หน่วยงานได้รับพัสดุที่แจ้งซ่อม ถูกต้อง ครบถ้วนแล้ว โดยมีวัสดุที่ใช้ในการดำเนินการดังนี้
                            </div>
                            <field name="used_material_line_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <field name="satisfaction" widget="radio"/>
                            <field name="service_speed" widget="radio"/>
                            <field name="other_feedback" placeholder="ข้อเสนอแนะ / ข้อร้องเรียนอื่นๆ (ถ้ามี)"/>
                            <field name="dept_head_signature" widget="signature" options="{'size': [180, 60]}"/>
                            <widget name="signature" string="ลงชื่อ" signature_field="dept_head_signature" highlight="1" invisible="not id"/>
                            <field name="dept_head_signed_on"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='work_result']" position="after">
                <page string="สรุปค่าใช้จ่าย" name="cost_summary">
                    <field name="cost_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="technician_id"/>
                            <field name="material_cost" sum="รวมค่าวัสดุ"/>
                            <field name="labor_cost" sum="รวมค่าแรง"/>
                            <field name="duration_minutes" sum="รวมเวลา"/>
                            <field name="total_amount" sum="รวมเงินทั้งสิ้น"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='request_date']" position="after">
                <xpath expr="//field[@name='description']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="string">รายละเอียด/อาการชำรุด</attribute>
            </xpath>
            <xpath expr="//page[@name='repair_notice']" position="inside">
                <group name="notice_layout">
                    <group string="การส่งซ่อม" name="notice_body"/>
                    <group name="notice_receipt"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='notice_body']" position="inside">
                <div colspan="2"><strong>เรียน</strong> หัวหน้างานช่างซ่อมบำรุง</div>
                <xpath expr="//field[@name='request_date']" position="move"/>
                <xpath expr="//field[@name='employee_id']" position="move"/>
                <xpath expr="//field[@name='department_id']" position="move"/>
                <field name="requester_phone" placeholder="เบอร์โทร"/>
                <div colspan="2">มีความประสงค์ให้ช่างซ่อมวัสดุ ครุภัณฑ์ ดังนี้</div>
                <xpath expr="//field[@name='equipment_id']" position="move"/>
                <xpath expr="//group[@name='repair_notice_fields']//field[@name='category_id']" position="move"/>
                <field name="request_qty"/>
                <xpath expr="//field[@name='description']" position="move"/>
                <xpath expr="//group[@name='repair_notice_fields']//field[@name='asset_id']" position="move"/>
                <xpath expr="//group[@name='repair_notice_fields']//field[@name='asset_state']" position="move"/>
                <field name="machine_number"/>
            </xpath>
            <xpath expr="//group[@name='notice_receipt']" position="inside">
                <field name="receipt_number" readonly="1"/>
                <field name="receipt_date"/>
                <field name="receipt_time" widget="float_time"/>
            </xpath>
            <xpath expr="//field[@name='request_date']" position="attributes">
                <attribute name="string">วันที่</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="string">ผู้แจ้ง</attribute>
            </xpath>
            <xpath expr="//field[@name='equipment_id']" position="attributes">
                <attribute name="string">รายการ</attribute>
            </xpath>
            <xpath expr="//group[@name='notice_body']//field[@name='asset_id']" position="attributes">
                <attribute name="string">หมายเลขครุภัณฑ์</attribute>
            </xpath>
            <xpath expr="//page[@name='repair_notice']/group[@name='repair_notice_fields']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='description']" position="after">
                <field name="signature" widget="signature" options="{'size': [180, 60]}"/>
                <widget
                    name="signature"
                    string="ลงชื่อ"
                    signature_field="signature"
                    full_name="employee_id"
                    highlight="1"
                    invisible="not id"
                />
            </xpath>
            <xpath expr="//field[@name='signature']" position="attributes">
                <attribute name="string">ลายเซ็นหัวหน้าฝ่าย / งาน / ตึก หรือผู้แทน</attribute>
            </xpath>
            <xpath expr="//group[@name='notice_body']" position="inside">
                <xpath expr="//field[@name='signature']" position="move"/>
                <xpath expr="//widget[@signature_field='signature']" position="move"/>
                <div colspan="2" class="text-muted">หมายเหตุ : 1 ใบงาน ต่อ 1 รายการเท่านั้น</div>
            </xpath>
            <xpath expr="//page[@name='symptom_detail']" position="replace"/>
            <xpath expr="//notebook" position="inside">
                <page string="อะไหล่ที่เบิก" name="parts_issued">
                    <field name="parts_move_ids" readonly="1">
                        <list>
                            <field name="picking_id" string="ใบเบิก"/>
                            <field name="product_id" string="อะไหล่"/>
                            <field name="parts_qty" string="จำนวน" sum="รวมจำนวน"/>
                            <field name="product_uom" string="หน่วย" optional="show"/>
                            <field name="parts_unit_cost" string="ต้นทุน/หน่วย"/>
                            <field name="parts_value" string="มูลค่า" sum="รวมมูลค่า"/>
                            <field name="state" string="สถานะ" widget="badge"
                                     decoration-success="state == 'done'"
                                     decoration-info="state == 'assigned'"
                                     decoration-warning="state in ('confirmed', 'waiting', 'partially_available')"
                                     decoration-muted="state == 'draft'"
                                     decoration-danger="state == 'cancel'"/>
                            <field name="date" string="วันที่" optional="hide"/>
                            <field name="company_currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group>
                        <group/>
                        <group>
                            <field name="parts_total_value" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_request_view_tree_sub_state" model="ir.ui.view">
        <field name="name">maintenance.request.list.sub.state</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="sub_state" optional="show"/>
                <field name="assessment_result_id" optional="show"/>
                <field name="parts_total_value" optional="show" sum="มูลค่ารวมอะไหล่"/>
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_request_view_kanban_sub_state" model="ir.ui.view">
        <field name="name">maintenance.request.kanban.sub.state</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates//field[@name='name']" position="after">
                <field name="sub_state" class="text-muted"/>
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_request_view_search_sub_state" model="ir.ui.view">
        <field name="name">maintenance.request.search.sub.state</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="sub_state"/>
                <field name="assessment_result_id"/>
            </xpath>
            <xpath expr="//filter[@name='high_priority']" position="after">
                <separator/>
                <filter string="รอประเมิน" name="sub_waiting_assessment" domain="[('sub_state', '=', 'waiting_assessment')]"/>
                <filter string="ประเมินแล้ว" name="sub_assessed" domain="[('sub_state', '=', 'assessed')]"/>
                <filter string="กำลังซ่อม" name="sub_repairing" domain="[('sub_state', '=', 'repairing')]"/>
                <filter string="รออะไหล่" name="sub_waiting_parts" domain="[('sub_state', '=', 'waiting_parts')]"/>
                <filter string="รอจำหน่าย" name="sub_waiting_disposal" domain="[('sub_state', '=', 'waiting_disposal')]"/>
                <filter string="ซ่อมเสร็จสิ้น" name="sub_repaired" domain="[('sub_state', '=', 'repaired')]"/>
            </xpath>
            <xpath expr="//filter[@name='stages']" position="after">
                <filter string="สถานะการดำเนินการ" name="group_sub_state" domain="[]" context="{'group_by': 'sub_state'}"/>
                <filter string="ผลการประเมิน" name="group_assessment_result" domain="[]" context="{'group_by': 'assessment_result_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
