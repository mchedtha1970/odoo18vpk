<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maintenance_assessment_result_list" model="ir.ui.view">
        <field name="name">maintenance.assessment.result.list</field>
        <field name="model">maintenance.assessment.result</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_assessment_result_form" model="ir.ui.view">
        <field name="name">maintenance.assessment.result.form</field>
        <field name="model">maintenance.assessment.result</field>
        <field name="arch" type="xml">
            <form string="ผลการประเมิน">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_maintenance_assessment_result" model="ir.actions.act_window">
        <field name="name">ผลการประเมิน</field>
        <field name="res_model">maintenance.assessment.result</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_maintenance_assessment_result"
        name="ผลการประเมิน"
        parent="maintenance.menu_maintenance_configuration"
        action="action_maintenance_assessment_result"
        sequence="50"
        groups="maintenance.group_equipment_manager"
    />

</odoo>
