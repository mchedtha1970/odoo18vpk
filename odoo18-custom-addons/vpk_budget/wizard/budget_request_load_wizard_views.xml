<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vpk_budget_request_load_wizard" model="ir.ui.view">
        <field name="name">vpk.budget.request.load.wizard.form</field>
        <field name="model">vpk.budget.request.load.wizard</field>
        <field name="arch" type="xml">
            <form string="โหลดรายการ">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="target" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="form_section_key" invisible="1"/>
                    <field
                        name="budget_post_ids"
                        widget="many2many_tags"
                        options="{'no_create': True, 'no_open': True}"
                        placeholder="เลือกหมวดงบประมาณ"
                    />
                </group>
                <p class="text-muted">
                    เลือกได้มากกว่า 1 หมวด ระบบจะดึงรายการของทุกหมวดที่เลือก และข้ามรายการที่มีอยู่แล้ว
                </p>
                <footer>
                    <button
                        name="action_load"
                        type="object"
                        string="โหลด"
                        class="btn-primary"
                    />
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
