<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vpk_budget" model="ir.module.category">
        <field name="name">VPK Budget</field>
        <field name="description">Manage VPK budget master data and configuration.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_budget_request_department_user" model="res.groups">
        <field name="name">Budget Request - Department</field>
        <field name="category_id" ref="module_category_vpk_budget"/>
    </record>

    <record id="group_budget_request_budget_unit" model="res.groups">
        <field name="name">Budget Request - Budget Unit</field>
        <field name="category_id" ref="module_category_vpk_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_budget_request_department_user'))]"/>
    </record>

    <record id="group_vpk_budget_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_vpk_budget"/>
        <field name="implied_ids" eval="[
            (4, ref('account.group_account_readonly')),
            (4, ref('group_budget_request_department_user')),
        ]"/>
    </record>

    <record id="group_vpk_budget_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_vpk_budget"/>
        <field name="implied_ids" eval="[
            (4, ref('group_vpk_budget_user')),
            (4, ref('account.group_account_user')),
            (4, ref('analytic.group_analytic_accounting')),
            (4, ref('group_budget_request_budget_unit')),
        ]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
