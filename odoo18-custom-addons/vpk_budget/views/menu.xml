    <record id="action_vpk_budget_dashboard" model="ir.actions.client">
        <field name="name">สถานะคำของบประมาณ</field>
        <field name="tag">vpk_budget_dashboard</field>
    </record>

    <menuitem
        id="menu_vpk_budget_dashboard"
        name="Dashboard งบประมาณ"
        parent="menu_vpk_budget_root"
        sequence="5"
        groups="group_vpk_budget_user"
    />

    <record id="menu_vpk_budget_dashboard" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <menuitem
        id="menu_vpk_budget_dashboard_status"
        name="สถานะคำของบประมาณ"
        parent="menu_vpk_budget_dashboard"
        action="action_vpk_budget_dashboard"
        sequence="10"
        groups="group_vpk_budget_user"
    />

    <record id="action_vpk_budget_overview_dashboard" model="ir.actions.client">
