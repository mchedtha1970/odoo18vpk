        <field name="model_id" ref="model_departmental_budget_request"/>
        <field name="state">code</field>
        <field name="code">action = model.action_create_demo_budget_request_all_groups()</field>
    </record>

    <menuitem
        id="menu_create_demo_budget_request_all_groups"
        name="สร้างคำของบตัวอย่าง (ครบทุกกลุ่ม)"
        parent="menu_vpk_budget_configuration"
        action="action_create_demo_budget_request_all_groups"
        sequence="90"
        groups="group_vpk_budget_manager"
    />
</odoo>
