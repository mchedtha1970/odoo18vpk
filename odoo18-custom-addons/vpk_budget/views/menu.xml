        parent="menu_vpk_budget_dashboard"
        action="action_vpk_budget_overview_dashboard"
        sequence="5"
        groups="group_vpk_budget_user"
    />

    <record id="action_vpk_budget_department_dashboard" model="ir.actions.client">
        <field name="name">บริการงบประมาณรายแผนก</field>
        <field name="tag">vpk_budget_department_dashboard</field>
    </record>

