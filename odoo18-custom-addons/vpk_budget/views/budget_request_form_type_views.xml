<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vpk_budget_request_form_type_list" model="ir.ui.view">
        <field name="name">vpk.budget.request.form.type.list</field>
        <field name="model">vpk.budget.request.form.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="allowed_line_type_codes" string="Line Types"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_vpk_budget_request_form_type_form" model="ir.ui.view">
        <field name="name">vpk.budget.request.form.type.form</field>
        <field name="model">vpk.budget.request.form.type</field>
        <field name="arch" type="xml">
            <form string="แบบฟอร์มคำของบ">
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="ชื่อแบบฟอร์มคำของบ"/>
                        <h1>
                            <field name="name" nolabel="1" placeholder="e.g. ครุภัณฑ์การแพทย์/ไม่ใช่การแพทย์"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. supplies, asset, construction, project"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <div class="text-muted mb-3">
                        กำหนด Line Type ที่ต้องการแสดงในคำของบประมาณ
                        — แบบตั้งงบพัสดุ / ครุภัณฑ์ / ก่อสร้าง / โครงการ
                    </div>
                    <field name="line_type_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="budget_type_id"/>
                            <field name="line_type" column_invisible="1"/>
                            <field name="name" optional="show"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vpk_budget_request_form_type_search" model="ir.ui.view">
        <field name="name">vpk.budget.request.form.type.search</field>
        <field name="model">vpk.budget.request.form.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_vpk_budget_request_form_type" model="ir.actions.act_window">
        <field name="name">แบบฟอร์มคำของบ</field>
        <field name="res_model">vpk.budget.request.form.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vpk_budget_request_form_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                สร้างแบบฟอร์มคำของบใหม่
            </p>
            <p>
                กำหนดแบบฟอร์มคำของบที่ผู้ใช้เลือกได้เมื่อสร้างคำของบประมาณ
                แต่ละประเภทจะแสดงแบบฟอร์มรายการที่แตกต่างกัน
            </p>
        </field>
    </record>
</odoo>
