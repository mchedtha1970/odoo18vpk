<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vpk_budget_group_list" model="ir.ui.view">
        <field name="name">vpk.budget.group.list</field>
        <field name="model">vpk.budget.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_vpk_budget_group_form" model="ir.ui.view">
        <field name="name">vpk.budget.group.form</field>
        <field name="model">vpk.budget.group</field>
        <field name="arch" type="xml">
            <form string="กลุ่มงบประมาณ">
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="ชื่อกลุ่ม"/>
                        <h1>
                            <field name="name" nolabel="1" placeholder="e.g. วัสดุทั่วไป"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="ประเภทวัสดุย่อย" name="material_sub_types">
                            <field name="material_sub_type_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="รายละเอียด" name="description">
                            <field name="description" nolabel="1" placeholder="รายละเอียดเพิ่มเติม..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vpk_budget_group_search" model="ir.ui.view">
        <field name="name">vpk.budget.group.search</field>
        <field name="model">vpk.budget.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_vpk_budget_group" model="ir.actions.act_window">
        <field name="name">กลุ่มงบประมาณ</field>
        <field name="res_model">vpk.budget.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vpk_budget_group_search"/>
    </record>
</odoo>
