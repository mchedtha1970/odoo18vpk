<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Budget fields on Vendor Bill form (header) -->
    <record id="view_move_form_budget" model="ir.ui.view">
        <field name="name">account.move.form.budget</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field
                    name="budget_analytic_account_id"
                    options="{'no_create': True}"
                    invisible="move_type not in ('in_invoice', 'in_refund')"
                    readonly="state != 'draft'"
                />
                <field
                    name="budget_fund_source_id"
                    options="{'no_create': True}"
                    invisible="move_type not in ('in_invoice', 'in_refund')"
                    readonly="state != 'draft'"
                />
            </xpath>
            <!-- Budget fields on invoice line list -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="after">
                <field name="budget_post_id" optional="hide" string="หมวดงบ"/>
                <field name="budget_line_id" optional="hide" string="รายการงบ"/>
            </xpath>
        </field>
    </record>
</odoo>
