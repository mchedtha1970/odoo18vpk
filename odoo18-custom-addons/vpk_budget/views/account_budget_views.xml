<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Primary form view (priority 1) for budget.lines -->
    <record id="view_budget_line_form_vpk" model="ir.ui.view">
        <field name="name">budget.line.form.vpk</field>
        <field name="model">budget.lines</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="รายการงบประมาณ" class="o_vpk_budget_form">
                <sheet>
                    <div class="oe_title">
                        <label for="general_budget_id" string="รายการงบประมาณ"/>
                        <h1>
                            <field name="general_budget_id" nolabel="1" options="{'no_open': True}"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="ข้อมูล" name="main">
                            <group>
                                <group>
                                    <field name="budget_id"/>
                                    <field name="analytic_account_id"/>
                                    <field name="fund_source_id"/>
                                    <field name="budget_group_id"/>
                                    <field name="request_id" readonly="1"/>
                                    <field name="request_line_id" readonly="1"/>
                                    <field name="planned_amount"/>
                                </group>
                                <group>
                                    <label for="date_from" string="ช่วงเวลา"/>
                                    <div>
                                        <field name="date_from" class="oe_inline"/>
                                        -
                                        <field name="date_to" class="oe_inline" nolabel="1"/>
                                    </div>
                                    <field name="paid_date" groups="base.group_no_one"/>
                                    <field
                                        name="company_id"
                                        options="{'no_create': True}"
                                        groups="base.group_multi_company"
                                    />
                                </group>
                            </group>
                        </page>
                        <page string="ผลการใช้งบ" name="results" invisible="not id">
                            <group>
                                <group>
                                    <field name="practical_amount" readonly="1"/>
                                    <field name="pr_reserved_amount" readonly="1"/>
                                    <field name="po_committed_amount" readonly="1"/>
                                    <field name="pr_available_amount" readonly="1"/>
                                </group>
                                <group>
                                    <field name="theoretical_amount" readonly="1"/>
                                    <field name="percentage" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Primary form view for budget.budget -->
    <record id="view_budget_budget_form_vpk" model="ir.ui.view">
        <field name="name">budget.budget.form.vpk</field>
        <field name="model">budget.budget</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="งบประมาณ" class="o_vpk_budget_form">
                <header>
                    <button string="Confirm" name="action_budget_confirm"
                            invisible="state != 'draft'" type="object"
                            class="oe_highlight"/>
                    <button string="Approve" name="action_budget_validate"
                            invisible="state != 'confirm'" type="object"
                            class="oe_highlight"/>
                    <button string="Done" name="action_budget_done"
                            invisible="state != 'validate'" type="object"
                            class="oe_highlight"/>
                    <button string="Reset to Draft" name="action_budget_draft"
                            invisible="state != 'cancel'" type="object"/>
                    <button string="Cancel Budget" name="action_budget_cancel"
                            invisible="state not in ('confirm','validate')"
                            type="object"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirm"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="ชื่องบประมาณ"/>
                        <h1>
                            <field
                                name="name"
                                nolabel="1"
                                readonly="state != 'draft'"
                                placeholder="เช่น งบประมาณปี 2569"
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="creating_user_id"
                                string="ผู้รับผิดชอบ"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group>
                            <label for="date_from" string="ช่วงเวลา"/>
                            <div>
                                <field
                                    name="date_from"
                                    placeholder="จาก"
                                    class="oe_inline"
                                    readonly="state != 'draft'"
                                />
                                -
                                <field
                                    name="date_to"
                                    placeholder="ถึง"
                                    class="oe_inline"
                                    readonly="state != 'draft'"
                                    nolabel="1"
                                />
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="รายการงบประมาณ" name="budget_lines">
                            <field
                                name="budget_line"
                                context="{'default_date_from': date_from, 'default_date_to': date_to}"
                                nolabel="1"
                                readonly="state != 'draft'"
                            >
                                <list string="รายการงบประมาณ" editable="bottom">
                                    <field name="general_budget_id"/>
                                    <field
                                        name="analytic_account_id"
                                        groups="analytic.group_analytic_accounting"
                                        required="1"
                                    />
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="paid_date" groups="base.group_no_one"/>
                                    <field name="fund_source_id"/>
                                    <field name="budget_group_id"/>
                                    <field name="planned_amount" sum="Planned Amount"/>
                                    <field name="practical_amount" sum="Practical Amount"/>
                                    <field name="pr_reserved_amount" sum="งบ PR ที่จอง"/>
                                    <field name="po_committed_amount" sum="งบ PO ที่ผูกพัน"/>
                                    <field name="pr_available_amount" sum="งบคงเหลือหลังจอง/ผูกพัน"/>
                                    <field name="theoretical_amount" sum="Theoretical Amount"/>
                                    <field name="percentage"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Primary form view for account.budget.post -->
    <record id="view_budget_post_form_vpk" model="ir.ui.view">
        <field name="name">account.budget.post.form.vpk</field>
        <field name="model">account.budget.post</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="หมวดงบประมาณ" class="o_vpk_budget_form">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="ชื่อหมวดงบประมาณ"/>
                        <h1>
                            <field name="name" nolabel="1" placeholder="เช่น ค่าใช้จ่ายในการดำเนินงาน"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_code" readonly="1"/>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="บัญชี" name="accounts">
                            <field name="account_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_post_tree_vpk" model="ir.ui.view">
        <field name="name">account.budget.post.list.vpk</field>
        <field name="model">account.budget.post</field>
        <field name="inherit_id" ref="base_account_budget.view_budget_post_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="account_code"/>
            </field>
        </field>
    </record>

    <record id="view_budget_post_search_vpk" model="ir.ui.view">
        <field name="name">account.budget.post.search.vpk</field>
        <field name="model">account.budget.post</field>
        <field name="inherit_id" ref="base_account_budget.view_budget_post_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="account_code"/>
            </field>
        </field>
    </record>

    <!-- Override actions to use Thai labels -->
    <record id="base_account_budget.act_budget_view" model="ir.actions.act_window">
        <field name="name">งบประมาณ</field>
    </record>

    <record id="base_account_budget.act_budget_lines_view" model="ir.actions.act_window">
        <field name="name">รายการงบประมาณ</field>
    </record>

    <record id="base_account_budget.open_budget_post_form" model="ir.actions.act_window">
        <field name="name">หมวดงบประมาณ</field>
    </record>

    <record id="view_budget_line_tree_vpk_reservation" model="ir.ui.view">
        <field name="name">budget.line.list.vpk.reservation</field>
        <field name="model">budget.lines</field>
        <field name="inherit_id" ref="base_account_budget.view_budget_line_tree"/>
        <field name="arch" type="xml">
            <field name="analytic_account_id" position="after">
                <field name="fund_source_id"/>
                <field name="budget_group_id"/>
            </field>
            <field name="practical_amount" position="after">
                <field name="pr_reserved_amount" sum="งบ PR ที่จอง"/>
                <field name="po_committed_amount" sum="งบ PO ที่ผูกพัน"/>
                <field name="pr_available_amount" sum="งบคงเหลือหลังจอง/ผูกพัน"/>
            </field>
        </field>
    </record>

    <record id="view_budget_line_form_vpk_reservation" model="ir.ui.view">
        <field name="name">budget.line.form.vpk.reservation</field>
        <field name="model">budget.lines</field>
        <field name="inherit_id" ref="base_account_budget.view_budget_line_form"/>
        <field name="arch" type="xml">
            <field name="analytic_account_id" position="after">
                <field name="fund_source_id"/>
                <field name="budget_group_id"/>
                <field name="request_id" readonly="1"/>
                <field name="request_line_id" readonly="1"/>
            </field>
            <field name="practical_amount" position="after">
                <field name="pr_reserved_amount" readonly="1"/>
                <field name="po_committed_amount" readonly="1"/>
                <field name="pr_available_amount" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
