<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_count_sheet_import" model="ir.ui.view">
        <field name="name">stock.quant.count.sheet.import.form</field>
        <field name="model">stock.quant.count.sheet.import</field>
        <field name="arch" type="xml">
            <form string="นำเข้าใบนับ">
                <group invisible="line_ids">
                    <field name="data" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <group invisible="not line_ids">
                    <field name="skipped_blank" invisible="not skipped_blank"/>
                </group>
                <field name="line_ids" invisible="not line_ids" readonly="1">
                    <list decoration-danger="difference &lt; 0" decoration-success="difference &gt; 0" create="0" delete="0" edit="0">
                        <field name="location_name"/>
                        <field name="product_name"/>
                        <field name="lot_name"/>
                        <field name="on_hand"/>
                        <field name="counted_qty"/>
                        <field name="difference"/>
                    </list>
                </field>
                <footer>
                    <button name="action_read" type="object" string="อ่านไฟล์" class="btn-primary" invisible="line_ids"/>
                    <button name="action_load_counts" type="object" string="ใส่จำนวนที่นับ" class="btn-primary" invisible="not line_ids"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
