<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security group: Narcotic / High-Alert location access -->
    <record id="group_narcotic_location" model="res.groups">
        <field name="name">Narcotic / High-Alert Location Access</field>
        <field name="comment">สิทธิ์เข้าถึงตำแหน่งยาเสพติดให้โทษและยากลุ่มเสี่ยง — เฉพาะเภสัชกรหรือผู้ได้รับอนุมัติ</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
    </record>

    <!-- Record rule: users WITHOUT narcotic group cannot see stock in narcotic locations -->
    <record id="rule_stock_quant_narcotic_restrict" model="ir.rule">
        <field name="name">Narcotic Location: hide stock quant for non-pharmacist</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="domain_force">[
            '|',
            ('location_id.barcode', 'not like', 'WH02-NARC'),
            ('location_id.barcode', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Record rule: users WITH narcotic group can see ALL stock (including narcotic) -->
    <record id="rule_stock_quant_narcotic_allow" model="ir.rule">
        <field name="name">Narcotic Location: full access for pharmacist</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_narcotic_location'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Record rule: restrict stock.move.line for narcotic locations -->
    <record id="rule_stock_move_line_narcotic_restrict" model="ir.rule">
        <field name="name">Narcotic Location: hide move lines for non-pharmacist</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="domain_force">[
            '|',
            '&amp;',
            ('location_id.barcode', 'not like', 'WH02-NARC'),
            ('location_dest_id.barcode', 'not like', 'WH02-NARC'),
            '|',
            ('location_id.barcode', '=', False),
            ('location_dest_id.barcode', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Record rule: users WITH narcotic group can see ALL move lines -->
    <record id="rule_stock_move_line_narcotic_allow" model="ir.rule">
        <field name="name">Narcotic Location: full move line access for pharmacist</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_narcotic_location'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
