<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_specification_form" model="ir.ui.view">
        <field name="name">purchase.product.specification.form</field>
        <field name="model">purchase.product.specification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_from_pr" string="Auto Generate จากใบขอซื้อ"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" string="ยืนยัน" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print" string="พิมพ์เอกสาร" type="object"
                            invisible="state == 'cancelled'"/>
                    <button name="action_draft" string="กลับเป็นร่าง" type="object"
                            invisible="state not in ('confirmed', 'cancelled')"/>
                    <button name="action_cancel" string="ยกเลิก" type="object"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="request_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="auto_generated" readonly="1"/>
                            <field name="line_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="รายการคุณลักษณะพัสดุ" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="uom_id"/>
                                    <field name="estimated_cost" optional="show" sum="รวม"/>
                                    <field name="specifications" optional="show"/>
                                    <field name="attachment_count" string="ไฟล์แนบ"/>
                                    <button name="action_open_line_form" type="object"
                                            string="ดู/แนบไฟล์" icon="fa-paperclip"
                                            title="เปิดดูรูปสแกนและเอกสารแนบ"/>
                                    <button name="action_open_spec_attachments" type="object"
                                            icon="fa-download"
                                            title="เปิด/ดาวน์โหลดไฟล์"
                                            invisible="attachment_count == 0"/>
                                    <field name="request_line_id" optional="hide"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="name"/>
                                            <field name="product_qty"/>
                                            <field name="uom_id"/>
                                            <field name="estimated_cost"/>
                                        </group>
                                        <group>
                                            <field name="request_line_id"/>
                                            <field name="attachment_count" readonly="1"/>
                                            <button name="action_open_spec_attachments" type="object"
                                                    string="เปิดไฟล์แนบทั้งหมด" class="btn-primary"
                                                    invisible="attachment_count == 0"/>
                                        </group>
                                    </group>
                                    <group string="รายละเอียดคุณลักษณะ">
                                        <field name="specifications" nolabel="1" colspan="2"/>
                                    </group>
                                    <group string="รูปสแกนคุณลักษณะ">
                                        <field name="spec_scan_filename" invisible="1"/>
                                        <field name="spec_scan_image" widget="image"
                                               filename="spec_scan_filename"/>
                                    </group>
                                    <group string="เอกสารแนบ (คลิกชื่อไฟล์เพื่อเปิด)">
                                        <field name="spec_attachment_ids" widget="many2many_binary"
                                               nolabel="1" colspan="2"/>
                                    </group>
                                </form>
                            </field>
                            <p class="text-muted">
                                กดปุ่ม <strong>ดู/แนบไฟล์</strong> หรือไอคอนดาวน์โหลดในแต่ละรายการเพื่อเปิดดูเอกสาร/รูปสแกน
                            </p>
                        </page>
                        <page string="หมายเหตุ" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_product_specification_list" model="ir.ui.view">
        <field name="name">purchase.product.specification.list</field>
        <field name="model">purchase.product.specification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="request_id"/>
                <field name="contract_id"/>
                <field name="partner_id" optional="show"/>
                <field name="line_count"/>
                <field name="auto_generated" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_product_specification_search" model="ir.ui.view">
        <field name="name">purchase.product.specification.search</field>
        <field name="model">purchase.product.specification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="request_id"/>
                <field name="contract_id"/>
                <filter name="draft" string="ร่าง" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="ยืนยัน" domain="[('state', '=', 'confirmed')]"/>
                <filter name="auto" string="Auto Generate" domain="[('auto_generated', '=', True)]"/>
                <group>
                    <filter name="group_contract" string="สัญญา" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_pr" string="ใบขอซื้อ" context="{'group_by': 'request_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_specification" model="ir.actions.act_window">
        <field name="name">รายละเอียดคุณลักษณะพัสดุ</field>
        <field name="res_model">purchase.product.specification</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_spec_attachment_viewer_form" model="ir.ui.view">
        <field name="name">purchase.spec.attachment.viewer.form</field>
        <field name="model">purchase.spec.attachment.viewer</field>
        <field name="arch" type="xml">
            <form string="Viewer ไฟล์คุณลักษณะ">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="attachment_id" readonly="1"/>
                    </group>
                    <group string="เลือกไฟล์">
                        <field name="line_ids" nolabel="1">
                            <list create="0" delete="0">
                                <field name="name"/>
                                <field name="mimetype"/>
                                <button name="action_preview" type="object"
                                        string="ดูไฟล์" icon="fa-eye"
                                        class="btn-primary"/>
                            </list>
                        </field>
                    </group>
                    <group string="แสดงตัวอย่างบนหน้าจอ">
                        <field name="preview_html" widget="html" nolabel="1"
                               readonly="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_download" type="object"
                            string="ดาวน์โหลดไฟล์นี้" icon="fa-download"
                            class="btn-secondary"/>
                    <button string="ปิด" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
