<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_product_spec" model="ir.ui.view">
        <field name="name">purchase.request.form.product.specification</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_product_specifications" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not contract_id">
                    <field name="product_specification_count" widget="statinfo"
                           string="คุณลักษณะพัสดุ"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_product_specification" type="object"
                        string="ออกคุณลักษณะพัสดุ (Auto)"
                        class="btn-secondary"
                        invisible="not contract_id"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list" position="inside">
                <field name="spec_attachment_count" string="ไฟล์คุณลักษณะ" optional="show"/>
                <button name="action_open_spec_line_form" type="object"
                        string="ดู/แนบไฟล์" icon="fa-paperclip"
                        title="เปิดดูเอกสารและรูปสแกนคุณลักษณะของรายการนี้"/>
                <button name="action_open_spec_attachments" type="object"
                        icon="fa-download"
                        title="เปิด/ดาวน์โหลดไฟล์แนบ"
                        invisible="spec_attachment_count == 0"/>
            </xpath>
        </field>
    </record>

    <!-- ฟอร์ม popup หลักสำหรับดู/แนบไฟล์ -->
    <record id="view_purchase_request_line_spec_popup" model="ir.ui.view">
        <field name="name">purchase.request.line.spec.popup</field>
        <field name="model">purchase.request.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="คุณลักษณะ / ไฟล์แนบ">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                        </group>
                        <group>
                            <field name="spec_attachment_count" readonly="1"/>
                            <button name="action_open_spec_attachments" type="object"
                                    string="เปิดไฟล์แนบทั้งหมด" class="btn-primary"
                                    invisible="spec_attachment_count == 0"/>
                        </group>
                    </group>
                    <group string="รายละเอียดคุณลักษณะ (ข้อความ)">
                        <field name="specifications" nolabel="1" colspan="2"/>
                    </group>
                    <group string="รูปสแกนคุณลักษณะ">
                        <field name="spec_scan_filename" invisible="1"/>
                        <field name="spec_scan_image" widget="image"
                               filename="spec_scan_filename"
                               options="{'size': [400, 300]}"/>
                    </group>
                    <group string="เอกสารแนบ (คลิกชื่อไฟล์เพื่อเปิด/ดาวน์โหลด)">
                        <field name="spec_attachment_ids" widget="many2many_binary"
                               nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button string="ปิด" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- แสดงในฟอร์มรายละเอียดเมื่อกดไอคอน list บนบรรทัด PR -->
    <record id="view_purchase_request_line_details_spec_attach" model="ir.ui.view">
        <field name="name">purchase.request.line.details.spec.attachments</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_line_details"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='specifications']" position="after">
                <group string="เอกสาร/รูปสแกนคุณลักษณะ (แยกรายการ)">
                    <div class="o_row" colspan="2">
                        <button name="action_open_spec_attachments" type="object"
                                string="เปิดไฟล์แนบ" class="btn-primary"
                                invisible="spec_attachment_count == 0"/>
                        <field name="spec_attachment_count" readonly="1"/>
                    </div>
                    <field name="spec_scan_filename" invisible="1"/>
                    <field name="spec_scan_image" widget="image"
                           filename="spec_scan_filename"
                           options="{'size': [280, 200]}"/>
                    <field name="spec_attachment_ids" widget="many2many_binary"
                           string="แนบไฟล์ (Scan / PDF / รูป)"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_line_form_spec_attach" model="ir.ui.view">
        <field name="name">purchase.request.line.form.spec.attachments</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id" ref="purchase_request.purchase_request_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='specifications']" position="after">
                <group string="เอกสาร/รูปสแกนคุณลักษณะ (แยกรายการ)">
                    <button name="action_open_spec_attachments" type="object"
                            string="เปิดไฟล์แนบ" class="btn-secondary"
                            invisible="spec_attachment_count == 0"/>
                    <field name="spec_scan_filename" invisible="1"/>
                    <field name="spec_scan_image" widget="image"
                           filename="spec_scan_filename"
                           options="{'size': [200, 200]}"/>
                    <field name="spec_attachment_ids" widget="many2many_binary"
                           string="แนบไฟล์ (Scan / PDF / รูป)"/>
                    <field name="spec_attachment_count" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
