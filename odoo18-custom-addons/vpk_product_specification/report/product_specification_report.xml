<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_product_specification" model="ir.actions.report">
        <field name="name">รายละเอียดคุณลักษณะพัสดุ</field>
        <field name="model">purchase.product.specification</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vpk_product_specification.report_product_specification</field>
        <field name="report_file">vpk_product_specification.report_product_specification</field>
        <field name="print_report_name">'คุณลักษณะพัสดุ-%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_purchase_product_specification"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_product_specification">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-size:13px;">
                        <div class="text-center mb-3">
                            <h3>รายละเอียดคุณลักษณะพัสดุที่จะซื้อ/จ้าง/เช่า</h3>
                            <div t-esc="o.company_id.name"/>
                        </div>
                        <table class="table table-sm table-borderless mb-3">
                            <tr>
                                <td style="width:30%;">เลขที่เอกสาร</td>
                                <td><strong t-esc="o.name"/></td>
                            </tr>
                            <tr>
                                <td>วันที่</td>
                                <td><span t-field="o.date"/></td>
                            </tr>
                            <tr>
                                <td>ใบขออนุมัติจัดซื้อ</td>
                                <td t-esc="o.request_id.name"/>
                            </tr>
                            <tr>
                                <td>สัญญา</td>
                                <td t-esc="o.contract_id.name or '-'"/>
                            </tr>
                            <tr>
                                <td>คู่สัญญา</td>
                                <td t-esc="o.partner_id.name or '-'"/>
                            </tr>
                            <tr>
                                <td>หน่วยงาน</td>
                                <td t-esc="o.department_id.name or '-'"/>
                            </tr>
                        </table>

                        <h5>รายการพัสดุและคุณลักษณะ</h5>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th style="width:5%;">ลำดับ</th>
                                    <th style="width:22%;">รายการ</th>
                                    <th style="width:10%;">จำนวน</th>
                                    <th style="width:10%;">หน่วย</th>
                                    <th style="width:45%;">รายละเอียดคุณลักษณะ</th>
                                    <th style="width:8%;">ไฟล์แนบ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td t-esc="line_index + 1"/>
                                        <td>
                                            <t t-esc="line.name"/>
                                            <t t-if="line.product_id">
                                                <br/><small t-esc="line.product_id.default_code or ''"/>
                                            </t>
                                        </td>
                                        <td class="text-end" t-esc="line.product_qty"/>
                                        <td t-esc="line.uom_id.name or '-'"/>
                                        <td style="white-space:pre-wrap;" t-esc="line.specifications"/>
                                        <td class="text-center" t-esc="line.attachment_count"/>
                                    </tr>
                                    <tr t-if="line.spec_scan_image">
                                        <td colspan="6" class="text-center">
                                            <div>รูปสแกน: <t t-esc="line.spec_scan_filename or 'scan'"/></div>
                                            <img t-att-src="image_data_uri(line.spec_scan_image)"
                                                 style="max-width:280px;max-height:200px;"/>
                                        </td>
                                    </tr>
                                    <tr t-if="line.spec_attachment_ids">
                                        <td colspan="6">
                                            เอกสารแนบ:
                                            <t t-foreach="line.spec_attachment_ids" t-as="att">
                                                <span t-esc="att.name"/><t t-if="not att_last">, </t>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="mt-3" t-if="o.notes" t-field="o.notes"/>
                        <div class="mt-4 text-muted" t-if="o.auto_generated">
                            * รายการสร้างอัตโนมัติจากใบขออนุมัติจัดซื้อที่มีสัญญา
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
