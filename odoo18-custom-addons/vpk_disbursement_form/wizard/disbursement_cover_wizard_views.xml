<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vpk_disbursement_cover_wizard_form" model="ir.ui.view">
        <field name="name">vpk.disbursement.cover.wizard.form</field>
        <field name="model">vpk.disbursement.cover.wizard</field>
        <field name="arch" type="xml">
            <form string="ใบปะหน้าการขออนุมัติเบิกจ่ายจาก GFMIS">
                <group>
                    <group string="ตัวกรองดึงรายการใบขอเบิกเงิน">
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="form_type_filter"/>
                        <field name="state_filter"/>
                        <div colspan="2">
                            <button name="action_load_forms" type="object"
                                    string="ดึงรายการใบขอเบิกเงินตามตัวกรอง"
                                    class="btn-outline-primary" icon="fa-refresh"/>
                        </div>
                    </group>
                    <group string="ตั้งค่าหัวตารางและเลขลำดับ">
                        <field name="page_start"/>
                        <field name="seq_start"/>
                        <field name="fiscal_year_be"/>
                        <field name="rows_per_page"/>
                        <field name="default_sub_note"/>
                    </group>
                </group>
                <notebook>
                    <page string="รายการในใบปะหน้า (แก้ไข/เพิ่ม/ลบได้)" name="lines">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="seq_no"/>
                                <field name="transfer_date" optional="show"/>
                                <field name="disbursement_form_id" optional="hide"/>
                                <field name="partner_name"/>
                                <field name="sub_note" optional="show"/>
                                <field name="kb_label"/>
                                <field name="deeka_no"/>
                                <field name="bill_no"/>
                                <field name="amount_request" sum="รวมจำนวนเงิน"/>
                                <field name="wht_amount" sum="รวมภาษี"/>
                                <field name="amount_net" sum="รวมเป็นเงิน"/>
                                <field name="approver_note" optional="show"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_print_pdf" type="object"
                            string="พิมพ์ใบปะหน้า (PDF)" class="btn-primary" icon="fa-print"/>
                    <button name="action_export_excel" type="object"
                            string="ส่งออก Excel (.xls)" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button string="ปิด" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vpk_disbursement_cover_wizard" model="ir.actions.act_window">
        <field name="name">ใบปะหน้าการขออนุมัติเบิกจ่ายจาก GFMIS</field>
        <field name="res_model">vpk.disbursement.cover.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="vpk_disbursement_form.model_vpk_disbursement_form"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
