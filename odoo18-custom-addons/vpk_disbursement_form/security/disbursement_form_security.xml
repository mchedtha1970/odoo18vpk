<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_disbursement_form_user" model="res.groups">
        <field name="name">ใบขอเบิกเงิน: ผู้ใช้งาน (การเงิน)</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="comment">กรอกใบขอเบิกเงิน สร้างไฟล์ Excel และแนบไฟล์</field>
    </record>
    <record id="group_disbursement_form_manager" model="res.groups">
        <field name="name">ใบขอเบิกเงิน: ผู้จัดการ</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_disbursement_form_user'))]"/>
        <field name="comment">ลบ/ยกเลิก และตั้งค่าข้อมูลหน่วยงาน</field>
    </record>
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_disbursement_form_manager'))]"/>
    </record>
    <record id="base.user_root" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_disbursement_form_manager'))]"/>
    </record>

    <record id="rule_disbursement_form_company" model="ir.rule">
        <field name="name">ใบขอเบิกเงิน: เฉพาะบริษัทของผู้ใช้</field>
        <field name="model_id" ref="model_vpk_disbursement_form"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
