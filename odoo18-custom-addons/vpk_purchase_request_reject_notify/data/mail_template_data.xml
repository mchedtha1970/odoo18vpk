<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_pr_rejected" model="mail.template">
        <field name="name">PR ไม่ผ่านอนุมัติ — แจ้งกลุ่มงานผู้ขอ</field>
        <field name="model_id" ref="purchase_request.model_purchase_request"/>
        <field name="subject">ใบขอซื้อ/จ้าง/เช่า {{ object.name }} ไม่ได้รับการอนุมัติ</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.requested_by.email_formatted or object.requested_by.email or '' }}</field>
        <field name="partner_to">{{ object.requested_by.partner_id.id }}</field>
        <field name="description">แจ้งเตือนเมื่อใบขอซื้อ/จ้าง/เช่าไม่ผ่านการอนุมัติ</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:0;font-family:Arial,sans-serif;font-size:14px;color:#333;">
    <p>เรียน กลุ่มงาน/หน่วยงานที่เกี่ยวข้อง</p>
    <p>
        ใบขอซื้อ/จ้าง/เช่า <strong><t t-out="object.name or ''"/></strong>
        ไม่ได้รับการอนุมัติ
    </p>
    <ul>
        <li>หน่วยงาน: <t t-out="object.department_id.display_name or '-'"/></li>
        <li>ผู้ขอ: <t t-out="object.requested_by.display_name or '-'"/></li>
        <li>วันที่ขอ: <t t-out="object.date_start or '-'"/></li>
        <li>รายละเอียด: <t t-out="object.description or '-'"/></li>
    </ul>
    <p>กรุณาเข้าระบบเพื่อตรวจสอบและดำเนินการแก้ไข</p>
    <p>
        <a t-att-href="object.get_base_url() + '/odoo/purchase.request/%s' % object.id"
           style="background:#875A7B;color:#fff;padding:8px 16px;text-decoration:none;border-radius:4px;">
            เปิดใบขอซื้อ
        </a>
    </p>
</div>
        </field>
    </record>
</odoo>
