<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <delete model="account.report.column" id="cash_equivalent_debit"/>
    <delete model="account.report.column" id="cash_equivalent_credit"/>
    <delete model="account.report.column" id="cash_equivalent_balance_credit"/>
    <record id="cash_equivalent" model="account.report">
        <field name="name">เงินฝากธนาคาร จัดกลุ่มตามรหัสบัญชี</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_hierarchy">never</field>
        <field name="filter_hide_0_lines">never</field>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">this_month</field>
        <field name="custom_handler_model_id" ref="model_vpk_cash_equivalent_report_handler"/>
        <field name="column_ids">
            <record id="cash_equivalent_number" model="account.report.column">
                <field name="name">เลขที่บัญชี</field>
                <field name="sequence">1</field>
                <field name="expression_label">acc_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="cash_equivalent_account_name" model="account.report.column">
                <field name="name">ชื่อบัญชี</field>
                <field name="sequence">2</field>
                <field name="expression_label">account_name</field>
                <field name="figure_type">string</field>
            </record>
            <record id="cash_equivalent_balance" model="account.report.column">
                <field name="name">ยอดเงินคงเหลือ</field>
                <field name="sequence">3</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
    </record>
    <record id="action_cash_equivalent" model="ir.actions.client">
        <field name="name">เงินฝากธนาคาร จัดกลุ่มตามรหัสบัญชี</field>
        <field name="tag">account_report</field>
        <field name="path">vpk-cash-equivalent</field>
        <field name="context" eval="{'report_id': ref('vpk_hospital_balance_sheet.cash_equivalent')}"/>
    </record>
    <menuitem id="menu_cash_equivalent"
              name="เงินฝากธนาคาร จัดกลุ่มตามรหัสบัญชี"
              action="action_cash_equivalent"
              parent="account.account_reports_legal_statements_menu"
              sequence="9"
              groups="account.group_account_readonly"/>
</odoo>
