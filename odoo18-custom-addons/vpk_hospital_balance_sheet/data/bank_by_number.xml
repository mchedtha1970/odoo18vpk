<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="bank_by_number" model="account.report">
        <field name="name">รายงานเงินฝากธนาคารตามเลขที่บัญชีธนาคาร</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_hierarchy">never</field>
        <field name="filter_hide_0_lines">never</field>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">this_month</field>
        <field name="custom_handler_model_id" ref="model_vpk_bank_number_report_handler"/>
        <field name="column_ids">
            <record id="bank_by_number_name" model="account.report.column">
                <field name="name">ชื่อบัญชี</field>
                <field name="sequence">1</field>
                <field name="expression_label">account_name</field>
                <field name="figure_type">string</field>
            </record>
            <record id="bank_by_number_debit" model="account.report.column">
                <field name="name">เดบิต</field>
                <field name="sequence">2</field>
                <field name="expression_label">debit</field>
            </record>
            <record id="bank_by_number_credit" model="account.report.column">
                <field name="name">เครดิต</field>
                <field name="sequence">3</field>
                <field name="expression_label">credit</field>
            </record>
            <record id="bank_by_number_balance_debit" model="account.report.column">
                <field name="name">เดบิต</field>
                <field name="sequence">4</field>
                <field name="expression_label">balance_debit</field>
            </record>
            <record id="bank_by_number_balance_credit" model="account.report.column">
                <field name="name">เครดิต</field>
                <field name="sequence">5</field>
                <field name="expression_label">balance_credit</field>
            </record>
        </field>
    </record>
    <record id="action_bank_by_number" model="ir.actions.client">
        <field name="name">รายงานเงินฝากธนาคารตามเลขที่บัญชีธนาคาร</field>
        <field name="tag">account_report</field>
        <field name="path">vpk-bank-by-number</field>
        <field name="context" eval="{'report_id': ref('vpk_hospital_balance_sheet.bank_by_number')}"/>
    </record>
    <menuitem id="menu_bank_by_number"
              name="รายงานเงินฝากธนาคารตามเลขที่บัญชีธนาคาร"
              action="action_bank_by_number"
              parent="account.account_reports_legal_statements_menu"
              sequence="10"
              groups="account.group_account_readonly"/>
</odoo>
