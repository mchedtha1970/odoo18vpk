<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_fy_history" model="ir.ui.view">
        <field name="name">purchase.request.form.fy.history</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="priority">140</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='estimated_cost']" position="after">
                <field name="fy_purchased_qty" optional="show" string="เคยซื้อปีงบฯ"/>
                <field name="fy_last_price_unit" optional="show" string="ราคาล่าสุดปีงบฯ"/>
                <field name="fy_avg_price_unit" optional="hide" string="ราคาเฉลี่ยปีงบฯ"/>
                <field name="fy_unit_price_estimate" optional="hide"/>
                <field name="fy_price_warning" optional="show"
                       decoration-danger="fy_price_warning"
                       widget="badge"/>
                <button name="action_view_fy_purchase_history"
                        type="object"
                        string="ประวัติปีงบฯ"
                        icon="fa-history"
                        optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
