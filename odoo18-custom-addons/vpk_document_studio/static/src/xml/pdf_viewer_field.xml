<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vpk_document_studio.PdfViewerField">
        <div class="o_vpk_pdf_viewer">
            <div t-if="state.loading or state.generating"
                 class="o_vpk_pdf_viewer_status d-flex align-items-center justify-content-center text-muted">
                <div class="text-center">
                    <i class="fa fa-spinner fa-spin fa-2x mb-2"/>
                    <div t-if="state.generating">กำลังสร้างไฟล์ PDF...</div>
                    <div t-else="">กำลังเปิดไฟล์ PDF...</div>
                </div>
            </div>
            <div t-elif="state.error" class="alert alert-danger mb-0">
                ไม่สามารถแสดงไฟล์ PDF ได้ กรุณากดพิมพ์ PDF แล้วเปิดใหม่
            </div>
            <div t-elif="!hasPdf()"
                 class="o_vpk_pdf_viewer_empty d-flex align-items-center justify-content-center text-muted">
                <div class="text-center">
                    <i class="fa fa-file-pdf-o fa-3x mb-3"/>
                    <div class="mb-3">ยังไม่มีไฟล์ PDF ของเอกสารนี้</div>
                    <button type="button" class="btn btn-primary"
                            t-on-click="generatePdf"
                            t-att-disabled="!props.record.resId">
                        <i class="fa fa-file-pdf-o me-1"/>สร้างและแสดง PDF
                    </button>
                </div>
            </div>
            <iframe t-elif="state.viewerUrl"
                    class="o_vpk_pdf_viewer_frame"
                    t-att-src="state.viewerUrl"
                    allowfullscreen="allowfullscreen"/>
        </div>
    </t>
</templates>
