<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_document_studio" model="ir.module.category">
        <field name="name">Document Studio</field>
        <field name="sequence">48</field>
    </record>

    <record id="group_document_studio_user" model="res.groups">
        <field name="name">ผู้ใช้งาน</field>
        <field name="category_id" ref="module_category_document_studio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">สร้างเอกสารจากแบบฟอร์มและสั่งพิมพ์</field>
    </record>

    <record id="group_document_studio_manager" model="res.groups">
        <field name="name">ผู้จัดการ</field>
        <field name="category_id" ref="module_category_document_studio"/>
        <field name="implied_ids" eval="[(4, ref('group_document_studio_user'))]"/>
        <field name="comment">สร้างและแก้ไขแบบฟอร์ม Document Studio</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_studio_template_company" model="ir.rule">
        <field name="name">แบบฟอร์ม Document Studio ตามบริษัท</field>
        <field name="model_id" ref="model_vpk_document_studio_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_studio_document_company" model="ir.rule">
        <field name="name">เอกสาร Document Studio ตามบริษัท</field>
        <field name="model_id" ref="model_vpk_document_studio_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
