<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_studio_document_type_list" model="ir.ui.view">
        <field name="name">vpk.document.studio.document.type.list</field>
        <field name="model">vpk.document.studio.document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="template_count"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_document_studio_document_type_form" model="ir.ui.view">
        <field name="name">vpk.document.studio.document.type.form</field>
        <field name="model">vpk.document.studio.document.type</field>
        <field name="arch" type="xml">
            <form string="ประเภทเอกสาร">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_templates" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="template_count" widget="statinfo" string="แบบฟอร์ม"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="ปิดใช้งาน" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="เช่น รายงานขออนุมัติดำเนินการประกวดราคา"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="ebidding_approval"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="แบบฟอร์มที่ใช้ประเภทนี้" name="templates">
                            <field name="template_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="source_model_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="คำอธิบาย" name="description">
                            <field name="description" placeholder="ใช้เมื่อใด / ขั้นตอนที่เกี่ยวข้อง"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_document_studio_document_type_search" model="ir.ui.view">
        <field name="name">vpk.document.studio.document.type.search</field>
        <field name="model">vpk.document.studio.document.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="ปิดใช้งาน" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_document_studio_document_type" model="ir.actions.act_window">
        <field name="name">ประเภทเอกสาร</field>
        <field name="res_model">vpk.document.studio.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">สร้างประเภทเอกสารแรก</p>
            <p>กำหนด master ประเภทเอกสาร แล้วเลือกประเภทในแบบฟอร์มแต่ละแบบ</p>
        </field>
    </record>
</odoo>
