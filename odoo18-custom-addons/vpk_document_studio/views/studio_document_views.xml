<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_studio_document_list" model="ir.ui.view">
        <field name="name">vpk.document.studio.document.list</field>
        <field name="model">vpk.document.studio.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="document_type_id" optional="show"/>
                <field name="template_id"/>
                <field name="date"/>
                <field name="state"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'generated'"
                       widget="badge"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_document_studio_document_form" model="ir.ui.view">
        <field name="name">vpk.document.studio.document.form</field>
        <field name="model">vpk.document.studio.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="source_mode" invisible="1"/>
                    <button name="action_generate_docx" type="object"
                            string="สร้างไฟล์ Word"
                            class="btn-primary"
                            icon="fa-file-word-o"
                            invisible="source_mode == 'uploaded'"/>
                    <button name="action_generate_pdf" type="object"
                            string="พิมพ์ PDF"
                            class="btn-primary"
                            icon="fa-file-pdf-o"
                            invisible="source_mode == 'uploaded'"/>
                    <button name="action_open_pdf" type="object"
                            string="เปิด PDF"
                            class="btn-secondary"
                            icon="fa-eye"
                            invisible="not pdf_filename"/>
                    <button name="action_open_source_record" type="object"
                            string="เปิดเอกสารต้นทาง"
                            class="btn-secondary"
                            icon="fa-external-link"
                            invisible="not source_ref"/>
                    <button name="action_draft" type="object"
                            string="กลับเป็นร่าง"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source_mode" invisible="source_mode == 'studio'" readonly="1"/>
                            <field name="template_id"
                                   required="source_mode == 'studio'"
                                   invisible="source_mode == 'uploaded' and not template_id"/>
                            <field name="template_document_type_id" invisible="1"/>
                            <field name="document_type_id"
                                   readonly="template_document_type_id"
                                   options="{'no_create': True}"/>
                            <field name="source_model_id" invisible="1"/>
                            <field name="source_ref"
                                   invisible="not source_model_id and not source_ref"/>
                            <field name="date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="docx_filename" invisible="1"/>
                            <field name="docx_file" filename="docx_filename"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="เอกสาร" name="values">
                            <field name="field_schema_json" invisible="1"/>
                            <field name="body" invisible="1"/>
                            <field name="value_json" invisible="1"/>
                            <field name="pdf_file" nolabel="1" widget="vpk_pdf_viewer"
                                   filename="pdf_filename"/>
                        </page>
                        <page string="หมายเหตุ" name="note">
                            <field name="note" placeholder="บันทึกเพิ่มเติม"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_document_studio_document_search" model="ir.ui.view">
        <field name="name">vpk.document.studio.document.search</field>
        <field name="model">vpk.document.studio.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="template_id"/>
                <field name="document_type_id"/>
                <filter string="ร่าง" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="สร้างไฟล์แล้ว" name="generated" domain="[('state', '=', 'generated')]"/>
                <separator/>
                <filter string="ของฉัน" name="my_documents" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter string="ประเภทเอกสาร" name="group_document_type" context="{'group_by': 'document_type_id'}"/>
                    <filter string="แบบฟอร์ม" name="group_template" context="{'group_by': 'template_id'}"/>
                    <filter string="สถานะ" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_document_studio_document" model="ir.actions.act_window">
        <field name="name">เอกสาร</field>
        <field name="res_model">vpk.document.studio.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_documents': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีเอกสาร</p>
            <p>เลือกแบบฟอร์ม แล้วกรอกข้อมูลเพื่อพิมพ์ Word หรือ PDF</p>
        </field>
    </record>
</odoo>
