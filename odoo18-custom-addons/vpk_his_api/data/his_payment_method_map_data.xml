<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_method_cash" model="vpk.his.payment.method.map">
        <field name="name">เงินสด</field>
        <field name="code">cash</field>
        <field name="journal_type">cash</field>
        <field name="create_payment" eval="True"/>
    </record>
    <record id="payment_method_transfer" model="vpk.his.payment.method.map">
        <field name="name">โอนเงิน</field>
        <field name="code">transfer</field>
        <field name="journal_type">bank</field>
        <field name="create_payment" eval="True"/>
    </record>
