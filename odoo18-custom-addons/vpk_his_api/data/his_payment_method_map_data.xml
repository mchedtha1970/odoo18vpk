        <field name="create_payment" eval="False"/>
    </record>
    <record id="payment_method_csmbs" model="vpk.his.payment.method.map">
        <field name="name">สิทธิ์เบิกจ่ายตรง</field>
        <field name="code">csmbs</field>
        <field name="is_entitlement" eval="True"/>
        <field name="create_payment" eval="False"/>
    </record>
    <record id="payment_method_advance" model="vpk.his.payment.method.map">
        <field name="name">ตัดเงินล่วงหน้า</field>
        <field name="code">advance</field>
