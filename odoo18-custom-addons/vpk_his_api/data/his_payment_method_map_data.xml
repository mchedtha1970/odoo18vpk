        <field name="name">บัตรเครดิต</field>
        <field name="code">credit_card</field>
        <field name="journal_type">bank</field>
        <field name="create_payment" eval="True"/>
    </record>
    <record id="payment_method_ar_claim" model="vpk.his.payment.method.map">
        <field name="name">ลูกหนี้สิทธิ์</field>
        <field name="code">ar_claim</field>
        <field name="is_entitlement" eval="True"/>
        <field name="create_payment" eval="False"/>
    </record>
    <record id="payment_method_sso" model="vpk.his.payment.method.map">
