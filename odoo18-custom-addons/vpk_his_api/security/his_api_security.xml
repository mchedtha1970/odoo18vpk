<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vpk_his_api" model="ir.module.category">
        <field name="name">HIS Interface</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_his_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_vpk_his_api"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_his_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="category_id" ref="module_category_vpk_his_api"/>
        <field name="implied_ids" eval="[(4, ref('group_his_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">ตรวจและผ่านชุดข้อมูลรายได้/รับเงินจาก HIS</field>
    </record>

    <record id="group_his_pharmacist" model="res.groups">
        <field name="name">Pharmacist</field>
        <field name="category_id" ref="module_category_vpk_his_api"/>
        <field name="implied_ids" eval="[(4, ref('group_his_user')), (4, ref('stock.group_stock_user'))]"/>
        <field name="comment">ตรวจและผ่านชุดข้อมูลตัดใช้สต็อกจาก HIS</field>
    </record>

    <record id="group_his_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_vpk_his_api"/>
        <field name="implied_ids" eval="[(4, ref('group_his_accountant')), (4, ref('group_his_pharmacist'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">ตั้งค่าแมพรหัส, API key และดู API log</field>
    </record>
</odoo>
