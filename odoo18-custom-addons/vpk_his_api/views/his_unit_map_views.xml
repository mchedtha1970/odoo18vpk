<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_his_unit_map_list" model="ir.ui.view">
        <field name="name">vpk.his.unit.map.list</field>
        <field name="model">vpk.his.unit.map</field>
        <field name="arch" type="xml">
            <list>
                <field name="his_code"/>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_his_unit_map_form" model="ir.ui.view">
        <field name="name">vpk.his.unit.map.form</field>
        <field name="model">vpk.his.unit.map</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="his_code"/>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_his_unit_map" model="ir.actions.act_window">
        <field name="name">HIS Service Units</field>
        <field name="res_model">vpk.his.unit.map</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
