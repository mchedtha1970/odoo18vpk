<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ประวัติซื้อรายสินค้า (per item) -->
    <record id="view_purchase_order_line_vendor_history_list" model="ir.ui.view">
        <field name="name">purchase.order.line.vendor.history.list</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  default_order="date_order desc, id desc">
                <field name="date_order" string="วันที่สั่งซื้อ"/>
                <field name="order_id" string="เลขที่ PO"/>
                <field name="product_id" string="สินค้า"/>
                <field name="name" string="รายละเอียด" optional="hide"/>
                <field name="product_qty" string="จำนวน" sum="รวมจำนวน"/>
                <field name="product_uom" string="หน่วย" optional="show"/>
                <field name="price_unit" string="ราคา/หน่วย"/>
                <field name="price_subtotal" string="มูลค่า" sum="รวมมูลค่า"/>
                <field name="qty_received" string="รับแล้ว" optional="show" sum="รวมรับ"/>
                <field name="qty_invoiced" string="ตั้งหนี้แล้ว" optional="show" sum="รวมตั้งหนี้"/>
                <field name="state" string="สถานะ PO" optional="show"
                       widget="badge"
                       decoration-success="state in ('purchase', 'done')"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'cancel'"/>
                <button name="action_open_purchase_order"
                        type="object"
                        string="เปิด PO"
                        icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_order_line_vendor_history_search" model="ir.ui.view">
        <field name="name">purchase.order.line.vendor.history.search</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="order_id"/>
                <field name="name"/>
                <separator/>
                <filter name="confirmed" string="ยืนยันแล้ว"
                        domain="[('state', 'in', ['purchase', 'done'])]"/>
                <filter name="received" string="รับครบแล้ว"
                        domain="[('qty_received', '>', 0)]"/>
                <filter name="invoiced" string="ตั้งหนี้แล้ว"
                        domain="[('qty_invoiced', '>', 0)]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter name="group_product" string="สินค้า"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_order" string="ใบสั่งซื้อ"
                            context="{'group_by': 'order_id'}"/>
                    <filter name="group_month" string="เดือนที่สั่ง"
                            context="{'group_by': 'date_order:month'}"/>
                    <filter name="group_state" string="สถานะ"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vendor_purchase_line_history" model="ir.actions.act_window">
        <field name="name">ประวัติซื้อรายสินค้า</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('order_id.state', 'in', ['purchase', 'done']), ('display_type', '=', False)]</field>
        <field name="context">{'search_default_group_product': 1}</field>
        <field name="view_id" ref="view_purchase_order_line_vendor_history_list"/>
        <field name="search_view_id" ref="view_purchase_order_line_vendor_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีประวัติการซื้อรายสินค้า</p>
        </field>
    </record>
</odoo>
