<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_committee_select_wizard_form" model="ir.ui.view">
        <field name="name">procurement.committee.select.wizard.form</field>
        <field name="model">procurement.committee.select.wizard</field>
        <field name="arch" type="xml">
            <form string="เลือกกรรมการหลายคน">
                <field name="request_id" invisible="1"/>
                <field name="existing_employee_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="committee_type"/>
                        <field name="approve_role"/>
                    </group>
                    <group>
                        <field name="first_as_chairman"/>
                    </group>
                </group>
                <div class="text-muted small mb-2">
                    กด "เพิ่มรายการ" แล้วติ๊กเลือกพนักงานได้หลายคน กด "เลือก" จากนั้นกด "เพิ่มกรรมการ" เพื่อบันทึกทีเดียว
                </div>
                <field name="employee_ids" nolabel="1"
                       domain="[('id', 'not in', existing_employee_ids)]"
                       options="{'no_create': True}">
                    <list>
                        <field name="name"/>
                        <field name="department_id"/>
                        <field name="job_title"/>
                        <field name="work_email"/>
                    </list>
                </field>
                <footer>
                    <button name="action_add_members" type="object"
                            string="เพิ่มกรรมการ" class="btn-primary" data-hotkey="q"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
