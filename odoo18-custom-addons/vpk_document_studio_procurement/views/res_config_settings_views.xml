<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_studio_procurement" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.studio.procurement</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="เอกสารจัดซื้อจัดจ้าง (Document Studio)" name="vpk_studio_procurement_setting">
                    <setting string="หน่วยงานในหัวคำสั่ง"
                             help="ข้อความต่อจากคำว่า คำสั่ง เช่น โรงพยาบาลวชิระภูเก็ต — ลำดับผู้อนุมัติตั้งที่แบบฟอร์ม Document Studio หรือตอนสร้างเอกสาร">
                        <field name="official_doc_agency"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
