<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Example sequential tiers — edit/add more in การอนุมัติตามลำดับ → กำหนดลำดับการอนุมัติ -->
    <record id="tier_definition_asset_transfer_1" model="tier.definition">
        <field name="name">ใบโอนทรัพย์สิน — ลำดับ 1</field>
        <field name="model_id" ref="model_vpk_asset_transfer"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="group_asset_transfer_approver"/>
        <field name="definition_type">domain</field>
        <field name="definition_domain">[]</field>
        <field name="sequence">10</field>
        <field name="approve_sequence" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="tier_definition_asset_transfer_2" model="tier.definition">
        <field name="name">ใบโอนทรัพย์สิน — ลำดับ 2</field>
        <field name="model_id" ref="model_vpk_asset_transfer"/>
        <field name="review_type">group</field>
        <field name="reviewer_group_id" ref="group_asset_transfer_manager"/>
        <field name="definition_type">domain</field>
        <field name="definition_domain">[]</field>
        <field name="sequence">20</field>
        <field name="approve_sequence" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
