<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vpk_asset_transfer" model="ir.module.category">
        <field name="name">ใบโอนทรัพย์สิน</field>
        <field name="sequence">58</field>
    </record>

    <record id="group_asset_transfer_user" model="res.groups">
        <field name="name">ผู้ใช้งาน</field>
        <field name="category_id" ref="module_category_vpk_asset_transfer"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="comment">สร้างใบโอนและส่งขอโอน</field>
    </record>

    <record id="group_asset_transfer_approver" model="res.groups">
        <field name="name">ผู้อนุมัติ</field>
        <field name="category_id" ref="module_category_vpk_asset_transfer"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_transfer_user'))]"/>
        <field name="comment">ใช้เป็นกลุ่มผู้อนุมัติในเมนู การอนุมัติตามลำดับ → กำหนดลำดับการอนุมัติ</field>
    </record>

    <record id="group_asset_transfer_receiver" model="res.groups">
        <field name="name">ผู้รับโอน</field>
        <field name="category_id" ref="module_category_vpk_asset_transfer"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_transfer_user'))]"/>
        <field name="comment">รับโอนทรัพย์สินหลังอนุมัติครบ</field>
    </record>

    <record id="group_asset_transfer_manager" model="res.groups">
        <field name="name">ผู้จัดการ</field>
        <field name="category_id" ref="module_category_vpk_asset_transfer"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_transfer_approver')), (4, ref('group_asset_transfer_receiver')), (4, ref('account.group_account_manager'))]"/>
        <field name="comment">จัดการใบโอนและลำดับผู้อนุมัติทั้งหมด</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
