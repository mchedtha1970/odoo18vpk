<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ebidding_plan_publish_code_wizard_form" model="ir.ui.view">
        <field name="name">ebidding.plan.publish.code.wizard.form</field>
        <field name="model">ebidding.plan.publish.code.wizard</field>
        <field name="arch" type="xml">
            <form string="บันทึกรหัสเผยแพร่แผน">
                <sheet>
                    <group>
                        <field name="plan_id" invisible="1"/>
                        <field name="publish_code" placeholder="เช่น M60110000258"/>
                    </group>
                    <separator string="เลือกรายการแผนที่ต้องการบันทึกรหัส"/>
                    <field name="item_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="selected"/>
                            <field name="plan_line_id" column_invisible="1"/>
                            <field name="plan_code" readonly="1"/>
                            <field name="project_name" readonly="1"/>
                            <field name="publish_code_current" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="OK"
                            class="btn-primary"/>
                    <button name="action_select_all" type="object"
                            string="เลือกทั้งหมด" class="btn-secondary"/>
                    <button name="action_unselect_all" type="object"
                            string="ไม่เลือกทั้งหมด" class="btn-secondary"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
