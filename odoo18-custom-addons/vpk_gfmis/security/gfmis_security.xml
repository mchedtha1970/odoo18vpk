<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vpk_gfmis" model="ir.module.category">
        <field name="name">กระบวนการ GFMIS</field>
        <field name="description">เอกสารเบิกจ่าย New GFMIS Thai และการเชื่อมโยงกับรายการใน ERP</field>
        <field name="sequence">36</field>
    </record>

    <record id="group_gfmis_user" model="res.groups">
        <field name="name">ผู้ใช้</field>
        <field name="category_id" ref="module_category_vpk_gfmis"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_gfmis_manager" model="res.groups">
        <field name="name">ผู้อนุมัติ / ผู้ดูแล</field>
        <field name="category_id" ref="module_category_vpk_gfmis"/>
        <field name="implied_ids" eval="[(4, ref('group_gfmis_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="gfmis_document_company_rule" model="ir.rule">
        <field name="name">เอกสาร GFMIS ตามบริษัท</field>
        <field name="model_id" ref="model_gfmis_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="gfmis_document_line_company_rule" model="ir.rule">
        <field name="name">บรรทัด GFMIS ตามบริษัท</field>
        <field name="model_id" ref="model_gfmis_document_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
