<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_gfmis" model="ir.ui.view">
        <field name="name">account.move.form.gfmis</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_gfmis_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-university"
                        invisible="move_type not in ('in_invoice', 'in_refund')">
                    <field name="gfmis_document_count" widget="statinfo" string="GFMIS"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_gfmis_document"
                        type="object"
                        string="สร้างเอกสาร GFMIS"
                        class="btn-secondary"
                        invisible="move_type not in ('in_invoice', 'in_refund') or gfmis_document_count"/>
            </xpath>
        </field>
    </record>
</odoo>
