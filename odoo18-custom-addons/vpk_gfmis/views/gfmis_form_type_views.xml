<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gfmis_form_type_list" model="ir.ui.view">
        <field name="name">gfmis.form.type.list</field>
        <field name="model">gfmis.form.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="doc_class"/>
                <field name="fund_type"/>
                <field name="payment_method"/>
                <field name="requires_po"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_gfmis_form_type_form" model="ir.ui.view">
        <field name="name">gfmis.form.type.form</field>
        <field name="model">gfmis.form.type</field>
        <field name="arch" type="xml">
            <form string="แบบฟอร์ม GFMIS">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sap_tcode"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="doc_class"/>
                            <field name="fund_type"/>
                            <field name="payment_method"/>
                            <field name="requires_po"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <field name="note" placeholder="หมายเหตุตามคู่มือระบบเบิกจ่าย (AP)"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gfmis_form_type" model="ir.actions.act_window">
        <field name="name">แบบฟอร์ม GFMIS</field>
        <field name="res_model">gfmis.form.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
