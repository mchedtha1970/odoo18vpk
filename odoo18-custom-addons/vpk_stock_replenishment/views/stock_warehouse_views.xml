        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="resupply_wh_ids" position="after">
                <field
                    name="vpk_replenishment_source_wh_id"
