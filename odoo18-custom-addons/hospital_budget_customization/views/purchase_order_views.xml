<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_hospital_budget" model="ir.ui.view">
        <field name="name">purchase.order.form.hospital.budget</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field
                    name="budget_id"
                    options="{'no_create': True, 'no_create_edit': True}"
                    attrs="{'readonly': [('state', 'not in', ('draft', 'sent', 'to approve'))]}"
                />
                <field
                    name="fund_source_id"
                    options="{'no_create': True, 'no_create_edit': True}"
                    attrs="{'readonly': [('state', 'not in', ('draft', 'sent', 'to approve'))]}"
                />
            </field>
        </field>
    </record>

    <record id="view_purchase_order_tree_hospital_budget" model="ir.ui.view">
        <field name="name">purchase.order.tree.hospital.budget</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="budget_id" optional="show"/>
                <field name="fund_source_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
