<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_hospital_budget_garuda" model="ir.ui.view">
        <field name="name">res.company.form.hospital.budget.garuda</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Thai Government Document" name="thai_gov_document">
                    <group>
                        <field
                            name="th_garuda_emblem"
                            widget="image"
                            class="oe_avatar"
                            options="{'size': [180, 180]}"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
