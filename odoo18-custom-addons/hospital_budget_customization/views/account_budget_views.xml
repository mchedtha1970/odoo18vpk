<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_form_hospital_custom" model="ir.ui.view">
        <field name="name">budget.view.form.hospital.custom</field>
        <field name="model">budget.budget</field>
        <field name="inherit_id" ref="base_account_budget.crossovered_budget_view_form"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="approval_stage" widget="statusbar"/>
            </field>
            <button name="action_budget_done" position="before">
                <button
                    name="action_move_to_budget_office"
                    type="object"
                    string="To Budget Office"
                    attrs="{'invisible': [('approval_stage', '!=', 'department')]}"
                />
                <button
                    name="action_move_to_management"
                    type="object"
                    string="To Executive Review"
                    attrs="{'invisible': [('approval_stage', '!=', 'budget_office')]}"
                />
                <button
                    name="action_mark_pending_provincial"
                    type="object"
                    string="Pending Provincial Office"
                    attrs="{'invisible': [('approval_stage', '!=', 'management')]}"
                />
                <button
                    name="action_mark_budget_approved"
                    type="object"
                    string="Mark Approved"
                    class="oe_highlight"
                    attrs="{'invisible': [('approval_stage', 'not in', ('management', 'pending_provincial'))]}"
                />
                <button
                    name="action_mark_budget_rejected"
                    type="object"
                    string="Reject"
                    attrs="{'invisible': [('approval_stage', '=', 'rejected')]}"
                />
            </button>
            <group position="inside">
                <group string="Budget Control Snapshot">
                    <field name="approved_amount_total"/>
                    <field name="actual_amount_total"/>
                </group>
                <group string="Budget Control Snapshot">
                    <field name="encumbrance_amount_total"/>
                    <field name="available_amount_total"/>
                </group>
            </group>
            <xpath expr="//field[@name='budget_line']/tree/field[@name='planned_amount']" position="before">
                <field name="fund_source_id"/>
                <field name="requested_amount" sum="Requested Amount"/>
                <field name="historical_amount_y1" sum="Actual Y-1"/>
                <field name="historical_amount_y2" sum="Actual Y-2"/>
                <field name="historical_amount_y3" sum="Actual Y-3"/>
            </xpath>
            <xpath expr="//field[@name='budget_line']/form/group" position="inside">
                <field name="fund_source_id"/>
                <field name="requested_amount"/>
                <field name="historical_amount_y1" readonly="1"/>
                <field name="historical_amount_y2" readonly="1"/>
                <field name="historical_amount_y3" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_budget_line_form_hospital_custom" model="ir.ui.view">
        <field name="name">budget.line.form.hospital.custom</field>
        <field name="model">budget.lines</field>
        <field name="inherit_id" ref="base_account_budget.view_budget_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@col='4']" position="inside">
                <field name="fund_source_id"/>
                <field name="requested_amount"/>
                <button
                    name="action_open_adjustment_wizard"
                    type="object"
                    string="Adjust Budget Amount"
                    class="oe_highlight"
                />
                <field name="historical_amount_y1" readonly="1"/>
                <field name="historical_amount_y2" readonly="1"/>
                <field name="historical_amount_y3" readonly="1"/>
            </xpath>
            <sheet position="inside">
                <group string="Adjustment Logs">
                    <field name="adjustment_log_ids" readonly="1">
                        <tree>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="old_amount"/>
                            <field name="new_amount"/>
                            <field name="delta_amount"/>
                            <field name="reason"/>
                        </tree>
                    </field>
                </group>
            </sheet>
        </field>
    </record>

    <record id="view_budget_line_tree_hospital_custom" model="ir.ui.view">
        <field name="name">budget.line.tree.hospital.custom</field>
        <field name="model">budget.lines</field>
        <field name="inherit_id" ref="base_account_budget.view_budget_line_tree"/>
        <field name="arch" type="xml">
            <field name="analytic_account_id" position="after">
                <field name="fund_source_id"/>
                <field name="requested_amount" optional="show"/>
                <field name="historical_amount_y1" optional="hide"/>
                <field name="historical_amount_y2" optional="hide"/>
                <field name="historical_amount_y3" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_budget_line_search_hospital_custom" model="ir.ui.view">
        <field name="name">account.budget.line.search.hospital.custom</field>
        <field name="model">budget.lines</field>
        <field name="inherit_id" ref="base_account_budget.view_budget_line_search"/>
        <field name="arch" type="xml">
            <field name="analytic_account_id" position="after">
                <field name="fund_source_id"/>
            </field>
        </field>
    </record>
</odoo>
