<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_line_adjustment_wizard_form" model="ir.ui.view">
        <field name="name">budget.line.adjustment.wizard.form</field>
        <field name="model">budget.line.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjust Budget Amount">
                <group>
                    <field name="budget_line_id"/>
                    <field name="current_planned_amount"/>
                    <field name="new_planned_amount"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button
                        name="action_apply_adjustment"
                        type="object"
                        string="Apply"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
