<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_hospital_budget" model="ir.ui.view">
        <field name="name">purchase.request.form.hospital.budget</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_budget.view_purchase_request_form_budget"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_print_purchase_memo"
                    type="object"
                    string="พิมพ์บันทึกข้อความ"
                    attrs="{'invisible': ['|', ('id', '=', False), ('state', 'in', ('draft', 'rejected'))]}"
                />
                <button
                    name="action_print_committee_memo"
                    type="object"
                    string="พิมพ์บันทึกแต่งตั้ง"
                    attrs="{'invisible': ['|', ('id', '=', False), ('state', 'in', ('draft', 'rejected'))]}"
                />
                <button
                    name="action_check_budget_status"
                    type="object"
                    string="เช็คสถานะ Budget"
                    attrs="{'invisible': [('id', '=', False)]}"
                />
            </header>
            <field name="budget_id" position="after">
                <field
                    name="fund_source_id"
                    options="{'no_create': True, 'no_create_edit': True}"
                    attrs="{'readonly': [('is_editable','=', False)]}"
                />
            </field>
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="widget">tinymce_html</attribute>
                <attribute name="placeholder">โปรดระบุคำขอจัดซื้อ</attribute>
                <attribute name="options">
                    {'official_preset': true, 'template_menu': true, 'default_template': true, 'min_height': 320, 'placeholder': 'โปรดระบุคำขอจัดซื้อ'}
                </attribute>
            </xpath>
            <xpath expr="//sheet/group/group[field[@name='group_id']]/field[@name='group_id']" position="after">
                <xpath expr="//sheet/group/group[3]/field[@name='date_start']" position="move"/>
                <xpath expr="//sheet/group/group[3]/field[@name='picking_type_id']" position="move"/>
                <xpath expr="//sheet/group/group[3]/field[@name='currency_id']" position="move"/>
                <xpath expr="//sheet/group/group[3]/field[@name='company_id']" position="move"/>
                <xpath expr="//sheet/group/group/field[@name='budget_id']" position="move"/>
                <xpath expr="//sheet/group/group/field[@name='fund_source_id']" position="move"/>
            </xpath>
            <xpath expr="//sheet/group/group[3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <notebook position="inside">
                <page string="บันทึกข้อความขอซื้อ">
                    <group string="หัวเอกสาร">
                        <group>
                            <field name="memo_department_name"/>
                            <field name="memo_phone"/>
                            <field name="memo_document_no"/>
                        </group>
                        <group>
                            <field name="memo_date"/>
                            <field name="memo_subject"/>
                            <field name="memo_to"/>
                        </group>
                    </group>
                    <group string="เนื้อหา">
                        <group>
                            <field name="memo_style_preset"/>
                        </group>
                        <group>
                            <button
                                name="action_memo_load_template"
                                type="object"
                                string="โหลดแม่แบบเอกสารราชการ"
                                class="oe_highlight"
                            />
                            <button
                                name="action_memo_reset_template"
                                type="object"
                                string="รีเซ็ตเนื้อหา"
                                confirm="ระบบจะเขียนทับเนื้อหาปัจจุบัน ต้องการดำเนินการต่อหรือไม่?"
                            />
                        </group>
                        <field
                            name="memo_body_html"
                            colspan="2"
                            widget="html"
                            options="{'style-inline': true, 'codeview': true}"
                        />
                    </group>
                    <group string="ผู้ลงนาม">
                        <group>
                            <field name="memo_signer_name"/>
                            <field name="memo_signer_position"/>
                        </group>
                        <group>
                            <field name="memo_approver_name"/>
                            <field name="memo_approver_position"/>
                        </group>
                    </group>
                    <group string="ไฟล์แนบอัตโนมัติจากปุ่มพิมพ์">
                        <field name="memo_pdf_file" filename="memo_pdf_filename"/>
                        <field name="memo_pdf_filename" invisible="1"/>
                        <field name="memo_pdf_attachment_id" readonly="1"/>
                        <button
                            name="action_view_memo_pdf"
                            type="object"
                            string="เปิดดู PDF"
                            class="oe_highlight"
                            attrs="{'invisible': [('memo_pdf_attachment_id', '=', False)]}"
                        />
                    </group>
                </page>
                <page string="บันทึกแต่งตั้งคณะกรรมการ">
                    <group string="หัวเอกสาร">
                        <group>
                            <field name="memo_department_name"/>
                            <field name="memo_phone"/>
                            <field name="memo_document_no"/>
                        </group>
                        <group>
                            <field name="committee_memo_date"/>
                            <field name="committee_memo_subject"/>
                            <field name="committee_memo_to"/>
                        </group>
                    </group>
                    <group string="เนื้อหาเอกสารแต่งตั้ง">
                        <field
                            name="committee_memo_body_html"
                            colspan="2"
                            widget="html"
                            options="{'style-inline': true, 'codeview': true}"
                        />
                    </group>
                    <group string="ไฟล์แนบอัตโนมัติจากปุ่มพิมพ์">
                        <field
                            name="committee_memo_pdf_file"
                            filename="committee_memo_pdf_filename"
                        />
                        <field name="committee_memo_pdf_filename" invisible="1"/>
                        <field name="committee_memo_pdf_attachment_id" readonly="1"/>
                        <button
                            name="action_view_committee_memo_pdf"
                            type="object"
                            string="เปิดดู PDF"
                            class="oe_highlight"
                            attrs="{'invisible': [('committee_memo_pdf_attachment_id', '=', False)]}"
                        />
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_purchase_request_tree_hospital_budget" model="ir.ui.view">
        <field name="name">purchase.request.tree.hospital.budget</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_budget.view_purchase_request_tree_budget"/>
        <field name="arch" type="xml">
            <field name="budget_id" position="after">
                <field name="fund_source_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_request_search_hospital_budget" model="ir.ui.view">
        <field name="name">purchase.request.search.hospital.budget</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request_budget.view_purchase_request_search_budget"/>
        <field name="arch" type="xml">
            <field name="budget_id" position="after">
                <field name="fund_source_id"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_request_form_hospital_budget_force_html_editor" model="ir.ui.view">
        <field name="name">purchase.request.form.hospital.budget.force.html.editor</field>
        <field name="model">purchase.request</field>
        <field name="priority">1000</field>
        <field name="inherit_id" ref="view_purchase_request_form_hospital_budget"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='memo_body_html']" position="attributes">
                <attribute name="widget">html</attribute>
                <attribute name="options">{'style-inline': true, 'codeview': true}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
