<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_vpk_pending_review_dashboard" model="ir.actions.client">
        <field name="name">แดชบอร์ดงานรออนุมัติ</field>
        <field name="tag">vpk_pending_review_dashboard</field>
    </record>

    <record id="action_vpk_tier_review_pending" model="ir.actions.act_window">
        <field name="name">รายการรออนุมัติทั้งหมด</field>
        <field name="res_model">tier.review</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'pending')]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem
        id="menu_vpk_tier_validation_root"
        name="การอนุมัติตามลำดับ"
        sequence="25"
        groups="base.group_user"
    />

    <menuitem
        id="menu_vpk_pending_review_dashboard"
        name="แดชบอร์ด"
        parent="menu_vpk_tier_validation_root"
        action="action_vpk_pending_review_dashboard"
        sequence="1"
        groups="base.group_user"
    />

    <menuitem
        id="menu_vpk_my_pending_reviews"
        name="งานรออนุมัติของฉัน"
        parent="menu_vpk_tier_validation_root"
        action="action_vpk_my_pending_reviews"
        sequence="5"
        groups="base.group_user"
    />

    <menuitem
        id="menu_vpk_tier_definition"
        name="กำหนดลำดับการอนุมัติ"
        parent="menu_vpk_tier_validation_root"
        action="base_tier_validation.tier_definition_action"
        sequence="10"
        groups="base.group_erp_manager"
    />

    <menuitem
        id="menu_vpk_tier_exception"
        name="ข้อยกเว้นการแก้ไขระหว่างอนุมัติ"
        parent="menu_vpk_tier_validation_root"
        action="base_tier_validation.tier_validation_exception_action"
        sequence="20"
        groups="base.group_erp_manager"
    />

    <menuitem
        id="menu_vpk_tier_review"
        name="รายการรออนุมัติทั้งหมด"
        parent="menu_vpk_tier_validation_root"
        action="action_vpk_tier_review_pending"
        sequence="30"
        groups="base.group_erp_manager"
    />
</odoo>
