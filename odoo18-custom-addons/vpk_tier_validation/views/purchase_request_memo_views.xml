<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_request_form_official_memo" model="ir.ui.view">
        <field name="name">purchase.request.form.official.memo</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <field name="procurement_method_id" position="after">
                <xpath expr="//field[@name='date_start']" position="move"/>
            </field>
            <field name="group_id" position="attributes">
                <attribute name="groups"/>
            </field>
            <field name="group_id" position="after">
                <xpath expr="//field[@name='picking_type_id']" position="move"/>
                <xpath expr="//field[@name='company_id'][@invisible='1']" position="move"/>
                <xpath expr="//field[@name='company_id'][@widget='selection']" position="move"/>
            </field>
            <xpath expr="//sheet/group/group[3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <button name="button_to_approve" position="after">
                <button
                    name="action_generate_memo_content"
                    type="object"
                    string="สร้างเนื้อหาบันทึกข้อความ"
                    class="btn-secondary"
                    icon="fa-magic"
                    invisible="1"
                />
                <button
                    name="action_print_official_memo"
                    type="object"
                    string="พิมพ์บันทึกข้อความ"
                    class="btn-secondary"
                    icon="fa-print"
                    invisible="1"
                />
            </button>
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="บันทึกข้อความ" name="official_memo" invisible="1">
                    <field name="validation_status" invisible="1"/>
                    <group>
                        <group string="หัวเอกสาร">
                            <field name="memo_agency" readonly="0"/>
                            <field name="memo_ref_prefix" readonly="0"/>
                            <field name="memo_ref" readonly="0"/>
                            <field name="memo_date" readonly="0"/>
                        </group>
                        <group string="เรื่อง / เรียน">
                            <field name="memo_subject" readonly="0"/>
                            <field name="memo_to" readonly="0"/>
                            <field name="memo_show_committee" readonly="0"/>
                        </group>
                    </group>
                    <group string="รายละเอียดโครงการ">
                        <group>
                            <field name="memo_item_summary" readonly="0"/>
                            <field name="memo_procurement_method" readonly="0"/>
                        </group>
                        <group>
                            <field name="memo_delivery_days" readonly="0"/>
                        </group>
                    </group>
                    <group string="ลายเซ็น">
                        <group>
                            <field name="memo_proposer_name" readonly="0"/>
                            <field name="memo_proposer_position" readonly="0"/>
                        </group>
                        <group>
                            <field name="memo_approver_name" readonly="0"/>
                            <field name="memo_approver_position" readonly="0"/>
                            <field name="memo_approver_acting" readonly="0"/>
                        </group>
                    </group>
                    <separator string="เนื้อหา (ข้อ ๑-๖)"/>
                    <field
                        name="memo_body"
                        nolabel="1"
                        readonly="0"
                        widget="html"
                        options="{'height': 360}"
                        placeholder="กดปุ่ม สร้างเนื้อหาบันทึกข้อความ เพื่อสร้างข้อความตามรูปแบบราชการ..."
                    />
                    <separator string="เนื้อหา (ข้อ ๗-๑๐)"/>
                    <field
                        name="memo_body_page2"
                        nolabel="1"
                        readonly="0"
                        widget="html"
                        options="{'height': 320}"
                    />
                    <separator string="ข้อความปิดท้าย (หน้า ๓)"/>
                    <field
                        name="memo_closing"
                        nolabel="1"
                        readonly="0"
                        widget="html"
                        options="{'height': 240}"
                    />
                    <separator string="หน้าอนุมัติ (หน้า ๔)"/>
                    <field
                        name="memo_approval"
                        nolabel="1"
                        readonly="0"
                        widget="html"
                        options="{'height': 240}"
                    />
                    <div class="alert alert-info" role="alert">
                        คณะกรรมการพิจารณาผล e-bidding ดึงจาก Procurement Committee
                        และคณะกรรมการตรวจรับพัสดุดึงจาก Work Acceptance Committee อัตโนมัติ
                    </div>
                    <button
                        name="action_generate_memo_content"
                        type="object"
                        string="สร้างเนื้อหาบันทึกข้อความ"
                        class="btn-secondary"
                        icon="fa-magic"
                    />
                    <button
                        name="action_print_official_memo"
                        type="object"
                        string="พิมพ์บันทึกข้อความ (PDF)"
                        class="btn-primary"
                        icon="fa-print"
                    />
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_vpk_memo" model="ir.ui.view">
        <field name="name">res.company.form.vpk.memo</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="บันทึกข้อความ VPK" name="vpk_memo_settings">
                    <group>
                        <group>
                            <field name="vpk_memo_agency"/>
                            <field name="vpk_memo_phone"/>
                            <field name="vpk_memo_default_to"/>
                        </group>
                        <group string="ลายเซ็นเริ่มต้น">
                            <field name="vpk_memo_proposer_name"/>
                            <field name="vpk_memo_proposer_position"/>
                            <field name="vpk_memo_approver_name"/>
                            <field name="vpk_memo_approver_position"/>
                            <field name="vpk_memo_approver_acting"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
