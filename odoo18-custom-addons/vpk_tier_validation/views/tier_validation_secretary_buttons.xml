<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="tier_validation_label_secretary"
        inherit_id="base_tier_validation.tier_validation_label"
    >
        <xpath expr="//button[@name='validate_tier']" position="before">
            <field name="vpk_secretary_can_screen" invisible="1"/>
        </xpath>
        <xpath expr="//button[@name='validate_tier']" position="attributes">
            <attribute name="invisible">not can_review or vpk_secretary_can_screen</attribute>
        </xpath>
        <xpath expr="//button[@name='reject_tier']" position="attributes">
            <attribute name="invisible">not can_review or vpk_secretary_can_screen</attribute>
        </xpath>
        <xpath expr="//button[@name='reject_tier']" position="after">
            <button
                name="reject_tier"
                string="ตีกลับ"
                invisible="not vpk_secretary_can_screen"
                type="object"
                class="btn-icon btn-danger"
                icon="fa-undo"
            />
        </xpath>
    </template>
</odoo>
