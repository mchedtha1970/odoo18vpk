<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vpk_payment_request_wizard_form" model="ir.ui.view">
        <field name="name">vpk.payment.request.wizard.form</field>
        <field name="model">vpk.payment.request.wizard</field>
        <field name="arch" type="xml">
            <form string="ขออนุมัติเบิกจ่าย">
                <field name="available_wa_ids" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    ขออนุมัติเบิกจ่ายได้หลังตรวจรับมอบงานเสร็จแล้ว ระบบสร้างเอกสารขออนุมัติให้
                    เพิ่มผู้อนุมัติแล้วส่งลงนามภายใน เมื่อลงนามครบจะส่งต่อให้เจ้าหนี้
                </div>
                <group>
                    <field name="purchase_id"/>
                    <field name="wa_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="amount"/>
                    <field name="add_mode" widget="radio"/>
                    <field name="file" filename="filename"
                           invisible="add_mode != 'attach'" required="add_mode == 'attach'"/>
                    <field name="filename" invisible="1"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="สร้างเอกสารขออนุมัติเบิกจ่าย"
                            class="btn-primary"/>
                    <button special="cancel" string="ยกเลิก"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
