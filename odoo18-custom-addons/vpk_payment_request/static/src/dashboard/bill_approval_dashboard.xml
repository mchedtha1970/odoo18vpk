<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vpk_payment_request.BillApprovalDashboard">
        <div t-att-class="props.className" class="o_vpk_ap">
            <div class="o_vpk_ap_scroll">
                <header class="o_vpk_ap_head">
                    <div>
                        <h1>งานบัญชี: อนุมัติตั้งเจ้าหนี้ (Bill)</h1>
                        <p>รายการใบเรียกเก็บ (Bill) ที่เจ้าหนี้ส่งมาขออนุมัติตั้งเจ้าหนี้ → บัญชีตรวจสอบและอนุมัติ → POST ลงบัญชี</p>
                    </div>
                    <button class="btn btn-light" t-on-click="() => this.loadData()">
                        <i class="fa fa-refresh"/> รีเฟรช
                    </button>
                </header>

                <t t-if="!state.ready">
                    <div class="o_vpk_ap_loading">กำลังโหลดข้อมูล...</div>
                </t>
                <t t-else="">
                    <section class="o_vpk_ap_kpis o_vpk_ap_kpis_3">
                        <t t-foreach="state.data.kpis" t-as="kpi" t-key="kpi.key">
                            <button type="button"
                                    t-att-class="'o_vpk_ap_kpi tone-' + kpi.tone + (state.filter === kpi.key ? ' active' : '')"
                                    t-on-click="() => this.setFilter(kpi.key)">
                                <span class="label" t-esc="kpi.label"/>
                                <strong t-esc="kpi.count"/>
                                <small>฿<t t-esc="formatMoney(kpi.amount)"/></small>
                                <em t-esc="kpi.hint"/>
                            </button>
                        </t>
                    </section>

                    <section class="o_vpk_ap_card">
                        <header>
                            <h2><t t-esc="currentKpi ? currentKpi.label : 'ทั้งหมด'"/> (<t t-esc="visibleRows.length"/>)</h2>
                            <input class="form-control form-control-sm"
                                   placeholder="ค้นหาเลขที่ Bill ใบขอเบิก PO ผู้ขาย ใบตรวจรับ สถานะ"
                                   t-on-input="onSearch"/>
                        </header>
                        <div class="o_vpk_ap_table_wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>ใบเรียกเก็บ (Bill)</th>
                                        <th>ใบขออนุมัติเบิกจ่าย</th>
                                        <th>PO / ใบตรวจรับ</th>
                                        <th>ผู้ขาย</th>
                                        <th>วันที่บิล / ครบกำหนด</th>
                                        <th>ผู้อนุมัติ</th>
                                        <th class="num">จำนวนเงิน (บาท)</th>
                                        <th>สถานะ</th>
                                        <th class="act">ดำเนินการ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="visibleRows" t-as="row" t-key="row.id">
                                        <tr>
                                            <td>
                                                <a href="#" t-on-click.prevent="() => this.openBill(row)">
                                                    <strong t-esc="row.name"/>
                                                </a>
                                                <div t-if="row.ref" class="text-muted small" t-esc="row.ref"/>
                                            </td>
                                            <td>
                                                <a href="#" t-if="row.request_id"
                                                   t-on-click.prevent="() => this.openRequest(row)"
                                                   t-esc="row.request_name"/>
                                                <span t-elif="row.is_direct" class="o_vpk_ap_pill st-billed">ตั้งหนี้ตรง</span>
                                                <t t-else="">—</t>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column gap-1">
                                                    <a href="#" t-if="row.po_id"
                                                       t-on-click.prevent="() => this.openPurchaseOrder(row)"
                                                       t-esc="row.po_name"/>
                                                    <span t-elif="row.po_name" t-esc="row.po_name"/>
                                                    <span t-else="">—</span>
                                                    <span t-if="row.wa_name" class="text-muted small" t-esc="row.wa_name"/>
                                                </div>
                                            </td>
                                            <td t-esc="row.vendor"/>
                                            <td>
                                                <div class="d-flex flex-column gap-1">
                                                    <span t-esc="formatDate(row.invoice_date)"/>
                                                    <span t-if="row.due_date" class="text-muted small">
                                                        ครบกำหนด <t t-esc="formatDate(row.due_date)"/>
                                                    </span>
                                                </div>
                                            </td>
                                            <td t-esc="row.approver_names || '—'"/>
                                            <td class="num" t-esc="formatMoney(row.amount)"/>
                                            <td>
                                                <span t-att-class="'o_vpk_ap_pill st-' + row.status_key"
                                                      t-esc="row.state_label"/>
                                            </td>
                                            <td class="act">
                                                <div class="d-flex gap-1 justify-content-end flex-wrap">
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            t-on-click="() => this.openBill(row)">
                                                        <i class="fa fa-file-text-o"/> เปิดใบเรียกเก็บ
                                                    </button>
                                                    <button t-if="row.can_approve"
                                                            class="btn btn-sm btn-primary"
                                                            t-att-disabled="state.busyId === row.id"
                                                            t-on-click="() => this.approveBill(row)">
                                                        <i class="fa fa-check"/> อนุมัติตั้งเจ้าหนี้
                                                    </button>
                                                    <button t-if="row.can_approve"
                                                            class="btn btn-sm btn-outline-danger"
                                                            t-att-disabled="state.busyId === row.id"
                                                            t-on-click="() => this.rejectBill(row)">
                                                        <i class="fa fa-times"/> ไม่อนุมัติ
                                                    </button>
                                                    <button t-if="row.can_post"
                                                            class="btn btn-sm btn-primary"
                                                            t-att-disabled="state.busyId === row.id"
                                                            t-on-click="() => this.postBill(row)">
                                                        <i class="fa fa-book"/> POST ตั้งเจ้าหนี้
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr t-if="!visibleRows.length">
                                        <td colspan="9" class="empty">ไม่มีรายการในสถานะนี้</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </t>
            </div>
        </div>
    </t>
</templates>
