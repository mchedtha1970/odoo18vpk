<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vpk_payment_request.AccountingDashboard">
        <div t-att-class="props.className" class="o_vpk_ap">
            <div class="o_vpk_ap_scroll">
                <header class="o_vpk_ap_head">
                    <div>
                        <h1>รายการจ่ายชำระ รอบันทึกบัญชี</h1>
                        <p>รายการชำระเงินฉบับร่างจากการเงินยืนยันรายการจ่ายแล้ว — บัญชีตรวจสอบแล้วกดบันทึก (POST)</p>
                    </div>
                    <button class="btn btn-light" t-on-click="() => this.loadData()">
                        <i class="fa fa-refresh"/> รีเฟรช
                    </button>
                </header>

                <t t-if="!state.ready">
                    <div class="o_vpk_ap_loading">กำลังโหลดข้อมูล...</div>
                </t>
                <t t-else="">
                    <section class="o_vpk_ap_kpis o_vpk_ap_kpis_3">
                        <t t-foreach="state.data.kpis" t-as="kpi" t-key="kpi.key">
                            <button type="button" t-att-class="'o_vpk_ap_kpi tone-' + kpi.tone + ' active'">
                                <span class="label" t-esc="kpi.label"/>
                                <strong t-esc="kpi.count"/>
                                <small>฿<t t-esc="formatMoney(kpi.amount)"/></small>
                                <em t-esc="kpi.hint"/>
                            </button>
                        </t>
                    </section>

                    <section class="o_vpk_ap_card">
                        <header>
                            <h2>รอบันทึก (<t t-esc="visibleRows.length"/>)</h2>
                            <input class="form-control form-control-sm"
                                   placeholder="ค้นหาเลขที่จ่าย ผู้ขาย Bill PO สมุด วิธีชำระ"
                                   t-on-input="onSearch"/>
                        </header>
                        <div class="o_vpk_ap_table_wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>รายการชำระเงิน</th>
                                        <th>วันที่</th>
                                        <th>ผู้ขาย</th>
                                        <th>Bill / PO</th>
                                        <th>วิธีชำระ / สมุด</th>
                                        <th class="num">จำนวนเงิน</th>
                                        <th class="act">ดำเนินการ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="visibleRows" t-as="row" t-key="row.id">
                                        <tr>
                                            <td>
                                                <a href="#" t-on-click.prevent="() => this.openPayment(row)">
                                                    <strong t-esc="row.name || 'ฉบับร่าง'"/>
                                                </a>
                                                <div t-if="row.request_name" class="text-muted small" t-esc="row.request_name"/>
                                            </td>
                                            <td t-esc="formatDate(row.date)"/>
                                            <td t-esc="row.vendor"/>
                                            <td>
                                                <div class="d-flex flex-column gap-1">
                                                    <span t-esc="row.bill_name || '—'"/>
                                                    <span t-if="row.po_name" class="text-muted small" t-esc="row.po_name"/>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column gap-1">
                                                    <span t-esc="row.method || '—'"/>
                                                    <span class="text-muted small" t-esc="row.journal || ''"/>
                                                </div>
                                            </td>
                                            <td class="num">
                                                <t t-esc="formatMoney(row.amount)"/>
                                                <span t-if="row.currency" class="text-muted"> <t t-esc="row.currency"/></span>
                                            </td>
                                            <td class="act">
                                                <div class="d-flex flex-column gap-1">
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            t-on-click="() => this.openPayment(row)">
                                                        <i class="fa fa-file-text-o"/> เปิดรายการ
                                                    </button>
                                                    <button class="btn btn-sm btn-primary"
                                                            t-att-disabled="state.busyId === row.id or !row.can_post"
                                                            t-on-click="() => this.postPayment(row)"
                                                            title="บันทึกบัญชี (POST) รายการชำระเงินนี้">
                                                        <i class="fa fa-check"/> บันทึกบัญชี
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr t-if="!visibleRows.length">
                                        <td colspan="7" class="empty">ไม่มีรายการรอบันทึกบัญชี</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </t>
            </div>
        </div>
    </t>
</templates>
