<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ฟอร์มเอกสาร: ปุ่มและช่องสถานะเบิกจ่าย -->
    <record id="view_document_studio_document_form_payment_request" model="ir.ui.view">
        <field name="name">vpk.document.studio.document.form.payment.request</field>
        <field name="model">vpk.document.studio.document</field>
        <field name="inherit_id" ref="vpk_document_studio_procurement.view_document_studio_document_form_procurement"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_send_to_ap" type="object"
                        string="ส่งหน่วยงานเจ้าหนี้" class="btn-primary" icon="fa-share"
                        groups="purchase.group_purchase_user,account.group_account_invoice"
                        confirm="ส่งใบขออนุมัติเบิกจ่ายนี้ให้หน่วยงานเจ้าหนี้ดำเนินการต่อ?"
                        invisible="document_type_code != 'payment_request' or payment_state != 'approved'"/>
                <button name="action_create_ap_bill" type="object"
                        string="ดึงรายการตั้งเจ้าหนี้ (ฉบับร่าง)" class="btn-primary" icon="fa-download"
                        groups="account.group_account_invoice"
                        invisible="document_type_code != 'payment_request' or payment_state != 'wait_ap'"/>
                <button name="action_send_to_finance" type="object"
                        string="ส่งการเงิน" class="btn-primary" icon="fa-share"
                        groups="account.group_account_invoice"
                        confirm="ส่งรายการนี้ให้การเงินทำรายการจ่าย?"
                        invisible="document_type_code != 'payment_request' or payment_state != 'posted'"/>
                <button name="action_open_ap_bill" type="object"
                        string="เปิดใบเรียกเก็บ" icon="fa-file-text-o"
                        invisible="document_type_code != 'payment_request' or not payment_bill_id"/>
                <button name="action_open_purchase_order" type="object"
                        string="เปิดใบสั่งซื้อ" icon="fa-shopping-cart"
                        invisible="document_type_code != 'payment_request' or not purchase_id"/>
            </xpath>
            <xpath expr="//field[@name='wa_id']" position="after">
                <field name="payment_currency_id" invisible="1"/>
                <field name="payment_amount" invisible="document_type_code != 'payment_request'"
                       readonly="state not in ('draft', 'generated')"/>
                <field name="payment_state" widget="badge"
                       invisible="document_type_code != 'payment_request'"
                       decoration-info="payment_state in ('draft', 'approved')"
                       decoration-warning="payment_state == 'wait_ap'"
                       decoration-success="payment_state in ('posted', 'to_finance', 'paid')"
                       decoration-muted="payment_state == 'cancel'"/>
                <field name="payment_ap_forwarded_on"
                       invisible="document_type_code != 'payment_request' or not payment_ap_forwarded_on"/>
                <field name="payment_finance_sent_on"
                       invisible="document_type_code != 'payment_request' or not payment_finance_sent_on"/>
                <field name="payment_bill_id"
                       invisible="document_type_code != 'payment_request' or not payment_bill_id"/>
            </xpath>
        </field>
    </record>

    <!-- รายการบนใบสั่งซื้อ -->
    <record id="view_document_studio_document_list_payment_request_po" model="ir.ui.view">
        <field name="name">vpk.document.studio.document.list.payment.request.po</field>
        <field name="model">vpk.document.studio.document</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" edit="false">
                <field name="name" string="เลขที่เอกสาร"/>
                <field name="date"/>
                <field name="wa_id" string="ใบตรวจรับ"/>
                <field name="payment_currency_id" column_invisible="1"/>
                <field name="payment_amount" string="จำนวนเงิน"/>
                <field name="vpk_signing_enabled" column_invisible="1"/>
                <field name="signature_state" widget="badge"
                       decoration-muted="signature_state == 'not_sent'"
                       decoration-warning="signature_state == 'waiting'"
                       decoration-success="signature_state == 'signed'"/>
                <field name="payment_state" widget="badge"
                       decoration-info="payment_state in ('draft', 'approved')"
                       decoration-warning="payment_state == 'wait_ap'"
                       decoration-success="payment_state in ('posted', 'to_finance', 'paid')"
                       decoration-muted="payment_state == 'cancel'"/>
                <field name="payment_bill_id" string="ใบเรียกเก็บ" optional="show"/>
                <button name="action_send_for_signature" type="object"
                        string="ส่งลงนาม" icon="fa-paper-plane" title="ส่งลงนาม"
                        invisible="not vpk_signing_enabled or signature_state != 'not_sent' or state == 'cancelled'"/>
                <button name="action_send_to_ap" type="object"
                        string="ส่งหน่วยงานเจ้าหนี้" icon="fa-share" title="ส่งหน่วยงานเจ้าหนี้"
                        confirm="ส่งใบขออนุมัติเบิกจ่ายนี้ให้หน่วยงานเจ้าหนี้ดำเนินการต่อ?"
                        invisible="payment_state != 'approved'"/>
                <button name="action_open_form" type="object" string="เปิด" icon="fa-external-link"/>
                <button name="action_delete_from_source" type="object" string="ลบ"
                        icon="fa-trash-o" class="text-danger"
                        confirm="ต้องการลบเอกสารนี้หรือไม่?"
                        invisible="state in ('to_approve', 'approved', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- กล่องงานเจ้าหนี้ -->
    <record id="view_payment_request_ap_inbox_list" model="ir.ui.view">
        <field name="name">vpk.payment.request.ap.inbox.list</field>
        <field name="model">vpk.document.studio.document</field>
        <field name="priority">41</field>
        <field name="arch" type="xml">
            <list string="ขอเบิกจ่ายที่อนุมัติแล้ว" create="false" delete="false" edit="false"
                  decoration-muted="payment_state == 'to_finance'">
                <field name="name" string="เลขที่ใบขออนุมัติ"/>
                <field name="purchase_id" string="ใบสั่งซื้อ"/>
                <field name="payment_partner_id" string="ผู้ขาย"/>
                <field name="wa_id" string="ใบตรวจรับ"/>
                <field name="payment_currency_id" column_invisible="1"/>
                <field name="payment_amount" string="จำนวนเงิน" sum="รวม"/>
                <field name="signed_on" string="ลงนามครบเมื่อ" optional="hide"/>
                <field name="payment_ap_forwarded_on" string="ส่งเจ้าหนี้เมื่อ"/>
                <field name="payment_state" widget="badge"
                       decoration-warning="payment_state == 'wait_ap'"
                       decoration-success="payment_state in ('posted', 'to_finance', 'paid')"/>
                <field name="payment_bill_id" string="ใบเรียกเก็บ"/>
                <button name="action_create_ap_bill" type="object"
                        string="ดึงรายการตั้งเจ้าหนี้" icon="fa-download"
                        invisible="payment_state != 'wait_ap'"/>
                <button name="action_send_to_finance" type="object"
                        string="ส่งการเงิน" icon="fa-share"
                        confirm="ส่งรายการนี้ให้การเงินทำรายการจ่าย?"
                        invisible="payment_state != 'posted'"/>
                <button name="action_open_ap_bill" type="object"
                        string="เปิดใบเรียกเก็บ" icon="fa-file-text-o"
                        invisible="not payment_bill_id"/>
                <button name="action_open_form" type="object" string="เปิดเอกสาร" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_payment_request_ap_inbox_search" model="ir.ui.view">
        <field name="name">vpk.payment.request.ap.inbox.search</field>
        <field name="model">vpk.document.studio.document</field>
        <field name="priority">41</field>
        <field name="arch" type="xml">
            <search string="ขอเบิกจ่ายที่อนุมัติแล้ว">
                <field name="name" string="เลขที่ใบขออนุมัติ"/>
                <field name="purchase_id" string="ใบสั่งซื้อ"/>
                <field name="payment_partner_id" string="ผู้ขาย"/>
                <field name="wa_id" string="ใบตรวจรับ"/>
                <filter name="wait_ap" string="รอตั้งเจ้าหนี้" domain="[('payment_state', '=', 'wait_ap')]"/>
                <filter name="billed" string="ตั้งเจ้าหนี้ (Draft)" domain="[('payment_state', '=', 'billed')]"/>
                <filter name="posted" string="รอส่งการเงิน" domain="[('payment_state', '=', 'posted')]"/>
                <filter name="to_finance" string="ส่งการเงินแล้ว" domain="[('payment_state', '=', 'to_finance')]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter name="group_vendor" string="ผู้ขาย" context="{'group_by': 'payment_partner_id'}"/>
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payment_request_ap_inbox" model="ir.actions.act_window">
        <field name="name">ขอเบิกจ่ายที่อนุมัติแล้ว (กล่องงานเจ้าหนี้)</field>
        <field name="res_model">vpk.document.studio.document</field>
        <field name="view_mode">list</field>
        <field name="domain">[('document_type_code', '=', 'payment_request'), ('state', '=', 'approved'), ('payment_ap_forwarded_on', '!=', False)]</field>
        <field name="context">{'search_default_wait_ap': 1}</field>
        <field name="search_view_id" ref="view_payment_request_ap_inbox_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_payment_request_ap_inbox_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีรายการขอเบิกจ่ายที่จัดซื้อส่งมา</p>
            <p>จัดซื้อขออนุมัติเบิกจ่ายจากใบสั่งซื้อหลังตรวจรับ เมื่อลงนามครบและจัดซื้อกด ส่งหน่วยงานเจ้าหนี้ รายการจะมาอยู่ที่นี่ให้เจ้าหนี้ดึงไปตั้งหนี้</p>
        </field>
    </record>
</odoo>
