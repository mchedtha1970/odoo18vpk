<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- แท็บ "เอกสารอนุมัติเบิกจ่าย" บนเอกสาร GFMIS: ใบขออนุมัติเบิกจ่ายที่ลงนามแล้ว (ไฟล์ PDF) -->
    <record id="view_gfmis_document_form_payment_request" model="ir.ui.view">
        <field name="name">gfmis.document.form.payment.request</field>
        <field name="model">gfmis.document</field>
        <field name="inherit_id" ref="vpk_gfmis.view_gfmis_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='gfmis_files']" position="before">
                <group string="ใบขออนุมัติเบิกจ่ายที่ลงนามแล้ว (จากจัดซื้อ)">
                    <field name="payment_request_doc_ids" nolabel="1" colspan="2" readonly="1">
                        <list create="false" delete="false" edit="false">
                            <field name="name" string="เลขที่เอกสาร"/>
                            <field name="date" string="วันที่"/>
                            <field name="purchase_id" string="ใบสั่งซื้อ"/>
                            <field name="wa_id" string="ใบตรวจรับ"/>
                            <field name="payment_currency_id" column_invisible="1"/>
                            <field name="payment_amount" string="จำนวนเงิน"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'approved'"
                                   decoration-warning="state == 'to_approve'"/>
                            <field name="signed_on" string="ลงนามครบเมื่อ"/>
                            <button name="action_open_pdf" type="object" string="เปิดไฟล์ PDF"
                                    icon="fa-file-pdf-o" title="เปิดไฟล์ PDF"/>
                            <button name="action_open_form" type="object" string="เปิดเอกสาร"
                                    icon="fa-external-link" title="เปิดเอกสาร"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
