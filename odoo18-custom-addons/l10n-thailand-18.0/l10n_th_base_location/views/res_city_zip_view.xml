<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_city_zip_form" model="ir.ui.view">
        <field name="name">res.city.zip.form (Thailand)</field>
        <field name="model">res.city.zip</field>
        <field name="inherit_id" ref="base_location.city_zip_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="district_code" />
                <field name="sub_district_code" />
            </field>
        </field>
    </record>
</odoo>
