<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="city_zip_geonames_import_form" model="ir.ui.view">
        <field name="name">Import from Geonames form view (Thailand)</field>
        <field name="model">city.zip.geonames.import</field>
        <field name="inherit_id" ref="base_location_geonames_import.city_zip_geonames_import_form" />
        <field name="arch" type="xml">
            <field name="letter_case" position="after">
                <field name="is_thailand" invisible="1" />
                <field
                    name="location_thailand_language"
                    invisible="not is_thailand"
                />
            </field>
        </field>
    </record>
</odoo>
