<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">account.payment.register.form</field>
        <field name="model">account.payment.register</field>
        <field name="priority" eval="100" />
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='payment_difference']" position="attributes">
                <attribute name="string">ส่วนต่างการชำระเงิน (Price Diff)</attribute>
            </xpath>
            <field name="payment_difference_handling" position="after">
                <div invisible="payment_difference_handling != 'reconcile'">
                    <label
                        for="wht_tax_id"
                        class="oe_edit_only"
                        string="ภาษีหัก ณ ที่จ่าย"
                    />
                    <field
                        name="wht_tax_id"
                        placeholder="ภาษีหัก ณ ที่จ่าย"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <label
                        for="wht_amount_base"
                        class="oe_edit_only"
                        string="ฐานภาษีหัก ณ ที่จ่าย"
                    />
                    <field name="wht_amount_base" />
                </div>
            </field>
        </field>
    </record>
</odoo>
