<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_vpk_asset_inventory" model="ir.module.category">
        <field name="name">ตรวจนับทรัพย์สิน</field>
        <field name="sequence">59</field>
    </record>

    <record id="group_asset_inventory_user" model="res.groups">
        <field name="name">ผู้ตรวจนับหน่วยงาน</field>
        <field name="category_id" ref="module_category_vpk_asset_inventory"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">เปิด Portal / สแกน QR บันทึกจำนวนนับของหน่วยงานตนเอง</field>
    </record>

    <record id="group_asset_inventory_officer" model="res.groups">
        <field name="name">เจ้าหน้าที่ทรัพย์สิน</field>
        <field name="category_id" ref="module_category_vpk_asset_inventory"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_inventory_user')), (4, ref('account.group_account_user'))]"/>
        <field name="comment">สร้างรอบตรวจนับ Gen Sheet และดูผลออนไลน์ทุกหน่วยงาน</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Department users: sheets of their analytics or assigned sheet users -->
    <record id="rule_inventory_sheet_user" model="ir.rule">
        <field name="name">Inventory sheet: department user</field>
        <field name="model_id" ref="model_vpk_asset_inventory_sheet"/>
        <field name="groups" eval="[(4, ref('group_asset_inventory_user'))]"/>
        <field name="domain_force">
            ['|',
             ('user_ids', 'in', [user.id]),
             ('analytic_account_id', 'in', user.asset_inventory_analytic_ids.ids)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_inventory_line_user" model="ir.rule">
        <field name="name">Inventory line: department user</field>
        <field name="model_id" ref="model_vpk_asset_inventory_line"/>
        <field name="groups" eval="[(4, ref('group_asset_inventory_user'))]"/>
        <field name="domain_force">
            ['|',
             ('sheet_id.user_ids', 'in', [user.id]),
             ('analytic_account_id', 'in', user.asset_inventory_analytic_ids.ids)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_inventory_count_user" model="ir.rule">
        <field name="name">Inventory count: department user (open only via sheets)</field>
        <field name="model_id" ref="model_vpk_asset_inventory_count"/>
        <field name="groups" eval="[(4, ref('group_asset_inventory_user'))]"/>
        <field name="domain_force">
            [('sheet_ids', 'any', ['|',
                ('user_ids', 'in', [user.id]),
                ('analytic_account_id', 'in', user.asset_inventory_analytic_ids.ids)])]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Officer sees all -->
    <record id="rule_inventory_sheet_officer" model="ir.rule">
        <field name="name">Inventory sheet: officer all</field>
        <field name="model_id" ref="model_vpk_asset_inventory_sheet"/>
        <field name="groups" eval="[(4, ref('group_asset_inventory_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_inventory_line_officer" model="ir.rule">
        <field name="name">Inventory line: officer all</field>
        <field name="model_id" ref="model_vpk_asset_inventory_line"/>
        <field name="groups" eval="[(4, ref('group_asset_inventory_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_inventory_count_officer" model="ir.rule">
        <field name="name">Inventory count: officer all</field>
        <field name="model_id" ref="model_vpk_asset_inventory_count"/>
        <field name="groups" eval="[(4, ref('group_asset_inventory_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Portal users use same analytic mapping on res.users -->
    <record id="rule_inventory_sheet_portal" model="ir.rule">
        <field name="name">Inventory sheet: portal</field>
        <field name="model_id" ref="model_vpk_asset_inventory_sheet"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            ['|',
             ('user_ids', 'in', [user.id]),
             ('analytic_account_id', 'in', user.asset_inventory_analytic_ids.ids)]
        </field>
    </record>
    <record id="rule_inventory_line_portal" model="ir.rule">
        <field name="name">Inventory line: portal</field>
        <field name="model_id" ref="model_vpk_asset_inventory_line"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            ['|',
             ('sheet_id.user_ids', 'in', [user.id]),
             ('analytic_account_id', 'in', user.asset_inventory_analytic_ids.ids)]
        </field>
    </record>
    <record id="rule_inventory_count_portal" model="ir.rule">
        <field name="name">Inventory count: portal</field>
        <field name="model_id" ref="model_vpk_asset_inventory_count"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('sheet_ids', 'any', ['|',
                ('user_ids', 'in', [user.id]),
                ('analytic_account_id', 'in', user.asset_inventory_analytic_ids.ids)])]
        </field>
    </record>
</odoo>
