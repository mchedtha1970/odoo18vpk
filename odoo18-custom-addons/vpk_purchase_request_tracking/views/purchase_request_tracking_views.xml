<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_tree_tracking" model="ir.ui.view">
        <field name="name">purchase.request.list.tracking</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_tree"/>
        <field name="priority">150</field>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="po_issued_status" widget="badge"
                       decoration-danger="po_issued_status == 'not_issued'"
                       decoration-warning="po_issued_status == 'partial'"
                       decoration-success="po_issued_status == 'issued'"
                       optional="show"/>
                <field name="has_po" optional="hide"/>
                <field name="confirmed_po_count" optional="hide" string="PO ยืนยัน"/>
                <field name="procurement_type_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_request_search_tracking" model="ir.ui.view">
        <field name="name">purchase.request.search.tracking</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_search"/>
        <field name="arch" type="xml">
            <filter name="state_draft" position="before">
                <filter string="ยังไม่ออกใบสั่งซื้อ/จ้าง/เช่า" name="filter_po_not_issued"
                        domain="[('po_issued_status', '=', 'not_issued')]"/>
                <filter string="ออกบางส่วน" name="filter_po_partial"
                        domain="[('po_issued_status', '=', 'partial')]"/>
                <filter string="ออกใบสั่งซื้อแล้ว" name="filter_po_issued"
                        domain="[('po_issued_status', '=', 'issued')]"/>
                <separator/>
                <filter string="วันที่ขอซื้อ" name="filter_date_start" date="date_start"/>
                <separator/>
            </filter>
            <xpath expr="//group/filter[@name='assigned_to']" position="after">
                <filter string="สถานะการออกใบสั่งซื้อ" name="groupby_po_issued_status"
                        context="{'group_by': 'po_issued_status'}"/>
                <filter string="ประเภทจัดซื้อ" name="groupby_procurement_type"
                        context="{'group_by': 'procurement_type_id'}"/>
                <filter string="วัน" name="groupby_date_day"
                        context="{'group_by': 'date_start:day'}"/>
                <filter string="สัปดาห์" name="groupby_date_week"
                        context="{'group_by': 'date_start:week'}"/>
                <filter string="เดือน" name="groupby_date_month"
                        context="{'group_by': 'date_start:month'}"/>
                <filter string="ปี" name="groupby_date_year"
                        context="{'group_by': 'date_start:year'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_request_pivot_tracking" model="ir.ui.view">
        <field name="name">purchase.request.pivot.tracking</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <pivot string="สรุปการขอซื้อ/จ้าง/เช่า">
                <field name="date_start" type="row" interval="month"/>
                <field name="po_issued_status" type="col"/>
                <field name="estimated_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_purchase_request_graph_tracking" model="ir.ui.view">
        <field name="name">purchase.request.graph.tracking</field>
        <field name="model">purchase.request</field>
        <field name="arch" type="xml">
            <graph string="กราฟการขอซื้อ/จ้าง/เช่า" type="bar">
                <field name="date_start" type="row" interval="month"/>
                <field name="po_issued_status" type="row"/>
                <field name="estimated_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_purchase_request_tracking" model="ir.actions.act_window">
        <field name="name">ติดตามสถานะขอซื้อ/จ้าง/เช่า</field>
        <field name="res_model">purchase.request</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_groupby_po_issued_status': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ยังไม่มีใบขอซื้อ/จ้าง/เช่า
            </p>
            <p>
                ใช้เมนูนี้ติดตามว่า PR ใดออกใบสั่งซื้อแล้ว หรือยังไม่ออก
                และดูสรุปรายวัน/สัปดาห์/เดือน/ปี ผ่าน Pivot / Graph
            </p>
        </field>
    </record>

    <record id="action_purchase_request_tracking_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="purchase_request.view_purchase_request_tree"/>
        <field name="act_window_id" ref="action_purchase_request_tracking"/>
    </record>
    <record id="action_purchase_request_tracking_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_purchase_request_pivot_tracking"/>
        <field name="act_window_id" ref="action_purchase_request_tracking"/>
    </record>
    <record id="action_purchase_request_tracking_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_purchase_request_graph_tracking"/>
        <field name="act_window_id" ref="action_purchase_request_tracking"/>
    </record>
</odoo>
